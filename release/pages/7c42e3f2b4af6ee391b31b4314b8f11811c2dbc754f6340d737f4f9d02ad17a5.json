name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"H-Hello, Doctor... It's nice meeting you...","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Um... Sorry... I'm not a good talker...","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Yes... My parents are Victorian merchants. But I haven't been able to contact them for a long time... I picked this code name because it reminds me of home.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Th-That masked Operator... makes me feel... nervous...","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"It's not that... I'm trying to avoid people, it's just, I'm not sure... what I should do...","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Sorry to make you worry again, Ansel... But you don't have to give me special treatment. Many more people need your help.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Oripathy granted me powerful senses, but they're slipping away, little by little... Even so, I will not crumble... There's so much more I want to talk about with everyone...","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, could you take this bottle of perfume, please? I brought it from home... This type of perfume lifts spirits. I often take a sniff when I feel down.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Merry? Keep it down... The Doctor is very tired.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I'm Melantha... From now on, my blade is yours.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Thank you... for your guidance.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Thank you very much... Um, were the others promoted as well? I think they all deserve it just the same.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"Understood... I'll follow your orders.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"The leader? But I'm not particularly good at giving orders...","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Let's work to make the world a more peaceful place.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Ansel... I'm counting on you now.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Please give me instructions...","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"What are your orders?","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Understood.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"I'll do my best.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"You will fall...!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Attack!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"No matter what difficulties are in store for me, I will keep on advancing.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"We won? Thank goodness for that...","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"I can still fight.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"We failed... How did things end up this way?","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Is there... anyone else here?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Wh-Who's there?! Oh, Doctor...","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, thank you for always taking care of me... Um, actually... I'd like to keep taking on the fight.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Um… Happy New Year, Doctor. My parents sent me a letter and a present. I'm also doing a little better today, in terms of perceptiveness. It's a happy day for me. I hope… it puts you in a good mood too.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Doctor...","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, thank you for all the care and encouragement you've given me. This is a present from me... some refreshing fragrances. I've already tried them, they don't clash when mixed together. So you can blend them however you like…","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Doctor… How have we been doing? Um… yes… Thank you. I hope I can do better, bit by bit! My squadmates have been supporting me all the way. I hope to repay them… with my strength.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Penelope Rawlins"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_208_melan/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Yuko Hara"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_208_melan/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yue Xin"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_208_melan/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Yoon Mi-na"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_208_melan/{voiceIdLower}.mp3"}]}}}