el":2,"benefit":"DP cost -1"},{"level":3,"benefit":"Redeployment time -4 seconds"},{"level":4,"benefit":"ATK +25"},{"level":5,"benefit":"Redeployment time -6 seconds"},{"level":6,"benefit":"DP cost -1"}],"totalCost":[{"name":"Melantha's Token","quantity":5}]},"promotion":[{"tier":"Elite 1","upgrades":["Maximum attributes increased.","DP cost +2 .","New talent: ATK Up ."],"prerequisite":"Raise Melantha to Level 100.","cost":[{"name":"LMD","quantity":10000}]}],"skills":{"skillList":[{"name":"ATK Up α","recoveryType":"Auto Recovery","activationType":"Manual","duration":"20 seconds","levels":[{"level":1,"mastery":null,"description":"ATK +10%","initialSp":0,"spCost":50,"duration":20},{"level":2,"mastery":null,"description":"ATK +15%","initialSp":0,"spCost":50,"duration":20},{"level":3,"mastery":null,"description":"ATK +20%","initialSp":0,"spCost":50,"duration":20},{"level":4,"mastery":null,"description":"ATK +30%","initialSp":0,"spCost":45,"duration":20},{"level":5,"mastery":null,"description":"ATK +35%","initialSp":0,"spCost":45,"duration":20},{"level":6,"mastery":null,"description":"ATK +40%","initialSp":0,"spCost":45,"duration":20},{"level":7,"mastery":null,"description":"ATK +50%","initialSp":0,"spCost":40,"duration":20}],"recommendation":[],"cost":null,"pairings":[],"techniques":[]}],"skillCost":null},"baseSkills":[{"name":"Supply Management","facility":"Trading Post","eliteLevel":"Base","description":"When this Operator is assigned to a Trading Post, order acquisition efficiency +25% and the order limit +1"},{"name":"Focus α","facility":"Workshop","eliteLevel":"Elite 1","description":"When this Operator is assigned to the Workshop to process any material , the production rate of byproduct increases by 40%"}],"modules":[],"review":{"official":"Melantha is the captain of\nReserve Op Team A4\nand a citizen of\nVictoria\n. Before she took up her current post, she was a typical jobless Infected. After an exceptional performance on her tests, she received an offer to join\nRhodes Island\n.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":40,"base":{"hp":1395,"atk":396,"def":83,"res":0,"redeploy":70,"dp":13,"block":1,"interval":1.5},"max":{"hp":1993,"atk":583,"def":119,"res":0,"redeploy":70,"dp":13,"block":1,"interval":1.5},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":55,"base":{"hp":1993,"atk":583,"def":119,"res":0,"redeploy":70,"dp":15,"block":1,"interval":1.5},"max":{"hp":2745,"atk":738,"def":155,"res":0,"redeploy":70,"dp":15,"block":1,"interval":1.5},"rangeId":"1-1"}],"trust":{"hp":0,"atk":65,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests have shown the outlines of her internal organs to be indistinct due to abnormal shadows. Originium granules have been detected in her circulatory system, confirming her to be infected with Oripathy.\n\n[Cell-Originium Assimilation] 2%\nSubject is mildly infected. There is a lesion upon the subject's left shoulder, though the infection has largely been contained and is in stable condition.\n\n[Blood Originium-Crystal Density] 0.25u/L\nResults of internal circulation tests have been positive. Strength training is recommended as part of the course of treatment.\n\n'Melantha is still growing and needs to eat food high in nutrients.' - Medic Team Intern Hibiscus"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"Melantha was born in Londinium, the capital of the Kingdom of Victoria. Her father is a trader engaged in the bulk spice trade. He runs several spice mills of his own. Her mother is the head of the family's aromatherapy flagship store in the heart of Londinium.\nFollowing in the footsteps of her parents, Melantha got involved in spices at a very young age, often assisting them in developing new aromatherapy products. Melantha's experiences have been heavily influenced by her parents."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"Melantha was a student at the Wessex Private Middle School when she was young. She received exceptional marks in all her classes, but because she was soft spoken and lacked communication skills, she was never the center of attention or very popular. \nHer lack of friends remains due to her unwillingness to change her personality. With her parents' help, she immersed herself into upper-class academic activities, including art, literature, and poetry. In traditional Victorian society, the arts are an important part of a woman's formal education.\nIn addition, in order to strengthen her weak constitution, Melantha's parents arranged for her to study swordsmanship and other popular upper-class sports.\nAfter the Infected crisis broke out, Melantha was herself Infected. Her parents arranged for her to receive treatment from Rhodes Island Pharmaceutical's. And before long, she was on the way to the company for treatment."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"Melantha has a close relationship with all the other members of Reserve Op Team A4. Introverted by nature, she initially worried about whether she would be able to serve well in her role as Reserve Op Team A4's captain, but with the help of her companions on the team, she broke through her inner obstacles. \nThe lively and cheerful Cardigan is her inseparable friend. In both life and on the battlefield, they maintain a strong and complementary relationship. \nMelantha also has great respect for the mature and dependable Operator Steward. She feels both guilty and grateful to Ansel, who is in charge of maintaining her health records as well as providing her with daily treatment. Finally, Adnachiel is the Operator that Melantha understands the least. Since the beginning, she has struggled to figure out what this kid from Laterano might be thinking. Nevertheless, Adnachiel hasn't caused any problems in battle. \nDuring her tenure as captain, her subordinates have all spoken highly of her attentive and careful nature. Her serious and disciplined qualities have enabled her to complete all the missions Rhodes Island has entrusted to her."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"So far, both existing archives and the observations of her fellow Operators have failed to grasp just what kind of swordsmanship Melantha employs. This is one of Melantha's few mysteries. \nJudging from test records and daily battle videos, her swordsmanship appears to have originated from the Victorian traditional duelist's style, but at some point during her training, she must have picked up some heavy influences from Eastern sword arts. \nMelantha's weapon can also be looked at as a kind of circumstantial evidence for this. She uses an exceptionally fine yet extremely sharp straight sword. Current data makes clear that this weapon is only used in Yan and some parts of the Far East. \nMelantha's swordsmanship is agile and her skills are outstanding. In terms of combat techniques, Melantha has is skilled in tactical assault. Even without support, she can rely upon her mobility to move about the battlefield and hide when necessary. \nOn the other hand, Melantha lacks the ability for effective direct confrontation and she displays certain deficiencies in stability during high-intensity operations.\nUp until now, Melantha has trained under the guidance of Franka."}]},"appearances":[{"label":"Base","iconPath":"/three-star-icons/Melantha%20-%20Base.webp","fullPath":"/three-star-skins/Melantha%20-%20Base.webp"},{"label":"Letters from Wessex","iconPath":"/three-star-icons/Melantha%20-%20Letters%20from%20Wessex.webp","fullPath":"/three-star-skins/Melantha%20-%20Letters%20from%20Wessex.webp"}],"skinObtainByLabel":{"Letters from Wessex":"40 DC / 400 UC"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Rhodes Island","type":"faction","entries":[{"operatorName":"Closure","operatorIconPath":"/six-star-icons/Closure%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"Minimum DP -4 ( -1 ) when Closure is in the squad; all [Rhodes Island] Operators ATK +4%.","matchedKeyword":"Rhodes Island"}]},{"operatorName":"Kal'tsit - Esperanta","operatorIconPath":"/six-star-icons/Kal'tsit%20-%20Esperanta%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"When other allies enter this unit's Attack Range, they will immediately gain 1 Shield and be granted a buff, healing by 60 ( +10 ) HP per second for 30 seconds (This effect is unable to be stacked and the healing effect is doubled for [Rhodes Island] Operators).","matchedKeyword":"Rhodes Island"}]},{"operatorName":"Angelina the Mellow Wish","operatorIconPath":"/six-star-icons/Angelina%20the%20Mellow%20Wish%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Ascalon","operatorIconPath":"/six-star-icons/Ascalon%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Blaze","operatorIconPath":"/six-star-icons/Blaze%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Blaze the Igniting Spark","operatorIconPath":"/six-star-icons/Blaze%20the%20Igniting%20Spark%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Ceobe","operatorIconPath":"/six-star-icons/Ceobe%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Ch'en the Dawnstreak","operatorIconPath":"/six-star-icons/Ch'en%20the%20Dawnstreak%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Ch'en the Holungday","operatorIconPath":"/six-star-icons/Ch'en%20the%20Holungday%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Civilight Eterna","operatorIconPath":"/six-star-icons/Civilight%20Eterna%20-%20Base.webp","isContributor":false,"badges":[]}]},{"name":"Guard","type":"class","entr