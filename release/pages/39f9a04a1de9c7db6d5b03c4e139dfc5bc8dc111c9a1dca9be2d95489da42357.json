zutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Didn't notice me behind you, eh? It's only natural. I'm a cat. We're known for being silent prowlers!","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Hey, don't touch my hat... it's crazy, you know! If it feeds you too many secrets, Doctor, you'll be in trouble.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"So rare to see a pharma take in runaway kitties from a jail. Did you all want a peek at my maps? Or,  was it some advice on prison breaks?","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"We thieves have our own principles and standards too... perhaps. Who can say?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Meow, meow, meow... Meow? Never you mind, I'm just talking to myself.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Anytime you want. Don't you worry, I have friends everywhere. Eyes everywhere.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Curiosity can kill a cat, you know.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I'm in a good mood right now, so here's a riddle for you. 'Why is a raven like a writing desk?'","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Thank you, for this 'Haze' I'm now.But... did you catch a peep of any of them, along the way? Any of, well... my secrets?","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Asleep like a baby... Time to get 'meown to business,' then.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Hello, I'm Haze. I like relaxing work environments, and an employer who knows better than to bother me with too many questions.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Yummy.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Promotion? What's that? Does it taste good?","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Finally out of those old shackles... and here I am, straight into new ones. The destiny of a thief's no wonder.","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Give me a bit of freedom and I'll be happy.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"What do we need a leader for? Can't everyone just fight on their own?","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Meow... It's driving me wild... this sweet, sweet smell of freedom!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Everyone, no need to have cold feet here.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Meow?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Here we go.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Out and about.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Like a shadow.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"How do nya like this?","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Careful, kittens. Don't lose your mittens.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"You think you've got all the trimmings, don't you?","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Nah-ah-ah, Don't get carried away.","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"No one stands above a kitty in the end!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Perfect victory? Whatever. A victory's a victory afterall.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Do you know how many enemies you let go? That will be a spanner in the works.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I'm no stranger to running for it, but this is just too embarrassing...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Kotatsu. Where's the kotatsu?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Meow?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Meow? I'm not satisfied yet. You know my rule: if I can't have it, I want it.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"New year? A year is such a long time for a kitty. And happiness won't come knocking if one worries about more than just today. Speaking of which, today is really nice for napping. Doctor, how about we just spend this day with some lazy, cozy naps.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Doctor, nice to meet nya.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor. Meow? My best wishes aren't enough? Don't tell me you want some presents, you greedy kitty. Well then, what do you want? Shall I give you a riddle, or allow you to rub my ears?","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"A kitty visits gardens that provide food. But if someone tries to lock the kitty up, it will surely run away. When the kitty's in a good mood, however, it can bring back some tasty stuff as thanks. Know what I mean, Doctor? Be sure to make Rhodes Island a garden that everyone likes.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Ratana"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_141_nights/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Thing Ru"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_141_nights/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Ke Zhong"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_141_nights/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Lee Seul"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_141_nights/{voiceIdLower}.mp3"}]}}}