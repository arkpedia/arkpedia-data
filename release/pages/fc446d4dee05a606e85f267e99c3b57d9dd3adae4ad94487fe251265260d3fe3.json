e":null},{"name":"Valarqvin","rarity":5,"isFuture":null},{"name":"Vanilla","rarity":3,"isFuture":null},{"name":"Varkáris","rarity":5,"isFuture":null},{"name":"Vendela","rarity":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Movement Speed Down":{"entries":[{"name":"Ascalon","rarity":6,"isFuture":null},{"name":"Ch'en the Holungday","rarity":6,"isFuture":null},{"name":"Gladiia","rarity":6,"isFuture":null},{"name":"Lappland the Decadenza","rarity":6,"isFuture":null}],"totalCount":19}},"forms":null,"skillRanges":{"2":{"skillName":"Destructive Fist","baseRangeId":"1-1","baseRange":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]},"levelRangeIds":["4-1","4-1","4-1","4-1","4-1","4-1","4-1","4-1","4-1","4-1"],"grids":{"4-1":{"cols":5,"rows":1,"opCell":[1,1],"rangeCells":[[1,2],[1,3],[1,4],[1,5]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"So... I have to just stand here and not do anything? Laaaame.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"These gauntlets aren't that heavy. See? Even a dainty little girl like me can carry 'em around real easy.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"You remember fighting by my side before? Can't say I remember fighting by yours, sorry... I just fight for what's right, that's all.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Hah. That boxer, Beehunter? She's really something! I enjoyed sparring with her so much, I had to throw out some serious moves. And she's got an amazing honey collection too. Wanna visit her with me next time? You gotta learn some kung fu first, though.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Reading a movie magazine...? Well, guess what? The 'hot kung-fu actress' mentioned in this article is ME! What? You don't believe me? Come on, look! This is me, can't you tell? C'mon, that's definitely me!","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Do I regret forgoing my previous life? Well, sometimes, of course. But the world ain't kind to us Infected. Lots of places I'm not allowed to go. It blows.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"There's a street full of food stalls in the neighboring city. And... a candy shop over there? And a theme park? Aww, Doctor, can I get a day off? I wanna check out these places!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Am I satisfied with life at Rhodes Island, you ask? Hm, to be honest... It's even sweeter than what they show in the movies! I got cool opponents to practice with, top-notch food, and by working here, I'm doing something good for the world! What could be better!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, look! What do you think about this script? Oh, who's gonna act in it, you wonder? You and I are gonna be the main characters! There's this scene where we leap from the roof of a thirty-story building and slide all the way down. Isn't that cool? Hey! Come back! Wait!","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"You're catching some z's, eh? Guess I'll slack off for a bit too. Man, this couch is so fluffy!","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"You swear you've seen my face before? Probably saw it in a movie I was in! Call me FEater, and what I do from here is your call!","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"It's over? Come on, let's watch just a while longer. We're almost at the fun part!","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Oooh! A promotion! Thanks so much, Doctor!","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"This here's the perfect opportunity to show you some REAL kung fu!","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"All right, it's show time!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Huh? I'm the leader? Not sure how it'll go, but...","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"This is gonna be exciting!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"I'm FEater. Pleased to beat you!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Un-huh.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Here we go!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"All right!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Show time!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"HI-YAH!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"This is straight out of one of my movies!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"From flexibility comes power!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Who says a movie star couldn't be a real kung-fu master!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Wow, it's over?","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"It's over already? I was just starting to get warmed up.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Hey, it's no biggie. Just a few scratches and bruises.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Aw... I just wanna go home and sleep...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Now that's stylin'!","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Stop that, I'm getting dizzy!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Hey, Doctor, want my autograph? I'll take a pic with you if you want, too!","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year, Doctor! Hehe, back in the old days, theaters would screen my movies this time every year, all playing to a full house!  Still, can't live in the past forever. I gotta punch ahead, and people gotta move on forward. Let's forget all our grievances for today!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Did you have breakfast yet, Doctor?","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, happy birthday! There's this saying that 'life's a movie you can't reshoot,' so when it comes to a key scene, you've gotta live life like you're on fire! Any birthday wishes, Doctor? Gimme a wish as cool as the lead of an action movie, and I'll help you make it come true!","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"After I became an Infected, I thought for a bit that my career and my life were both over. Rhodes didn't just rein in my illness, but also gave me a fresh start. Standing up again in dire straits is exactly what the hero does, right? Doctor, Let's climb back to the top, together!","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_005_a","title":"Post-Promotion Talk 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["jp"]},{"id":"CN_033_a","title":"Enter Facility","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["jp"]}],"packs":[{"id":"en","label":"English","actors":["Ashleigh Haddad"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_241_panda/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Mie Sonozaki"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_241_panda/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yue Xin"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_241_panda/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Song Ha-rim"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_241_panda/{voiceIdLower}.mp3"},{"id":"cn_topolect","label":"Regional Chinese","actors":["Atom"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-regional/2a37ac36d9320539e61d117ad1e2521183134daf/current/char_241_panda_cn_topolect/{voiceIdLower}.mp3"}]}}}