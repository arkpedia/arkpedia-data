":"Module Data Block","quantity":1},{"name":"Grindstone","quantity":4},{"name":"LMD","quantity":20000}]},{"stage":"Stage 2","attributesIncreased":"HP +340 , ATK +45","effectLabel":"Demonic Physique improved","effectText":"DEF -20%; Max HP +30%","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Stick","quantity":15},{"name":"Oriron Cluster","quantity":5},{"name":"LMD","quantity":25000}]},{"stage":"Stage 3","attributesIncreased":"HP +390 , ATK +55","effectLabel":"Demonic Physique improved","effectText":"DEF -20%; Max HP +35%","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Instrument","quantity":5},{"name":"Sugar Pack","quantity":6},{"name":"LMD","quantity":30000}]}]}],"review":{"official":"This nomadic warrior from the\nFar East\njoined\nRhodes Island\nby sheer chance.\nWhat Matoimaru lacks in strategic acumen, she makes up with a mean giant sickle swing.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":45,"base":{"hp":1514,"atk":396,"def":70,"res":0,"redeploy":70,"dp":15,"block":1,"interval":1.5},"max":{"hp":2019,"atk":592,"def":100,"res":0,"redeploy":70,"dp":15,"block":1,"interval":1.5},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":60,"base":{"hp":2019,"atk":592,"def":100,"res":0,"redeploy":70,"dp":17,"block":1,"interval":1.5},"max":{"hp":2693,"atk":760,"def":131,"res":0,"redeploy":70,"dp":17,"block":1,"interval":1.5},"rangeId":"1-1"},{"elite":2,"minLevel":1,"maxLevel":70,"base":{"hp":2693,"atk":760,"def":131,"res":0,"redeploy":70,"dp":17,"block":1,"interval":1.5},"max":{"hp":3640,"atk":916,"def":156,"res":0,"redeploy":70,"dp":17,"block":1,"interval":1.5},"rangeId":"1-1"}],"trust":{"hp":450,"atk":0,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests on this Operator show clear outlines of internal organs, with no abnormal dark spots or shadows. No unusual traces of Originium particles present in the circulatory system, no signs of infection, confirming this operator as uninfected. \n\n[Cell-Originium Assimilation] 0% \nOperator Matoimaru showed no symptoms of Oripathy. \n\n[Blood Originium-Crystal Density] 0.12u/L \nOperator Matoimaru rarely comes into contact with Originium."},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"Matoimaru is a magnificent warrior from the Far East.\nShe is simpleminded and prone to deception. She does catch on, but a new trick will fool her again.\nHer hobbies, at which she excels, are sparring, soccer, and floral arrangement. She has been known to organize events around these subjects, though her idea of organization is typically dragging people kicking and screaming into it."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"The Oni are still a mystery to most people. Aside from living in the Far East, there seems to be little in common among the race. \nHowever, Matoimaru is yet even more different from other Oni: Her bloodlust makes her performance on the battlefield strikingly unique, though it seems she's not aware of this fact."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"Many Operators think Matoimaru is crude and unrefined, but they are mistaken.\nThey just need to check out her floral arrangements, on display every Saturday at 3pm. \nThe beauty she can create is positively astonishing."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"Matoimaru is obviously self-conscious about her flaws: She is not good at controlling her strength or at critical thinking. \nShe took up floral arrangement to refine herself and to show the others they don't need to fear her. \nDespite this, she's remains quite gullible. At least she has learned to question the idea that she must be a great thinker in order to survive. \nAs far as she is concerned, her ideal companion would be someone who won't deceive or betray her, and will stay with her and guide her. How wonderful that would be..."}]},"appearances":[{"label":"Base","iconPath":"/four-star-icons/Matoimaru%20-%20Base.webp","fullPath":"/four-star-skins/Matoimaru%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/four-star-icons/Matoimaru%20-%20Elite%202.webp","fullPath":"/four-star-skins/Matoimaru%20-%20Elite%202.webp"},{"label":"Frosted Steps","iconPath":"/four-star-icons/Matoimaru%20-%20Frosted%20Steps.webp","fullPath":"/four-star-skins/Matoimaru%20-%20Frosted%20Steps.webp"}],"skinObtainByLabel":{"Frosted Steps":"18 OP"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Guard","type":"class","entries":[{"operatorName":"Pepe","operatorIconPath":"/six-star-icons/Pepe%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"When deployed, all [Guard] Operators gain +20% (+4%) ATK","matchedKeyword":"Guard"}]},{"operatorName":"Bison","operatorIconPath":"/five-star-icons/Bison%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"DEF +70 (+20) ; If a Vanguard or Guard is deployed behind Bison, that Vanguard or Guard gains the same effect.","matchedKeyword":"Guard"}]},{"operatorName":"Wild Mane","operatorIconPath":"/five-star-icons/Wild%20Mane%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"After deployment, all undeployed Guard Operators get DP Cost -1 (each Operator can have a maximum of -5 DP Cost before each deployment)","matchedKeyword":"Guard"}]},{"operatorName":"Bellone","operatorIconPath":"/six-star-icons/Bellone%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Blaze","operatorIconPath":"/six-star-icons/Blaze%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Ch'en","operatorIconPath":"/six-star-icons/Ch'en%20-%20Base.webp"