ll},{"name":"Sora","rarity":5,"isFuture":null},{"name":"Specter","rarity":5,"isFuture":null},{"name":"Specter the Unchained","rarity":6,"isFuture":null},{"name":"Spot","rarity":3,"isFuture":null},{"name":"Spuria","rarity":5,"isFuture":null},{"name":"Stainless","rarity":6,"isFuture":null},{"name":"Steward","rarity":3,"isFuture":null},{"name":"Surfer","rarity":5,"isFuture":null},{"name":"Surtr","rarity":6,"isFuture":null},{"name":"Sussurro","rarity":4,"isFuture":null},{"name":"Suzuran","rarity":6,"isFuture":null},{"name":"Swire","rarity":5,"isFuture":null},{"name":"Swire the Elegant Wit","rarity":6,"isFuture":null},{"name":"Tachanka","rarity":5,"isFuture":null},{"name":"Taraxacum","rarity":5,"isFuture":null},{"name":"Tecno","rarity":5,"isFuture":null},{"name":"Tequila","rarity":5,"isFuture":null},{"name":"Terra Research Commission","rarity":1,"isFuture":null},{"name":"Texas","rarity":5,"isFuture":null},{"name":"Texas the Omertosa","rarity":6,"isFuture":null},{"name":"Thorns","rarity":6,"isFuture":null},{"name":"Thorns the Lodestar","rarity":6,"isFuture":null},{"name":"THRM-EX","rarity":1,"isFuture":null},{"name":"Thumpy","rarity":6,"isFuture":null},{"name":"Timeslot","rarity":5,"isFuture":null},{"name":"Tin Man","rarity":5,"isFuture":null},{"name":"Tippi","rarity":5,"isFuture":null},{"name":"Titi","rarity":6,"isFuture":null},{"name":"Toddifons","rarity":5,"isFuture":null},{"name":"Togawa Sakiko","rarity":6,"isFuture":null},{"name":"Tomimi","rarity":5,"isFuture":null},{"name":"Totter","rarity":4,"isFuture":null},{"name":"Tragodia","rarity":6,"isFuture":null},{"name":"Tsukinogi","rarity":5,"isFuture":null},{"name":"Tuye","rarity":5,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"U-Official","rarity":1,"isFuture":null},{"name":"Ukusik","rarity":5,"isFuture":null},{"name":"Ulpianus","rarity":6,"isFuture":null},{"name":"Underflow","rarity":5,"isFuture":null},{"name":"Utage","rarity":4,"isFuture":null},{"name":"Valarqvin","rarity":5,"isFuture":null},{"name":"Vanilla","rarity":3,"isFuture":null},{"name":"Varkáris","rarity":5,"isFuture":null},{"name":"Vendela","rarity":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"SP Charging":{"entries":[{"name":"Exusiai the New Covenant","rarity":6,"isFuture":null},{"name":"Aak","rarity":6,"isFuture":null},{"name":"Angelina","rarity":6,"isFuture":null},{"name":"Archetto","rarity":6,"isFuture":null}],"totalCount":94}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[2,2],[2,3],[3,1],[3,2]]}},{"elite":1,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Need something? If you don't ,how about some divination?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Just tell me when there's work to do. But don't ever put her and me on the same team. I hate her guts. And don't get me started on all the weird food she makes me eat... Just thinking about it makes me... euurghh...","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"No one told me Hibiscus was at Rhodes Island before I got here... It's too late for me to quit now.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"If you grow up sheltered, you don't know how to taunt, how to destroy, and how to handle yourself in a real fight. Am I right, Doctor?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Have you ever heard the saying 'little sisters are justice'? If that's true, then my big sis is evil by default... at least as far as I'm concerned.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Instruments? I can play the piano a little. My teacher in Leithanien said learning an instrument can improve your Arts affinity. It also apparently eases the impact that Oripathy has on your mind...","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I'm starving... Huh, what's this? You keep sweets in here? Nom... I'm in the middle of training. Should I really be eating this?","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"See, like, I don't have a big beef with Hibiscus... It's all water under the bridge. I'm fine with her as long as she doesn't force me to eat her medicine and food. After all, she was the one... who saved my life...","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"I almost envy your ability to sleep like a log...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I'm Lava, a Caster, here to join you simply because I'm bored and want something to do… But I heard my sworn nemesis is here too, though... Can I just quit now?","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Thanks.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Did you forget? I don't need a cause to work for, and I don't need a team... but... thanks, I guess...","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"As far as teamwork's concerned... I don't mind, as long as nobody messes up.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I'm not good at this sort of stuff, but if you insist...","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Let's go. Keep an eye on my back.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"I can see their souls. They're mine to reap.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"What are you waiting for?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Hurry up.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Come on.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"That's it.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"It's game over for you.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Even the dead can't save you.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"The supreme form of Arts. I'm interested in seeing what it's like.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"I foresaw this result earlier. A perfect victory.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Well… My fortune telling isn't always right. Sometimes there's a lot of external noise that affects the outcome.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Dammit... These evil spirits are too strong...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Oh, come on. I'd rather be alone.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Don't touch me! Uaghh!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Eh, you're not scoring any points with me like that!","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"I need your help, Doctor. Tell me, Just in what world do I fall under the category of 'Out of Shape?' I was feeding myself some fried-foulbeast, and that annoying Hibiscus took it away, before peeling the coat off and handing the rest back to me! The crispy, crunchy coat! She took it! Gone! There's *NO* way I can get my hands on what I want to eat with her around! There's gonna be a fight... Ugh! Never mind.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Oh, it's you, Doctor. Morning.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor. Here, I made you a pair of gloves. And take a look at these beautiful patterns on them! Cool, aren't they? I got them from my divination, which always comes true. You too will learn that in the future.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"My infection made my sister's life hell as well. It may not look like it, but deep inside my heart resonates with hers, because what we all want is to help those in need with our hands. Speaking of which, isn't she still on shift today? Huh, how can someone have the right to call me the one that worries when she pushes herself this hard?","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Díana Bermudez"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_121_lava/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Kaori Mizuhashi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_121_lava/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Ying Xie"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_121_lava/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Ha-young"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_121_lava/{voiceIdLower}.mp3"}]}}}