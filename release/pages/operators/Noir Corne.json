:6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":1,"rows":1,"opCell":[1,1],"rangeCells":[]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"What's up, Doctor? Me, I'm just on standby.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"My shield? Fun fact: I personally provide a portion of the energy it needs.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"What I look like beneath the mask? Well, I... Actually, let's keep it secret for a bit longer.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Man, nothing better than a break after you finish a mission.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Doctor, if I get to know you better, I figure my shield's gonna get even sturdier.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Course I know where my limit's at. But I don't want Yato to worry about me, which is what matters. We'll worry about the rest some other time!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"There's always the need for guys like me, you know? Nah, I'm not trying to act high and mighty. What I'm saying is: when you have a VIP plus a lot of danger, you need a guy to stand between them, that's all.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Sometimes you've just gotta take off the mask and catch a breather.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Defender Noir Corne, reporting for duty. You need VIP protection, I'm your guy.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Cool... So this stuff is what Grandpa Rangers was talking about earlier.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"Added to Squad","text":"We bringing friends?","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I'm gonna get even stronger!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Holding the line is a Defender's most important job!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"We're doing it!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"C'mon, say something.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"What's up?","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"I've got this!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Here I come!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Watch it, buddy!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Reinforce defenses!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"Even guys like me are happy to get through tough battles like these.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"That was all right.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Well, we managed.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"This wouldn't have happened if I'd worn my good mask! God dammit!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Alright, let's take a breather.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Yeah?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"You wanna get some drinks after work?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"It's these kinds of days I love the most. Everyone has a blast getting together, and we're off work. C'mon, Doctor, you gotta try this burdenbeast offal flambé while it's still fresh from the pan! Whoa, whoa, I don't think Dr. Kal'tsit's gonna like you drinking that much, y'know?","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Nothing outta the ordinary, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Yo, Doctor! Here's a mask from my stash, straight to you! You've rocked the hood for long enough, right? You could try masking up, just for today. Think about it! And hey, if no one else is gonna say it, I will—I think you'll look cool as hell with it on.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"With all the years I've spent at Rhodes Island, I know exactly what's left on the agenda today. The Doctor's still got mad business, alright? Can't keep 'em any longer. Everyone, a toast to the Doctor, who's spent another year working hard for us! To you!","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_005","title":"Post-Promotion Talk 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_013","title":"Elite Promotion 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2002,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2003,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Ben Cura"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_500_noirc/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Kengo Kawanishi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_500_noirc/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Zhaokun Liu"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_500_noirc/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Ryu Seung-gon"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_500_noirc/{voiceIdLower}.mp3"}]}}}