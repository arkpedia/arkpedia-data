":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Welcome back, Doctor. Steward at your service.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Steward is my surname, as well as my Operator codename. Doctor, I'm sure you can tell from it what my ancestors did for a living.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"I didn't expect to see another from my clan here. Is she looking for someone? I know how that feels... Oh, never mind.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"People often say our fur has the 'color of snow.' Doctor, have you ever seen snow?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Lava has a very distinct fighting style. I thought she was going to cast with her book, but her real Arts Unit is a dagger. Her style reminds me of the mystic who taught me Arts.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"It is my honor to work for you, Doctor. But if possible, I do hope you pay some extra care to Melantha. She's always alone…","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Adnachiel is a mysterious one... No one can tell what he is thinking.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Ansel... It's okay... I stopped caring about my identity as an Infected long ago. In fact, I received a lot of help because of it. Before the infection takes away what's dear to me, I will use it to create a place where everyone can live in peace.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Are you tired? Do take a good rest, Doctor. Rhodes Island will need your skills tomorrow.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Caster Steward reporting in. I'm glad to be working with you.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"I have learned a lot. Thank you.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"I'm glad that you are satisfied with my work. Instructor Dobermann will be happy too.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"What can I do for you?","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Cardigan, always read the situation before you act.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Well, I'll be sure to bring you some good news.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"They probably won't make it to tomorrow.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Awarting orders.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Gladly!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Got it.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Understood.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Freeze!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Down you go.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"With the right strategy, we'll make it through any tight spot.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"A perfect victory. Good work, everyone!","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Ansel, please check the casualties for me. We must prepare for the next battle.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Did we make a mistake somewhere...?","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Is that you, Cardi— WAI-WAIT! WAIT! Don't touch the equipment!","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Hmm?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, is there anything I can do for you?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Heavy snow always dominates Kjerag at this time of the year, burying everything from the last year beneath. With that, our calendar turns a new page. If possible, Doctor, I really wish to give you a tour of my hometown. But, the wilds there are dangerous on snowy days, and you'll need me as your guide.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Awaiting your instructions, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor! And allow me to be your personal butler today! Steward, at your service.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Had I not come to Rhodes Island, I would't have had the opportunity to continue my study on Originium Arts, let alone making friends with my teammates in Reserve Op Team A4. I will cherish all I have at present, for chances like these don't grow on trees. So, Doctor, let us keep up the hard work.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Gregg Lowe"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_210_stward/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Chihiro Suzuki"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_210_stward/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Pei Zhang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_210_stward/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Han Man-joong"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_210_stward/{voiceIdLower}.mp3"}]}}}