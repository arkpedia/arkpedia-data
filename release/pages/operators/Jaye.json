ame":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Silence":{"entries":[{"name":"Ho'olheyak","rarity":6,"isFuture":null},{"name":"Lappland the Decadenza","rarity":6,"isFuture":null},{"name":"Lappland","rarity":5,"isFuture":null},{"name":"Skybox","rarity":5,"isFuture":null}],"totalCount":15}},"forms":null,"skillRanges":{"2":{"skillName":"Sashimi Platter","baseRangeId":"1-1","baseRange":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]},"levelRangeIds":["x-4","x-4","x-4","x-4","x-4","x-4","x-4","x-4","x-4","x-4"],"grids":{"x-4":{"cols":3,"rows":3,"opCell":[2,2],"rangeCells":[[3,1],[3,2],[3,3],[2,1],[2,3],[1,1],[1,2],[1,3]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Need me to make you some midnight snacks, Boss?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Here you go, Boss. And this. You mentioned it before... Everyone says I have a good memory, but I don't know.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"When I'm off… I practice cooking. Not just seafood. What do you like to eat, Boss?","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Errr… Boss, is it usually on me to find something to talk about?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Boss, if you ever want to see a Lungmen night market, I can take you. It's fun... but not exactly safe.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Boss Lady Kal'tsit gave me special permission to use Rhodes Island's supply channels. Now I can try some new stuff. Any requests, Boss?","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"I had Officer Hoshiguma on me for a while, for a couple of reasons... But I know she was just looking out for me, same as the neighborhood aunties and uncles.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I've been told that with my looks, my good memory and knife skills, I was born to be a villain. I don't like that, and I've struggled to find a proper way to change myself. But after coming to Rhodes Island, I realized I should just live my own life.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Boss, do you think there's any way to put my memory to good use...? I never thought about it before, but it would be nice if I could help.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Bo... Oh, you're asleep. I'll just keep reading then.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Hey, Boss. I'm Jaye. Officer Hoshiguma said I'd be better off working here, so here I am. I know seafood, I can cook, and I'm pretty good with a knife. I think I can help.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Oh... so cooking and warfare are pretty alike…","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Boss, does this mean I can expand my stall a bit more?","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Boss, I figured it out. If you just treat the enemy like fish, then fighting is a lot easier.","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"I forgot to close up…","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I know how to lead a fishing crew.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Hm? We're going?","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"That's a lot.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Yeah?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Right here.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"I'll try.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Ughh...","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Scale.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Gut.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Clean.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Slice.","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Boss, did we just do something special?","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Boss, is it... is it over?","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Boss, should we go after them?","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Boss, I think we should probably run.","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I don't know if there's a suitable place to set up my stall…","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Hm?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Boss, I wonder if you have any food preferences...?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"I used to always have to close up the stall late, but now all of a sudden it's a holiday. Can't say I'm used to it... Boss, you want some late-night chow? I'm a little hungry myself. I can cook something for us both.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Hey Boss, you're looking good today.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"It's your birthday today, Boss. Big day. I always remember it, but I'm no good at presents... How about I make you something to eat? Whatever you want, I'll whip it up.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"When Officer Hoshiguma said I should come to Rhodes Island, I was ready to work my hands to the bone. Then I realized, I may not get paid as much as I thought I would, but the work's also easier than I thought, so I guess it balances out... I'll keep doing my best, Boss.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Yung-I Chang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_272_strong/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Yusuke Shirai"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_272_strong/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Gary"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_272_strong/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Lee Hyun"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_272_strong/{voiceIdLower}.mp3"}]}}}