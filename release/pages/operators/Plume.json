6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Don't worry, Doctor. No matter what happens, I'll protect you.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Liberi have excellent eyesight. According to legend, some can even tell one droplet from another in a rainstorm. Sounds incredible, huh?","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"I take everyday life too seriously? My apologies. I think that comes from my time serving as a Laterano Guard. I'll work on that in the future.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"To most Lateranos, heavy armor doesn't serve much of a purpose. Of course, when we perform the large-scale rituals of our homeland, we do dress up in ceremonial garb.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"I appreciate your faith in my abilities, Doctor. I won't let you down.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Right... I submitted a request to the HR office... to become your personal bodyguard. I guess maybe I miss my old job too much.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I grew up in Laterano and didn't really have the chance to learn about other cultures. Here at Rhodes Island, I get to see such diversity, way beyond my imagination. Actually...it's not so bad.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"I have no regrets. Yes, true, they did drag me out of Laterano against my will... but this has been a great adventure. I've enjoyed it.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"It is my duty to protect you, Doctor. Rest assured.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"My name is Plume, formerly of the Pontifica Cohors Lateran. I will be your sword, and your wings, as I defend your very life.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Ah, so tactics can help you overcome a more skilled opponent, huh?","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Thank you, Doctor. As your bodyguard, your approval is the best reward I can ask for.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"I'm ready.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"As the leader, it's my responsibility to keep everyone safe.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Watch the friendlies!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Keep your guard up!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Hmm?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Got it.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Ready for overwatch.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Understood!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"You think you're faster than me?","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"No move can escape my sight!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"My resolve lies with my spear!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"I fight for the glory of Laterano!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Nothing can hold me back.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Like a wave crashing against an immovable stone, isn't it?","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Regroup! I'll look out for the remaining enemies!","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I can't... fall... yet!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Should I patrol this area?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Anything over there?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor... it feels like I'm abusing my position...","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Lift the corners of my mouth, don't knit my eyebrows...good, hold steady, then ease my mind, relax... Okay, now get in and greet everyone… Ah! Doctor, you scared me. Um, Happy New Year!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Hello, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"So today is your birthday, Doctor? Alright, happy birthday! I promise I'll see my guard duty through more vigilantly. Uh, I mean, if you're going to hold a birthday get-together like the Laterans do, then I'll ensure your safety, and take responsibility for the aftermath.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Someone once told me that the honor of protecting Laterano was the sole reason I fought. But now, I have more things to protect. My beliefs, my companions, and you. It all weighs heavier on my spear, but I will never let it slow down.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Rosie Jones"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_192_falco/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Rika Tachibana"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_192_falco/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Vila"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_192_falco/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Yoon Mi-na"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_192_falco/{voiceIdLower}.mp3"}]}}}