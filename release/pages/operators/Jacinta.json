-1"],"grids":{"x-1":{"cols":5,"rows":5,"opCell":[3,3],"rangeCells":[[5,3],[4,2],[4,3],[4,4],[3,1],[3,2],[3,4],[3,5],[2,2],[2,3],[2,4],[1,3]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"博士，红茶和点心都已经准备好了，还有什么需要我做的吗？","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"罗德岛想拓展和太阳谷的合作？联系这个地址可能有用。也准备增加雷姆必拓的矿石采购？这个号码也许帮得上忙。还想更新药物产线？这……这我好像没有什么渠道，我自己现学来得及吗？","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"母亲一直教导我作为一名优雅的淑女，要时时注重衣着的整洁，仪态的端庄——我脸上的泥？还有袖子上的草屑？咳，我们为了躲天灾钻进了沙地兽的洞穴里，那经历实在是太有趣了！您要听听吗？","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"呼，博士要来一起跑步吗？虽然圈数完成了，但我还不想停下来——跑起来的时候，我觉得时间都慢了下来，我像是跑在它的前面一样！","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"晋升后交谈1","text":"咳咳，早上的训练已经做完了，吃完午餐下午去学习攀岩的技巧。安洁莉娜答应我说，要是我的身体能好一点，她就带我去萨尔贡的雨林。我得再快一点，再努力一点，还有很多想做的事呢！","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"晋升后交谈2","text":"这本日历之前很薄，但它现在越来越厚啦——这页是我学源石技艺的笔记，这页是我送信的照片——它原本只是用来记录一个可怜病人仅剩的时间，不过它现在会记录我拥有一段何等精彩的人生。","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"信赖提升后交谈1","text":"您觉得医疗部的叮嘱很多？以前只要我出门，父亲就会在路上装满空气净化装置，说怕路上不安全，母亲还吓得要吃降压药。噗，比起家里面，医疗部的大家已经很善解人意啦。","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"塔妮急着向我们展示她的开车技术，阿梅利亚设计了新的车载通讯台，安洁莉娜说她现在可以让整辆载具都飞上半空，我们打算再去旅行一趟。博士要一起来吗？载具上正好还有一个空位呢！","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"您是说我们沿途搭建的通讯塔传递了消息，成功预警了一场天灾？博士，这真的是我听到的最好的消息——我不仅自己长了很多见识，甚至现在我还能帮到别人，这、这就是我想要的生活！","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"呼，就说整理文件这种工作没有很复杂嘛，父亲母亲还总是不让我做，才不会累到我呢。","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"嘉辛塔·坎贝尔，向您问好，博士。初次见面，这是我从雷姆必拓为您带来的甜胡萝卜风味红茶，希望您品尝过后，能享受心情愉悦的一天。","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"欸！博士您看，就是那只有袋鼷兽，就是它偷走了我们的东西！","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"精英化晋升1","text":"我会把这枚徽章也夹进我的日历里面去的，它的厚度在我的努力下又增加了呢！","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"精英化晋升2","text":"博士，我现在每一天都过得无比充实、幸福。能学习、实践，还能用自己的力量去帮助别人——要我帮您喝掉今天的健康果蔬汁？那不行那不行，我受不了的。","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"编入队伍","text":"终于有机会和大家一起在雷姆必拓旅行了，我会尽力帮助大家的！","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"感谢大家的信任，我会成为一名合格的领队。","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"我们出发吧！","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"注意检查背包，会有有袋鼷兽偷东西的哦。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"咳咳……没事，只是呛了一下，我跟得上的！","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"呼、呼……还好出发前做了体能训练……","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"要不要试一试他们说的间歇泉冲浪？","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"据说有的瓶树里面还可以游泳呢！","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"嘘，博士，那是只两米高的大钳兽，快别动了躲起来……","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"嘘——博士，那头牙兽有五米长，别让它发现我们……","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"嘘————博士，那群针蚤靠近我们了，安静屏住呼吸……","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"啊啊啊请！离我！远一点！一位淑女需要她的个人空间——","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"看嘛，我就说如果是大家一起的话，肯定能行的！","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"博士，能帮我拍一张照片吗？我要纪念我又来到了一个之前没来过的地方！","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"噗，我们像是被扔进泥地里滚了一圈一样，不过还挺有趣的，哈哈哈……！","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"我们的背包真的被有袋鼷兽偷得干干净净呢……","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"我以为太阳谷的移动舰船就已经足够大了，原来罗德岛是一个移动地块啊。","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"欸，这是罗德岛的打招呼方式吗？原来是这样，我记下了。","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"嗯，请您放心，我有在好好吃药、定期接受治疗的。","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"（写字声）新年快乐博士，您收到这封信的时候，应该正在和罗德岛的大家聚在一起庆祝吧？大铁屯正在举办新年的黄金萝卜节，我找来了最漂亮的一根随信寄来，希望您会喜欢它的味道！","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"祝您拥有愉快的一天，博士。","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"请您跟我来，博士，外面的花园里已经准备好了生日主题的下午茶。噗，不用担心，这次有袋鼷兽不会来偷走甜品的，因为我给它们也准备了一份~","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"大家都会为自己定周年目标呢，我听到塔妮偷偷地加了一句想再长高一点点。我？我的心愿就是，希望能有更多的时间，每一年这个时候都能和大家聚在一起，开开心心地庆祝我们又一起努力了一年。","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["田泽茉纯"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4237_jcinta/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["蔡海婷"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4237_jcinta/{voiceIdLower}.mp3"}]}}}