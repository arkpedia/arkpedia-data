8},{"level":7,"mastery":null,"description":"Stops attacking and recovers 18 DP over the skill duration","initialSp":12,"spCost":29,"duration":8},{"level":null,"mastery":1,"description":"Stops attacking and recovers 18 DP over the skill duration","initialSp":13,"spCost":28,"duration":8},{"level":null,"mastery":2,"description":"Stops attacking and recovers 18 DP over the skill duration","initialSp":14,"spCost":27,"duration":8},{"level":null,"mastery":3,"description":"Stops attacking and recovers 18 DP over the skill duration","initialSp":15,"spCost":26,"duration":8}],"recommendation":[],"cost":null,"pairings":[],"techniques":[]},{"name":"Parasol's Shade","recoveryType":"Auto Recovery","activationType":"Manual","duration":null,"levels":[{"level":1,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.1 times; additionally heals 1 allied Operator in range for 10% of ATK every second","initialSp":5,"spCost":40,"duration":30},{"level":2,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.2 times; additionally heals 1 allied Operator in range for 12% of ATK every second","initialSp":5,"spCost":39,"duration":30},{"level":3,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.2 times; additionally heals 1 allied Operator in range for 15% of ATK every second","initialSp":5,"spCost":38,"duration":30},{"level":4,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.4 times; additionally heals 1 allied Operator in range for 15% of ATK every second","initialSp":7,"spCost":37,"duration":30},{"level":5,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.4 times; additionally heals 1 allied Operator in range for 17% of ATK every second","initialSp":7,"spCost":36,"duration":30},{"level":6,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.7 times; additionally heals 1 allied Operator in range for 17% of ATK every second","initialSp":7,"spCost":35,"duration":30},{"level":7,"mastery":null,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.7 times; additionally heals 1 allied Operator in range for 22% of ATK every second","initialSp":9,"spCost":34,"duration":30},{"level":null,"mastery":1,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.9 times; additionally heals 1 allied Operator in range for 22% of ATK every second","initialSp":11,"spCost":33,"duration":30},{"level":null,"mastery":2,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 1.9 times; additionally heals 1 allied Operator in range for 24% of ATK every second","initialSp":13,"spCost":32,"duration":30},{"level":null,"mastery":3,"description":"Stops attacking and recovers 27 DP over the skill duration. During the skill duration, Talent range expands, and its effects are increased to 2 times; additionally heals 1 allied Operator in range for 25% of ATK every second","initialSp":15,"spCost":30,"duration":30}],"recommendation":[],"cost":null,"pairings":[],"techniques":[]}],"skillCost":null},"baseSkills":[],"modules":[{"type":"Original","name":"Jacinta's Badge","stages":[]},{"type":"Upgrade","name":"BEA-X: 弹射起步","mission":{"requirement1":"Complete 5 battles with your own Jacinta and have her be the first Operator deployed","requirement2":"Clear Main Theme 7-2 with a 3-star rating; You must deploy your own Jacinta, and no Operators can be defeated"},"stages":[{"stage":"Stage 1","attributesIncreased":"HP +100 , DEF +40","effectLabel":"New trait","effectText":"Cannot block enemies during the skill duration, but grants +1 Block to an Operator in front of this unit","cost":[{"name":"Module Data Block","quantity":2},{"name":"Polymerized Gel","quantity":2},{"name":"LMD","quantity":80000}]},{"stage":"Stage 2","attributesIncreased":"HP +125 , DEF +52","effectLabel":"Ladylike Manners improved","effectText":"When deployed, this unit and allies within the surrounding 8 tiles gain 15% Anti-Air Sanctuary","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Stick","quantity":60},{"name":"Chiral Refractor","quantity":3},{"name":"LMD","quantity":100000}]},{"stage":"Stage 3","attributesIncreased":"HP +135 , DEF +60","effectLabel":"Ladylike Manners improved","effectText":"When deployed, this unit and allies within the surrounding 8 tiles gain 18% Anti-Air Sanctuary","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Instrument","quantity":20},{"name":"LMD","quantity":120000}]}]}],"review":{"official":"雷姆必拓知名矿业大亨坎贝尔夫妇的千金，前来罗德岛接受矿石病治疗。根据本人意愿，现作为先锋干员为罗德岛提供帮助。","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":50,"base":{"hp":651,"atk":223,"def":179,"res":0,"redeploy":70,"dp":9,"block":1,"interval":1.3},"max":{"hp":892,"atk":319,"def":249,"res":0,"redeploy":70,"dp":9,"block":1,"interval":1.3},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":70,"base":{"hp":892,"atk":319,"def":249,"res":0,"redeploy":70,"dp":11,"block":1,"interval":1.3},"max":{"hp":1130,"atk":421,"def":328,"res":0,"redeploy":70,"dp":11,"block":1,"interval":1.3},"rangeId":"1-1"},{"elite":2,"minLevel":1,"maxLevel":80,"base":{"hp":1130,"atk":421,"def":328,"res":0,"redeploy":70,"dp":11,"block":1,"interval":1.3},"max":{"hp":1548,"atk":502,"def":387,"res":0,"redeploy":70,"dp":11,"block":1,"interval":1.3},"rangeId":"1-1"}],"trust":{"hp":100,"atk":0,"def":45}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"造影检测结果显示，该干员体内脏器轮廓模糊，可见异常阴影，循环系统内源石颗粒检测异常，有矿石病感染迹象，现阶段可确认为矿石病感染者。\n\n【体细胞与源石融合率】13%\n干员嘉辛塔体表有少量源石结晶分布。\n\n【血液源石结晶密度】0.41u/L\n干员嘉辛塔的病情在近几年得到了良好的控制，但情况仍旧不容乐观。\n\n经过一系列的体检和测试，医疗部干员发现嘉辛塔干员的病情和各项身体情况与她带来的厚厚一沓病例报告中的没有很大出入，但肌肉含量和心肺功能等几项指标不知为何有显著的提升。\n医疗部干员本想咨询她究竟是做了哪些训练才能在几个月之内有这样的效果，好将其推广给全体病人，但得到的答案是“两次穿越了雷姆必拓”。"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"高挑、文静、温柔，不论在什么时候，裙摆和衣角永远洁白、一丝不乱......这些通常都是嘉辛塔干员给大家留下的第一印象，大家也一直和嘉辛塔维持着礼貌友好的社交关系，担心过分外向热情可能会冒犯或者吓到她，直到那一天：\n为了丰富病人们的生活，医疗部决定在花园中举办一场歌会，不论是不是病人都可以报名登台演唱自己喜欢的歌曲，一时之间大家踊跃报名，嘉辛塔也邀请了珊比和自己一起演唱一首雷姆必拓歌谣《哦呜哦！》。轮到两人登台的时候已经快到傍晚了，众人有些意兴阑珊，不过她们二人还是兴致勃勃地自我介绍后立刻敞开歌喉——\n据那天远在另一个地块的工程部干员所说，那时她正想要赶快测试完器械的稳定性好去吃晚饭，却不知为何水平仪一直在颤动，在她百思不得其解最终决定打开窗户透透气的时候，一阵极具穿透性的歌声闯进了她的耳朵——“卡特斯的耳朵~不怕被风吹歪~哦呜哦——！♪”——她终于明白了为何自己的水平仪在颤动，也莫名地被歌声所感染，决定去现场看看。\n于是她在花园里看到了大家手拉着手，乱七八糟地跳着有些滑稽的舞步，哈哈大笑着。舞台上的嘉辛塔兴致高昂——虽说音量显然比不过珊比——唱着快要跑调的歌曲，完全看不出平时文静的样子。\n这次歌会最终以《哦呜哦！》的多次返场演唱结束，所有人都玩得很高兴，而且，在清楚了嘉辛塔的“真面目”之后，来找她一起玩的干员一下子多了好几倍。"},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"罗德岛的医疗部近期获得了一大笔投资。有了这笔投资，医疗部可以更有余力地继续新药物的研发和药物产线的扩张，还有医疗器械的设计和升级等等。不过，任何一笔钱都不是平白无故出现的：\n在嘉辛塔干员加入罗德岛后没多久，一对中年夫妻带着一群看上去很不好惹的黑衣人和一群拿着各类医疗器械的医生拜访了罗德岛。他们自称是嘉辛塔干员的父母坎贝尔夫妇和嘉辛塔干员的保镖及医护团队，前来探望嘉辛塔，并打算负责她在罗德岛的生活安全和治疗。\n于是那一天，嘉辛塔干员带着她的父母参观了宿舍、病房、餐厅等等她的生活区域，坎贝尔夫妇不仅一路千叮咛万嘱咐要注意哪些问题，还试图和人事部洽谈，要为嘉辛塔定制一套专门的衣食住行和治疗方案、准备改造她的宿舍、确认她将承担的任务与训练的强度等等等等......在随行的人事部干员思考是否要出言干预一下的时候，嘉辛塔干员反而先“暴喝一声”，制止了坎贝尔夫妇无休无止的叮嘱。\n和人事部干员所担心的不同，在嘉辛塔干员向坎贝尔夫妇展示了自己各项训练通过的证明和任务许可证明之后，他们听从嘉辛塔干员的话撤走了保镖和医护团队，选择相信并支持女儿如今做出的选择。不过在离开之前，他们还是想要用自己的方式关心女儿——于是在短暂的商量之后，罗德岛的医疗部突然获得了一大笔投资，可用于各项医疗研究，以便更好地照顾嘉辛塔干员。甚至，在得知罗德岛的运行需要大量的能源支持后，坎贝尔夫妇还与采购部商讨了一下未来的矿石采购合作。在确保了罗德岛有充足的资源照顾好他们的女儿，也确定了嘉辛塔可以照顾好她自己之后，坎贝尔夫妇终于满意地启程返回雷姆必拓。\n嘉辛塔很高兴。这么多年以来，除了疗养中心和家中已经被改造成病房的房间之外，她终于拥有了一间自己的宿舍：它确实没有很大，设施也没有那么齐全，但这是第一间属于她，可以被她自由打扮的房间——这也代表着，她和父母现在已经找到了新的相处模式。\n当然，华法琳和终于又拉到了生意的可露希尔也很高兴！"},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"嘉辛塔有一本日历。\n五岁的时候，嘉辛塔有了她的第一本日历。那本日历并不是嘉辛塔自己买的，是在医生说她活不过一个月时，她的父母买的。坎贝尔夫妇在上面密密麻麻地记录了嘉辛塔去治疗的时间、服药的时间、他们纪念旅行的时间......不过那本日历最后被坎贝尔夫妇扔掉了，因为那段辛苦的经历令他们相当疲惫，他们只需要看到嘉辛塔仍在他们的保护下活着就好。\n十岁的时候，嘉辛塔自己买了一本日历。为了能够确保她的健康，坎贝尔夫妇将她送进了疗养中心，并聘请了各类人员来负责她的学业、起居、兴趣爱好。但与之相对的，业务繁忙的坎贝尔夫妇并不能时常去探望她，而身体不好的嘉辛塔也不能长时间地离开中心返回家中，所以她买了一本日历，在上面记录父母来探望她的日子。那本日历后来也被嘉辛塔扔掉了，父母来看望她的日子越来越少，嘉辛塔觉得自己并不需要专门来做那些记录。\n十九岁的时候，嘉辛塔在自己主治医生的诊室里发现了一本日历。那本日历和其他日历不一样，它是由未来几年的日历合订在一起的，每一页都密密麻麻写满了注意事项，最后数页被标注了灰色。嘉辛塔知道，那是医生推测的她大概余下的时间。那天她回到房间以后大哭了一场，随后自己又做了本一模一样的，一天过去就撕掉一张，看着它越来越薄，越来越薄，等待着撕掉最后一页的那一天到来。\n她之前不是没有尝试过从疗养中心里跑出去，但没人愿意带着她这样一个重症患者上路，她的尝试和失败都只是日历上一个不起眼的小小标记。直到某一天，嘉辛塔照例撕去一张，随后发现日历不知何时已经变得只剩薄薄一点。\n既然之前已经失败过，再尝试一次也没有什么大不了的。那，为什么不是今天呢？嘉辛塔推开门跑了出去。\n从跑出来的那一天开始，嘉辛塔的日历越来越厚，每一次纪念的合照，每一张去过的地方的地图，甚至是路边吃饭时的小票、一撮毛掉落的绒毛，她都加了进来。当一天过去，她准备撕掉一张时，后面已经加了无数张她生活中的点点滴滴。\n嘉辛塔有一本日历，这本日历在变得越来越厚。"},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"在罗德岛的治疗告一段落后，嘉辛塔开始了她的旅途。\n或许是运气不错，也或许是因为嘉辛塔一直挂念着她和时隙的创业计划，她似乎总是会在令人意想不到的时候找到办法，将她们两人的产品推销出去。\n在萨米观光时，她把原本只是带来测试的移动信号基站借给救援队，成功救出了被困的人员；和卡达一起拍视频，点赞量和粉丝量暴增，吸引了不少传媒公司联系；甚至跟着极光准备攀登雪山——身体状况所限，她最终明智地选择放弃攀爬——嘉辛塔都能偶遇莱茵生命的工作人员，将阿梅利亚的名片送到她憧憬的哥伦比亚大公司手中，收到消息的阿梅利亚每天都高兴得掉眼泪。\n不过，嘉辛塔在旅途中遇到的事情也不只是和她与时隙的创业计划有关。\n身为一名矿石病患者，嘉辛塔知道有些事情其实很难处理和解决。那天在雪山脚下，嘉辛塔遇到了一个衣着单薄的人。源石结晶在那人的皮肤上蔓延开来，每一步都会牵扯皮肉渗出血痕，谁都能看出来她是一名重症患者。雪山只是雪原中的一座普通雪山，附近的居民靠着它生活，逐渐有了信仰，也许那人在这里是为了祈福，但嘉辛塔知道，这样除了会对那人的健康造成不可逆的伤害之外，不会有什么帮助。周围的村民告诉她，那人已经疯了，最好离远一些，他们从来都不和她说话的。\n她陪着那个人在山脚下呆了三天，刚开始嘉辛塔还会不停地劝说，试图分享自己的药品和食物，也帮她支好了帐篷，联络罗德岛办事处的干员寻求援助，但那人始终一言不发。在发现那人的精神愈加萎靡之后，嘉辛塔也不再劝说了，她只是坐在那人身边不远处，静静地陪着，时不时为面前的火堆增加些燃料，好让她们都舒服一些。\n在第四天太阳升起的时候，那人的帐篷空空如也，嘉辛塔只发现了帐篷里的一片树皮，上面用灰烬写着一行小字：“谢谢你陪着我。”在很远处的山洞中，她找到了那人崩解留下的痕迹。\n“至少她最后没有很孤单......”出乎医疗干员的意料，在说起这件事的时候，嘉辛塔显得很平静。"},{"section":"Promotion Record","unlock":"Unlocked at E2","description":"......\n是我们狭隘了。我们从没有想过你会如此勇敢。我们本以为让你活下去就是最好的，却无视了你的痛苦，也......无视了我们自己的痛苦。\n我不想在信里说太多，免得你误会，我只想告诉你，天知道收到你在南境的照片时我们有多惊喜——你真的做到了！\n在大铁屯的时候，是你母亲告诉我，她从来没见你像那天晚上开车时那么高兴。我当时半信半疑，觉得你母亲只是太向着你......但你在南境时看起来真的很高兴，自从你生病之后，我很久很久都没有见过你笑得这么开心了。真的太久太久了。这是我的错。\n我们勇敢的小家伙，我们的女儿，谢谢你给了自己一个全新的人生，也谢谢你给了我一个重新审视自己的机会。\n对不起。\n谢谢你。\n你永远是我们的骄傲。\n——你的父亲"}]},"appearances":[{"label":"Base","iconPath":"/five-star-icons/Jacinta%20-%20Base.webp","fullPath":"/five-star-skins/Jacinta%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/five-star-icons/Jacinta%20-%20Elite%202.webp","fullPath":"/five-star-skins/Jacinta%20-%20Elite%202.webp"}],"skinObtainByLabel":{},"synergyMatches":[],"autoSynergyGroups":[{"name":"Vanguard","type":"class","entries":[{"operatorName":"Bagpipe","operatorIconPath":"/six-star-icons/Bagpipe%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"When this unit is in the squad, all Vanguards gain +8 (+2) Initial SP","matchedKeyword":"Vanguard"}]},{"operatorName":"Siege","operatorIconPath":"/six-star-icons/Siege%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When deployed, all Vanguard Operators' ATK and DEF +10% (+2%) [ note 1 ]","matchedKeyword":"Vanguard"}]},{"operatorName":"Bison","operatorIconPath":"/five-star-icons/Bison%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"DEF +70 (+20) ; If a Vanguard or Guard is deployed behind Bison, that Vanguard or Guard gains the same effect.","matchedKeyword":"Vanguard"}]},{"operatorName":"Grani","operatorIconPath":"/five-star-icons/Grani%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"All [Vanguard] Operators obtain 25% (+5%) P