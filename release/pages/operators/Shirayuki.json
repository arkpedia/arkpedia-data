Skill Summary - 1","quantity":2},{"name":"Diketon","quantity":3}],"4":[{"name":"Skill Summary - 2","quantity":3},{"name":"Device","quantity":1}],"5":[{"name":"Skill Summary - 2","quantity":3},{"name":"Orirock Cube","quantity":4}],"6":[{"name":"Skill Summary - 2","quantity":3},{"name":"Manganese Ore","quantity":2}],"7":[{"name":"Skill Summary - 3","quantity":4},{"name":"Grindstone","quantity":2}]}},"baseSkills":[{"name":"Clue Search β","facility":"Reception Room","eliteLevel":"Base","description":"When this Operator is assigned to the Reception Room, Clue search speed increases by 20%"},{"name":"Combat Guidance Video","facility":"Factory","eliteLevel":"Elite 1","description":"When this Operator is assigned to a Factory, Battle Record formula related productivity +30%"}],"modules":[{"type":"Original","name":"Shirayuki's Badge","stages":[]},{"type":"Upgrade","name":"ART-Y: Shuriken","mission":{"requirement1":"Deal a total of 120,000 damage with Shirayuki (excluding Support Units)","requirement2":"Clear Main Theme S2-11 with a 3-star rating; You must deploy your own Shirayuki, and have Shirayuki defeat at least 15 enemies"},"stages":[{"stage":"Stage 1","attributesIncreased":"HP +80 , ASPD +3","effectLabel":"New trait","effectText":"Attacks ignore 100 DEF","cost":[{"name":"Module Data Block","quantity":1},{"name":"Incandescent Alloy","quantity":4},{"name":"LMD","quantity":20000}]},{"stage":"Stage 2","attributesIncreased":"HP +120 , ATK +20 , ASPD +4","effectLabel":"New talent: Circling Wind","effectText":"Improves own SP recovery rate by +0.2/second for 10 seconds after defeating an enemy","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Stick","quantity":15},{"name":"Aketon","quantity":5},{"name":"LMD","quantity":25000}]},{"stage":"Stage 3","attributesIncreased":"HP +160 , ATK +30 , ASPD +5","effectLabel":"Circling Wind improved","effectText":"Improves own SP recovery rate by +0.3/second for 10 seconds after defeating an enemy","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Instrument","quantity":5},{"name":"Semi-Synthetic Solvent","quantity":6},{"name":"LMD","quantity":30000}]}]}],"review":{"official":"Formerly the personal bodyguard of Lady\nFumizuki\n, wife of\nLungmen's\nChief\nWei Yenwu\n, Shirayuki was sent to\nRhodes Island\nto serve the\nDoctor\nin the same role, after the\nLungmen Guard Department\npartnered with the company. She uses large shurikens as her weapons of choice, and is well-versed in covert ops and intelligence gathering. She protects the Doctor from behind the scenes.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":45,"base":{"hp":834,"atk":347,"def":51,"res":0,"redeploy":70,"dp":23,"block":1,"interval":2.8},"max":{"hp":1043,"atk":496,"def":66,"res":0,"redeploy":70,"dp":23,"block":1,"interval":2.8},"rangeId":"3-3"},{"elite":1,"minLevel":1,"maxLevel":60,"base":{"hp":1043,"atk":496,"def":66,"res":0,"redeploy":70,"dp":25,"block":1,"interval":2.8},"max":{"hp":1304,"atk":621,"def":84,"res":0,"redeploy":70,"dp":25,"block":1,"interval":2.8},"rangeId":"3-8"},{"elite":2,"minLevel":1,"maxLevel":70,"base":{"hp":1304,"atk":621,"def":84,"res":0,"redeploy":70,"dp":27,"block":1,"interval":2.8},"max":{"hp":1630,"atk":797,"def":100,"res":0,"redeploy":70,"dp":27,"block":1,"interval":2.8},"rangeId":"3-10"}],"trust":{"hp":0,"atk":70,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests reveal clear, normal outlines of internal organs, and no abnormal shadows have been detected. Originium granules have not been detected in the circulatory system and there is no sign of infection. At this time, this Operator is believed to be non-infected. \n\n[Cell-Originium Assimilation] 0% \nOperator Shirayuki showed no symptoms of Oripathy. \n\n[Blood Originium-Crystal Density] 0.12u/L \nOperator Shirayuki rarely comes into contact with Originium."},{"section":"Archive File 1","unlock":"Unlocked at 25 trust","description":"A reserved ninja who is incredibly succinct with her words, never using two when just one would do. \nYou never know where she might be until she is needed by the Doctor and she appears with unerring, possibly even eerie, dependability. \nHer hobby is apparently watching the snow from the coast, but it is not known if her preference is for the coast, the snow, or a necessary combination of the two."},{"section":"Archive File 2","unlock":"Unlocked at 50 trust","description":"Large shurikens are Shirayuki's weapon of choice. \nThere are many shapes and sizes of shurikens, but no matter the type, throwing weapons are always difficult to wield effectively.\nUndoubtedly, Shirayuki is an expert at using them, exhibiting accuracy and lethality that most normal people would find impossible given the unwieldiness of these weapons."},{"section":"Archive File 3","unlock":"Unlocked at 100 trust","description":"The ninja is commonly held as one of the national symbols of the Far East. \nThese mysterious assassins can allegedly walk on walls, burrow underground, and kill from impossible angles. They are said to value loyalty above all else. \nA ninja, upon pledging fealty, will serve his lord unwaveringly. And that is exactly what Dr. Kal'tsit is having an issue with--Shirayuki's loyalty lies with Madam Fumizuki, not the good Doctor at Rhodes Island."},{"section":"Archive File 4","unlock":"Unlocked at 150 trust","description":"Of course, the true purpose of Shirayuki's presence at Rhodes Island is not to protect the Doctor, that much is certain. That was just a pretext for Rhodes Island to accept her. \nStill, that does raise some questions. \nEven though it's ostensibly a partnership, Lungmen and Rhodes Island hold different views and objectives. Still, the Governor sent off his wife's personal bodyguard to protect the Doctor. Whether for surveillance or a show of power, it was very blunt, even unnecessary. \nSupposedly, Madam Fumizuki doesn't involve herself in politics, but it's hard to imagine she has no ulterior motive with this move. \nSo then, what are Shirayuki's orders after all?"},{"section":"Promotion Record","unlock":"Unlocked at 200 trust","description":"The princess said blind loyalty is nigh-impossible to find. But here you are, and I like it. —Shirayuki"}]},"appearances":[{"label":"Base","iconPath":"/four-star-icons/Shirayuki%20-%20Base.webp","fullPath":"/four-star-skins/Shirayuki%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/four-star-icons/Shirayuki%20-%20Elite%202.webp","fullPath":"/four-star-skins/Shirayuki%20-%20Elite%202.webp"},{"label":"Wind of Breaking Blade","iconPath":"/four-star-icons/Shirayuki%20-%20Wind%20of%20Breaking%20Blade.webp","fullPath":"/four-star-skins/Shirayuki%20-%20Wind%20of%20Breaking%20Blade.webp"}],"skinObtainByLabel":{"Wind of Breaking Blade":"15 OP"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Sniper","type":"class","entries":[{"operatorName":"Archetto","operatorIconPath":"/six-star-icons/Archetto%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"Every 2.5 seconds when deployed, restores 1 Skill Point to all deployed Sniper allies that have an Offensive Recovery skill.","matchedKeyword":"Sniper"}]},{"operatorName":"Ch'en the Holungday","operatorIconPath":"/six-star-icons/Ch'en%20the%20Holungday%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When deployed, Ch'en's ammo-based skills have a 22% (+2%) chance to not consume the corresponding ammo for each shot; Other Sniper Operators' ammo-based skills have a 10% chance instead (only the highest effect of this type will be applied)","matchedKeyword":"Sniper"}]},{"operatorName":"Schwarz","operatorIconPath":"/six-star-icons/Schwarz%20-%20Base.webp","isContributor":true,"badges"