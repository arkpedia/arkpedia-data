"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":{"1":{"skillName":"Healing Range Up","baseRangeId":"3-3","baseRange":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[2,2],[2,3],[2,4],[1,1],[1,2],[1,3],[1,4]]},"levelRangeIds":["3-3+1","3-3+1","3-3+1","3-3+2","3-3+2","3-3+2","3-3+2"],"grids":{"3-3+1":{"cols":5,"rows":3,"opCell":[2,1],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[2,2],[2,3],[2,4],[1,1],[1,2],[1,3],[1,4],[3,5],[2,5],[1,5]]},"3-3+2":{"cols":6,"rows":3,"opCell":[2,1],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[2,2],[2,3],[2,4],[1,1],[1,2],[1,3],[1,4],[3,5],[3,6],[2,5],[2,6],[1,5],[1,6]]}},"changesAt":["Level 4"]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Doctor, it's time for your injection. Oh, um, are you alright?! Are you scared of needles?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Like Dr. Kal'tsit is always telling you, Doctor, you really need some exercise. I'm new here, but you still need to listen to my advice.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Cardigan! We've told you, if you move like that when you strike, you'll wind up getting hurt.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Good grief... Doctor, you need to take care of yourself. You can't make us do it for you.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Are you worried about my health after so many night shifts? You shouldn't be. My race has a unique way of producing hormones, which allows us to handle night activities better. So I can hand my shift over to Hibiscus at just the right time.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"You must stop with the midnight snacks. Don't go bringing up my eating habits. I eat at night because of my race! Yes, it's a racial trait!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I'm Ansel. It's a little embarrassing to admit, but I chose to become a Medic because I've been sickly since I was young. But now that I'm an Operator, I'll make sure not to burden you. So please treat me just the same way you treat the others.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"I know everyone does what they can. But I heard from Dr. Kal'tsit that Steward and Melantha's conditions aren't looking too good... My job is to make their lives as easy as possible. Doctor, let's redouble our efforts, together.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Adnachiel, could you ask Cardigan to settle down for a moment? The Doctor is resting.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I am Ansel, a medical intern. I'll be assisting with surgery and internal medicine, among other things. I look forward to working with you.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"I hope I didn't cause you any trouble.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"I'm glad that you care so much for the wellbeing of us Medics.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"Ready whenever.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Medical support should be the top priority for any tactical squad.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Alright, all medicine has been prepared.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Injections ready. Prepare for battle.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"First aid box is ready.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Awaiting your orders.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Ready to heal!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Please hold on!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Clear!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Your medication is here. Take it!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"Phew, thank goodness I brought enough medicine. Please don't worry.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"I was very impressed by everyone's performance. It was fantastic.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Please hold on, I'll treat your injuries right away.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"We've sustained injuries! I need to get the wounded to the rear. Cover me!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I'm checking on the medical supplies here.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Whoa, Doctor, please don't mess with me!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, I'm very glad that you like me.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"The Medical Department actually gets <i>busier</i> around New Year's. People hurt themselves setting off fireworks or gorging on food... I get wanting to indulge in the holiday spirit, but you need to keep yourselves safe too. You know how to take care of yourself, Doctor, don't you? Very well. With that, I wish you happy new year. May you spend the year without that kind of visit to Medical.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Good day, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, good evening. It's just past midnight, so I think it counts as your birthday. Happy birthday to you! I got you a cake, but my advice is to wait till tomorrow to eat it. Oh, come to think of it, does this make me the first to wish you a happy birthday?","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"I only came to Rhodes Island at first because no other place would accept my resume. It seems more like a kind of destiny now. All of A4 are maturing, and I can't fall behind, Doctor. The good news is, test results show my health condition has gotten a lot better over the last year.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Claire Morgan"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_212_ansel/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Mayumi Kaneko"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_212_ansel/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Kousou Mao"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_212_ansel/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Ahn Hyun-seo"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_212_ansel/{voiceIdLower}.mp3"}]}}}