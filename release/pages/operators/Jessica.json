me":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"I-Is there anything I can help with? Just say the word and I can do it.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Franka and Liskarm are so incredible! I really admire them. I want to become as great as they are someday. I can... I can do it! Will you help me, Doctor?","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Um, I heard word that Vanilla's here too? She was in my squad when she first joined Blacksteel. We went on missions together! She's become such a reliable Operator now... but I'm still just me...","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Dr. {@nickname}, do I come off as... spineless? I know I shouldn't let people walk all over me... I'm trying to change...","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Sometimes I feel like I'm back in Blacksteel, even after going through so much with Rhodes Island. I'm not the old me anymore, either... it's weird. Is it because I miss how it was back then? No, no. I don't miss the person I used to be, I know that for sure...","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Hard work doesn't mean anything without results. That's what I think at least! That's why I don't want anyone to see me training alone. Having you, though... it's really comforting when you're with me, for some reason.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"I pulled a muscle training a couple days ago... but don't worry, I-I'm okay! Urk...! I won't let this get in the way of you or anyone at Rhodes Island, Doctor!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Freeze, hands in the air! Oh, did I scare you? I'm sorry, it's just Franka told me to be bold and assertive, and I only wanted to try it out... I'm really sorry...","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Everyone at Blacksteel and Rhodes Island is so amazing and talented. I know I'm nothing compared to them... but, still, just every once in a while, I really like it when I get compliments...","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Doctor... Doctor? Are you sleeping? I'll clean your desk up for you, then...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Um, are you Dr. {@nickname}? Nice to meet you. I'm Jessica from Blacksteel Worldwide. Sorry... I'm really bad at introducing myself...","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"This seems a lot more effective than training by myself.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Doctor... I'm... I'm so happy you're honoring me... Just... let me cry it out for a bit, I'll be fine...","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Ah, Doctor, does this mean you think I'm a great Operator? Thank you so much for all your help. You were by my side all the way...!","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Just give your orders and I'll carry them out!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I won't let you down!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Stay focused... look straight ahead.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"I'll definitely prove myself this time!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Standing by...","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Haah?","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Ughh...","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"All right...","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Y- you'll pay for that!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Freeze!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Not one step backward.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"I'll show them what I can do!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"I'm going to climb to the top of the mountain. I won't stop halfway!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"I... I really did it? I managed to protect everyone by myself?","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"I could do better. I can't get complacent just because we won!","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Requesting medevac! I dragged everyone down... it's all my fault! Sorry! I'm sorry!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I wonder if the people at Rhodes Island are nice...?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Where are we going...?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"I can do a little cooking...","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Uh... S-Sorry, Doctor. I think I pushed myself too hard. My hands won't stop shaking... But I can hang these balloons on my own, no problem! Alright... Happy New Year, Doctor.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Good morning, doctor...","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor! Sorry… I can't make anything myself, so I had to buy you a gift… It's too expensive? It could pay for a whole month of training? B-But isn't that pretty normal for a gift?","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Back at those Blacksteel ceremonies, when we all got to meet the really highly-decorated mercs, I would find myself wondering if I could ever match them… But since coming to Rhodes Island, I'm always thinking about how much I'd like to go on the really tough missions with the senior operators.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Yuuki Luna"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_235_jesica/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Ryo Hirohashi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_235_jesica/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Fifi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_235_jesica/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Ha-young"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_235_jesica/{voiceIdLower}.mp3"},{"id":"old_en","label":"Legacy EN","actors":["Rebecca LaChance"],"status":"legacy","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/legacy/256053567424c27eac3e9ef8cc411f5d13cb8c21/char_235_jesica/{voiceId}.mp3"}]}}}