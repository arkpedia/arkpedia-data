l},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Is there anything I can help you with, Doctor?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Thank you for believing in me! I'll keep up my work!","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Hibiscus and Lava are fighting again... What a pain. Why are they like this? They're sisters.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Instructor Dobermann puts us through mock battles a lot, but I can never get a handle on her skill. Doctor, next time you and Amiya observe our training, would you please give us some notes?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Someone on my team is late again, huh? I'll make sure that gets fixed.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Lava and I are both Infected, but I didn't get a talent for Arts like she did...","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Rhodes Island is our home and shelter, Doctor. I will protect everyone here with my life.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"The ever-honest and reliable Beagle, the perceptive Kroos, the resourceful Lava and the energetic Hibiscus. I like everyone in this team... as long as Hibiscus doesn't force her health food innovations on me.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Shhh! The Doctor's resting. We can talk outside.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Lancer Fang, captain of Reserve Op Team A1. My team and I will do our best to serve Rhodes Island.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Thank you for your guidance.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Your approval means so much to me, Doctor. This promotion proves my hard work is paying off.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"Leave it to me.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I know the captain's duty well. Rest easy.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Team, check your gear before departing.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Enemy spotted. Prepare to fight!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Ready for action.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"On standby.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"In position.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Leave it to us.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Thrust!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Everyone, follow me!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"With the right plan, even rookies like us can win a tough fight!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"We have accomplished our objective as planned.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"We can't call a mission complete if we let even a single enemy get through. Beagle, let's do better on the next one.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I'm sorry I failed you, Instructor Dobermann...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Yes. I'm back. Is Kroos here too?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Ahh...!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Am I helping?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year, Doctor. Our team's going to eat dinner together, and we were just about to invite Instructor Dobermann. Would you like to come as well? I have some combat-related questions I'd like to ask, too... Oh, sorry, I know I shouldn't be mentioning work on a holiday.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"I'm ready whenever you need me, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, happy birthday! We got you a birthday present as a team. Have you seen Kroos? We agreed to do this together, and she still vanished. Anyway, whatever she told you, just don't believe a word of it, we did actually—awgh! Krooth! Whah ah yoo cavvarin m' mauph phor?!","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Looking at our set goals, I've already finished all my training, the other members of my team have made huge progress under Dobermann's instruction too, and we're adapting better and better on the combat side of things. Doctor, I'll be a better captain than I'm now, I promise.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Norma Butikofer"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_123_fang/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Ryoko Shiraishi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_123_fang/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yee Chen"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_123_fang/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Ha-ru"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_123_fang/{voiceIdLower}.mp3"}]}}}