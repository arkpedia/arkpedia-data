ity":10},{"name":"Bipolar Nanoflake","quantity":4},{"name":"Manganese Trihydrate","quantity":3}]},"pairings":[],"techniques":[{"name":"Immortality","description":"Allow this unit to take big damage from enemies, while also not dying for it."}]}],"skillCost":{"2":[{"name":"Skill Summary - 1","quantity":4}],"3":[{"name":"Skill Summary - 1","quantity":4},{"name":"Orirock","quantity":10}],"4":[{"name":"Skill Summary - 2","quantity":6},{"name":"Sugar","quantity":3}],"5":[{"name":"Skill Summary - 2","quantity":6},{"name":"Polyester","quantity":5}],"6":[{"name":"Skill Summary - 2","quantity":6},{"name":"RMA70-12","quantity":3}],"7":[{"name":"Skill Summary - 3","quantity":6},{"name":"Orirock Cluster","quantity":4},{"name":"Integrated Device","quantity":2}]}},"baseSkills":[{"name":"Solitude","facility":"Dormitory","eliteLevel":"Base","description":"When this Operator is assigned to a Dormitory, self Morale recovered +0.7 per hour"},{"name":"CrazeReplacesSolitude","facility":"Dormitory","eliteLevel":"Elite 2","description":"When this Operator is assigned to a Dormitory, self Morale recovered +0.85 per hour"}],"modules":[{"type":"Original","name":"Specter's Badge","stages":[]},{"type":"Upgrade","name":"CEN-X: Dim Candlelight","mission":{"requirement1":"Complete a total of 5 battles; You must deploy your own Specter, and unleash Bone Fracture at least 1 time in each battle","requirement2":"Clear Intermezzi SN-EX-1 with a 3-star rating; You must deploy your own Specter, and have Specter defeat at least 10 Nourished Sliders"},"stages":[{"stage":"Stage 1","attributesIncreased":"ATK +34 , DEF +30","effectLabel":"Trait improved","effectText":"Attacks all blocked enemies ; ATK is increased to 110% when attacking blocked enemies","cost":[{"name":"Module Data Block","quantity":2},{"name":"Refined Solvent","quantity":3},{"name":"LMD","quantity":40000}]},{"stage":"Stage 2","attributesIncreased":"ATK +52 , DEF +42","effectLabel":"New talent: Experiences Dissolved in Blood","effectText":"While deployed, increases the damage dealt by all Abyssal Hunter Operators by 3%","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Stick","quantity":20},{"name":"Incandescent Alloy Block","quantity":4},{"name":"LMD","quantity":50000}]},{"stage":"Stage 3","attributesIncreased":"ATK +60 , DEF +48","effectLabel":"Experiences Dissolved in Blood improved","effectText":"While deployed, increases the damage dealt by all Abyssal Hunter Operators by 5%","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Instrument","quantity":8},{"name":"White Horse Kohl","quantity":5},{"name":"LMD","quantity":60000}]}]}],"review":{"official":"Specter, true identity unknown, records missing. Demonstrated extraordinary ability in combating\nlarge creatures\nand destroying sturdy targets, speculated to correlate with extensive prior combat experience.\nNow stationed as a\nGuard\nat\nRhodes Island\n.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":50,"base":{"hp":1199,"atk":293,"def":150,"res":0,"redeploy":70,"dp":19,"block":2,"interval":1.2},"max":{"hp":1538,"atk":407,"def":215,"res":0,"redeploy":70,"dp":19,"block":2,"interval":1.2},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":70,"base":{"hp":1538,"atk":407,"def":215,"res":0,"redeploy":70,"dp":21,"block":2,"interval":1.2},"max":{"hp":1972,"atk":551,"def":291,"res":0,"redeploy":70,"dp":21,"block":2,"interval":1.2},"rangeId":"1-1"},{"elite":2,"minLevel":1,"maxLevel":80,"base":{"hp":1972,"atk":551,"def":291,"res":0,"redeploy":70,"dp":23,"block":3,"interval":1.2},"max":{"hp":2630,"atk":725,"def":355,"res":0,"redeploy":70,"dp":23,"block":3,"interval":1.2},"rangeId":"1-1"}],"trust":{"hp":0,"atk":80,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests done on Specter showed a blurry outline around her internal organs, with visible abnormal dark spots. Unusually high concentrations of Originium particles were present in her circulatory system, indicating signs of Infection and confirming her as Infected at this stage. \n\n[Cell-Originium Assimilation] 14% \nWhile Specter showed no physical signs of Originium crystals, her nervous system has suffered a case of severe Infection, the cause behind which remains unknown. \n\n[Blood Originium-Crystal Density] 0.31u/L \nStill within manageable range. Even then, without knowing the specific cause for her Infection, test data cannot accurately reflect her condition and are of little use. \n\nIn addition, Specter is plagued by severe mental health issues, including but not limited to: memory loss, emotional instability, and lack of self-awareness. Unfortunately, I am not a neurologist nor a psychiatrist and thus unqualified to speculate on the cause or solution, but I wish to make note of her mental condition in her file. \n—Medic Operator Silence"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"It was difficult probing into Specter's past. When Rhodes Island took her in, she showed temporary lucidity until she lapsed into psychosis before treatment could be administered. \nIn her day-to-day life, Specter's mental condition remains unstable, thus greatly limiting her social interactions with other Operators. \nMedical staff will continue administering regular tests and treatment, although success has been limited to date."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"Based on intel gathered, Specter was once a nun residing at a convent. The matter was not investigated further due to her current mental state and Rhodes Island's present goals. \nHowever, Dr. Kal'tsit believes Specter's past is closely linked to that convent, which is also likely hiding the truth behind her mysterious past."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"The medical department's in-depth examination revealed Oripathy to be the cause of Specter's deteriorating physical health. \nFurthermore, Specter lacked both the necessary aptitude and knowledge to wield Originium powers. This is puzzling and greatly impacts her combat ability. \nDespite her difficulties, Specter was still devastatingly powerful during her missions, to the point of unsettlement. She undoubtedly has incredible room for growth and improvement. \nEven more important is her polarizing attitudes in combat and in her daily life. \nShe is demure and quiet in battle (other than a few occasional mumbles to herself), with a mindless tendency to follow orders to the end, completely unaware of potential danger and obstacles. Her inability to react has endangered her safety more than once. \nIt can be concluded that Specter is a vital part of the squad, but a commander must also adapt to her single-mindedness and plan accordingly."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"[Classified Log] \nIn actuality, when Specter first approached Rhodes Island, she was articulate and sincere, claiming she had just escaped confinement and wished to deliver a message. \nHowever, she fell silent before she could finish conveying it. In her last moments of sanity, she told the Operator who retrieved her that she has once again gotten entangled in a dark conspiracy. \nAfter she failed to tear off her habit, she then descended into madness."},{"section":"Promotion Record","unlock":"Unlocked at E2","description":"Folksong of a Faraway Land: \nWhen she prayed \nThe stars ceased to shimmer \nAnd when she wept \nThe night let out a smile \nAnd as she lamented \nThe anguish sprawled upon her madness \n\n—From Operator Specter's personal belongings"}]},"appearances":[{"label":"Base","iconPath":"/five-star-icons/Specter%20-%20Base.webp","fullPath":"/five-star-skins/Specter%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/five-star-icons/Specter%20-%20Elite%202.webp","fullPath":"/five-star-skins/Specter%20-%20Elite%202.webp"},{"label":"Undercurrent","iconPath":"/five-star-icons/Specter%20-%20Undercurrent.webp","fullPath":"/five-star-skins/Specter%20-%20Undercurrent.webp"}],"skinObtainByLabel":{"Undercurrent":"15 OP"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Abyssal Hunters","type":"faction","entries":[{"operatorName":"Gladiia","operatorIconPath":"/six-star-icons/Gladiia%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When deployed, all [Abyssal Hunters] Operators recover 2.5% of Max HP per second and receive 25% less Physical and Arts damage from [Seaborn] enemies","matchedKeyword":"Abyssal Hunters"}]},{"operatorName":"Skadi","operatorIconPath":"/six-star-icons/Skadi%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When this unit is in the squad, all [Abyssal Hunter] Operators gain +16% (+2%) ATK","matchedKeyword":"Abyssal Hunters"}]},{"operatorName":"Skadi the Corrupting Heart","operatorIconPath":"/six-star-icons/Skadi%20the%20Corrupting%20Heart%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"ATK +9% (+3%) when there is an allied unit within the range of self or the Seaborn; If the allied unit is an Abyssal Hunter Operator, gain ATK +18% (+3%) instead","matchedKeyword":"Abyssal Hunters"}]},{"operatorName":"Specter the Unchained","operatorIconPath":"/six-star-icons/Specter%20the%20Unchained%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"While this unit is in the squad, all Abyssal Hunters Operators gain +23% (+3%) Max HP","matchedKeyword":"Abyssal Hunters"}]},{"operatorName":"Ulpianus","operatorIconPath":"/six-star-icons/Ulpianus%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","