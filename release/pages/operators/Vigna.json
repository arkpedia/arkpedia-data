5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Hey, hey! I'm watching a rock concert, Doctor! Stop blocking the TV! Just missed the best part thanks to you!","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"You get people who say things like 'fight the power' and 'be yourself.' But for us Sarkaz, that's just life.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"I like bands... no, I LOVE bands! As a guitarist myself, I know every beat, every chord is important. I gotta practice on and on, day and night. That's the only way to give the audience the ultimate face-melting solo!","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"I'm going exceptionally harsh on you, given I've been so nice to everyone else you say? Well, isn't it only natural? Those who shoulder the responsibility of management like you need more than their self-discipline to do their job, Doctor. I have high standards for myself, and I think it's only right for these standards to be applied to you as well.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Hmm, this smell... is this the lunchbox Hibiscus brought you? You want me to eat it for you? No way! This... this wasn't in my job description!","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"If there's something you want out of life, you gotta work hard for it. Like, I want to become stronger, so I train. I want a sharper weapon, so I customize this one myself. People can judge as they want, but I'll stick to my belief until I get what I want!","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Wha?! It's pouring outside? I-I don't... believe it has anything to do with my outdoor concert! Now get aside if you hear me 'cause I'm setting off right NOW! I won't let this sprinkle dampen my passion by one bit!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"You got an important mission you want me to handle? Hehee, you can count on me! Let's see here... 'You are to acquire the following products for Rhodes Island during a time-limited mega-sale...?' Th-that's impossible!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Even if the crowd starts booing, the show must go on. You can't quit in the middle of a performance just because you messed something up. Same is true for the Sarkaz and infected. We won't have anything left with us if we just call it quits.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Hey, you can't sleep over here! Ugh... you're too heavy for me to carry...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Excuse me, is this the office of the Doctor? I've been looking for the place quite a while and it'd be really appreciated if—what? YOU'RE the Doctor? Hmpf, I see. Operator Vigna, reporting in!","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"You gotta be willing to sweat a lot to keep up the battle tempo!","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Am I wearing my elite medal right? Great! In that case, it's time to get a picture for this remarkable moment!","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Pure strength might not be my forte, but my spear and unparalleled skills shall always leave them with a deep impression!","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"I'll learn from others' battle techniques.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I may be the team captain, but you can all let me know where and how I might improve.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Everyone, prepare to deploy. And please keep in mind that coordinated actions bring victory.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Eyes on me—it's showtime!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Oh!","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Mhmm.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Here I go!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Battle stance ready!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Say no more!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"My blood is boiling!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Victory shall be mine!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Now! Tear them to shreds!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"No matter how tough the bad guys are, I won't stop strumming! Oh… 'fighting' might be the better word here!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"You all deserve a commendation from me, oh, but not you, Doctor, not yet! Your job's not finished until I see everyone back home safe and sound.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"We're not out of trouble yet! Hold formation!","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Ugh... This can't be it. We have to fight harder!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Is there a soundproof room here? My fingers are itching for guitar strings so BAD!","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Hey! That just gave me a chill!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"D-Don't pat me on the head! It might make me shorter!","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy new year, Doctor! I can see you're hyped for the new year concert tonight just like me! Here's an inside scoop for you: my guitar solo will close the concert at its climax! Hehe! Now that we have more and more operators with talents for music on Rhodes Island, who can say our future concert won't be a hit like that Obsidian Festival in Siesta!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"How can I help?","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor! A perfect time for everyone to get hyped-up, don't you think? How about we take the meeting room and hold a live concert there! Huh? Still a no, even on your birthday? Aargh… Well, but my song request service is still at your disposal. Oh, but guitar solo only, mind you.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Life at Rhodes Island is like a piece of rock music. Surely there're low drum beats that keep us in suspense here and there, but the theme always catches us with our blood seething and souls resonating. Which kinda reminds me, that it's high time for me to wipe all the craps out with this guitar!... Er, I mean a more creative, musical way, not really wiping the board with it...","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_022.","title":"Selected Operator 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["en"]}],"packs":[{"id":"en","label":"English","actors":["Julia Gu"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_290_vigna/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Asami Shimoda"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_290_vigna/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Angel Zhang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_290_vigna/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Ahn Hyun-seo"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_290_vigna/{voiceIdLower}.mp3"}]}}}