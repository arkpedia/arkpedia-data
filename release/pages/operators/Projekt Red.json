mmary - 3","quantity":6},{"name":"White Horse Kohl","quantity":3},{"name":"Keton Colloid","quantity":5}],"m3":[{"name":"Skill Summary - 3","quantity":10},{"name":"Bipolar Nanoflake","quantity":4},{"name":"Keton Colloid","quantity":3}]},"pairings":[],"techniques":[]}],"skillCost":{"2":[{"name":"Skill Summary - 1","quantity":4}],"3":[{"name":"Skill Summary - 1","quantity":4},{"name":"Orirock","quantity":10}],"4":[{"name":"Skill Summary - 2","quantity":6},{"name":"Sugar","quantity":3}],"5":[{"name":"Skill Summary - 2","quantity":6},{"name":"Polyester","quantity":5}],"6":[{"name":"Skill Summary - 2","quantity":6},{"name":"Sugar Pack","quantity":5}],"7":[{"name":"Skill Summary - 3","quantity":6},{"name":"Polyester Pack","quantity":3},{"name":"Manganese Ore","quantity":3}]}},"baseSkills":[{"name":"S.W.E.E.P.","facility":"Control Center","eliteLevel":"Base","description":"When this Operator is assigned to the Control Center, increases Morale of all Operators in the Control Center by +0.05 per hour."},{"name":"Tracker","facility":"Reception Room","eliteLevel":"Elite 2","description":"When this Operator is assigned to the Reception Room, Clue search speed increases by 25%"}],"modules":[{"type":"Original","name":"Projekt Red's Badge","stages":[]},{"type":"Upgrade","name":"EXE-Y: Mystery Prop Pack","mission":{"requirement1":"Complete a total of 5 battles; In each battle, you must deploy your own Projekt Red at least 3 times","requirement2":"Clear Main Theme S4-5 with a 3-star rating; You must deploy your own Projekt Red, and have Projekt Red defeat at least 4 Infused Originium Slugs"},"stages":[{"stage":"Stage 1","attributesIncreased":"ATK +50 , ASPD +4","effectLabel":"New trait","effectText":"When there are no allied units in the four adjacent tiles, ATK +10%","cost":[{"name":"Module Data Block","quantity":2},{"name":"RMA70-24","quantity":3},{"name":"LMD","quantity":40000}]},{"stage":"Stage 2","attributesIncreased":"ATK +65 , ASPD +4","effectLabel":"Chill improved","effectText":"Deals at least 37% of ATK damage every attack","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Stick","quantity":20},{"name":"Incandescent Alloy Block","quantity":4},{"name":"LMD","quantity":50000}]},{"stage":"Stage 3","attributesIncreased":"ATK +74 , ASPD +4","effectLabel":"Chill improved","effectText":"Deals at least 40% of ATK damage every attack","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Instrument","quantity":8},{"name":"Oriron Block","quantity":5},{"name":"LMD","quantity":60000}]}]}],"review":{"official":"Projekt Red's real identity unknown and her background a mystery. She was taken in, raised, and protected by Dr.\nKal'tsit\n. Extremely talented in high mobility warfare, special ops and stealth combat.\nProjekt Red now serves as a\nSpecialist\nOperator\nfor\nRhodes Island\nunder Dr. Kal'tsit's guidance.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":50,"base":{"hp":703,"atk":204,"def":135,"res":0,"redeploy":18,"dp":7,"block":1,"interval":0.93},"max":{"hp":938,"atk":301,"def":194,"res":0,"redeploy":18,"dp":7,"block":1,"interval":0.93},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":70,"base":{"hp":938,"atk":301,"def":194,"res":0,"redeploy":18,"dp":9,"block":1,"interval":0.93},"max":{"hp":1173,"atk":413,"def":253,"res":0,"redeploy":18,"dp":9,"block":1,"interval":0.93},"rangeId":"1-1"},{"elite":2,"minLevel":1,"maxLevel":80,"base":{"hp":1173,"atk":413,"def":253,"res":0,"redeploy":18,"dp":9,"block":1,"interval":0.93},"max":{"hp":1505,"atk":530,"def":302,"res":0,"redeploy":18,"dp":9,"block":1,"interval":0.93},"rangeId":"1-1"}],"trust":{"hp":0,"atk":75,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests on this Operator show clear outlines of internal organs, with no abnormal dark spots or shadows. No unusual traces of Originium particles present in the circulatory system, no signs of infection, confirming this operator as uninfected. \n\n[Cell-Originium Assimilation] 0% \nOperator Projekt Red showed no symptoms of Oripathy. \n\n[Blood Originium-Crystal Density] 0.13u/L \nOperator Projekt Red has come into contact with Originium in many missions and the number of exposures is increasing. She must be warned of the potential risks. \n\nVarious physical examinations have returned normal results for Operator Projekt Red. I will handle the case file for this Operator after the process is complete. \n—Kal'tsit"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"Operator Projekt Red's behavior in combat is not easily understood. Projekt Red's style seems more concise and... barbaric compared to your typical Operator. \nIn daily life, Projekt Red is a mystery, seldom opening up to fellow Operators. They also question her background, based on her lack of education and socialization. \nAny mission requiring her presence signals great difficulty, with high potential casualties and losses, leading some Operators to nickname her 'Reaper in a Red Riding Hood.' \nBut with time, Projekt Red has started to show her innocent side and warmed up to some other Operators. \nMaybe everyone will get to really know and accept her one day, and Projekt Red will become a real part of our community."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"To Projekt Red, she and other Lupus are not 'wolves' as they are often called by the uninitiated. \nInitially, the medical staff viewed Projekt Red as a basic education problem, until she showed inexplicable cognitive abilities in several tests. When faced with an array of randomly arranged objects, Projekt Red would find a way to organize them. \nSome Medic Operators believe this to be a result of color blindness, that a defect or mutation in her nervous system enabled Red to recognize details imperceptible to a normal Lupus. On the other hand, some Medics believe Projekt Red has a unique Originium talent that enhances her awareness far beyond normal. \nSince Medical suspended their testing, most Operators have begun to accept Operator Projekt Red's ability as unique."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"[REVISED CLASSIFIED INFORMATION] \n1. Prohibits all mention of Lupus Operators' violent reaction to Operator Projekt Red and remove such mentions from all public records. \n2. Classify all relevant medical examinations and testing as medical staff access only. \n3. Forbid review of and redaction of any relevant record. \n4. Destroy test data. \n\nAll above actions must be completed within 1-2 work days of signature. \n\nOrdered by:■■·■■■■■■■\nApproved by: Dr. Kal'tsit, ■■■■, Amiya"},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"[Classified Log]\nShould we attempt to deepen our contact with 'Grandma'? \nI think it's a very dangerous proposition. \nHow will it affect Projekt Red? How has 'Grandma' affected Projekt Red? What kind of entity or collective is 'Grandma,'and how did it/they manage to affect her? \nWhat's obvious is, 'Grandma' made Projekt Red who she is today. What she knows about the 'wolves,'how strongly other Lupus feel about her, and possibly many more secrets... Whatever 'Grandma' has planned is tied intimately to Projekt Red's future. \nWhile I tried to formulate some contingencies before, ultimately I chose to destroy all files and research data. \nI must not be rash. \nThis has nothing to do with any risk assessment or theoretical study. \nEven though I cannot do nothing, I cannot be reckless, either. \nI must seize every second of the limited timeframe we have to convince Projekt Red to acknowledge her existence. \n\nShe has the right to choose for herself. \n\n—Kal'tsit"},{"section":"Promotion Record","unlock":"Unlocked at E2","description":"Amiya agreed, we needed a top-secret, highly efficient team. \nProjekt Red is an invaluable member of such a team, having served as one of its first members. \nShe has issues, but that's not my problem, Kal'tsit will see to those. \nAll I'm here to do is sharpen her fangs and her knife. \nRhodes Island needs to take steps like this to ensure that sort of thing never happens again. the Doctor must accept this reality. \n\n——■■■■"}]},"appearances":[{"label":"Base","iconPath":"/five-star-icons/Projekt%20Red%20-%20Base.webp","fullPath":"/five-star-skins/Projekt%20Red%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/five-star-icons/Projekt%20Red%20-%20Elite%202.webp","fullPath":"/five-star-skins/Projekt%20Red%20-%20Elite%202.webp"},{"label":"Light Breeze LB01","iconPath":"/five-star-icons/Projekt%20Red%20-%20Light%20Breeze%20LB01.webp","fullPath":"/five-star-skins/Projekt%20Red%20-%20Light%20Breeze%20LB01.webp"}],"skinObtainByLabel":{"Light Breeze LB01":"18 OP"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Rhodes Island","type":"faction","entries":[{"operatorName":"Closure","operatorIconPath":"/six-star-icons/Closure%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"Minimum DP -4 ( -1 ) when Closure is in the squad; all [Rhodes Island] Operators ATK +4%.","matchedKeyword":"Rhodes Island"}]},{"operatorName":"Kal'tsit - Esperanta","operatorIconPath":"/six-star-icons/Kal'tsit%20-%20Esperanta%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"When other allies enter this unit's Attack Range, they will immediately gain 1 Shield and be granted a buff, healing by 60 ( +10 ) HP per second for 30 seconds (This effect is unable to be stacked and the healing effect is doubled for [Rhodes Island] Operators).","matchedKeyword":"Rhodes Island"}]},{"operatorName":"Angelina the Mellow Wish","operatorIconPath":"/six-star-icons/Angelina%20the%20Mellow%20Wish%20-%20Base.webp"