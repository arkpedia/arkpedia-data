":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Stun":{"entries":[{"name":"Crownslayer","rarity":6,"isFuture":null},{"name":"Hoederer","rarity":6,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"Jessica the Liberated","rarity":6,"isFuture":null}],"totalCount":63},"Minimum Damage":{"entries":[{"name":"Entelechia","rarity":6,"isFuture":null},{"name":"Aciddrop","rarity":4,"isFuture":null}],"totalCount":2}},"forms":null,"skillRanges":{"2":{"skillName":"Wolfpack","baseRangeId":"1-1","baseRange":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]},"levelRangeIds":["x-5","x-5","x-5","x-5","x-5","x-5","x-5","x-5","x-5","x-5"],"grids":{"x-5":{"cols":3,"rows":3,"opCell":[2,2],"rangeCells":[[3,2],[2,1],[2,3],[1,2]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"This place smells… dangerous.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"I prefer to work alone, by myself.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Name, bounty, kill. Simple. That's the agreement with Kal'tsit.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Wolves have fangs, I have my blade. Wolves do not rest, neither do I.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Granny's calling... I can hear her.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Bleak wind, corpses on the ground, screams under the stars... I smell them all, the scent of wolves. I join the hunt.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Family? I have no family. I am always alone. Do you need a family, Doctor?","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"They avoid me... I just want to touch their tails. Provence, and Texas... I like their scent.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, sometimes I wonder... if I weren't a wolf hunter, would my life be different? Oh, you mean… I should answer the question... myself?","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Doctor... no, nothing. I thought you fell asleep. Don't sleep, not now.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Projekt Red, wolf hunter, smells wolves.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"As long as it helps me hunt.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"As you like it.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"A promotion? This will disguise me. I accept.","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Infiltration successful.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"What should I do?","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"The hunt begins.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"The scent... it's thick.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Hurry up.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Simple and clear.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Speed.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Skill.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"From shadows!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Distract them.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"No way out, for you.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Your death... is in my eyes.","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Targets, all down","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"The one way a hunt can end.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"This kill... too small.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Sorry... My blade... not sharp enough.","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I prefer to be outside. But… it's okay.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Watch your hand. I might cut you.","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"*sleepy noises*","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"A new year? That means a new hunt? Not yet? Understood. Then I rest… Doctor, you rest too.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Tired, Doctor?","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"I've seen people. Many people. They went to the Doctor's room, and left things. That spells danger… it doesn't? Birthday presents? Oh, well… I'll lend you this fluffy ball to touch. But you have to give it back.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Rhodes Island has many walls. But I can feel the wind on the deck. Kal'tsit and the Doctor are here. I... like this place.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Jenny Yokobori"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_144_red/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Ami Koshimizu"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_144_red/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["木雅瑞林"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_144_red/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Park Seen-hee"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_144_red/{voiceIdLower}.mp3"},{"id":"old_cn","label":"Legacy CN","actors":["X.Chai"],"status":"legacy","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/legacy/5e1b475f1a8ac48144c1a790224ee8bc8ac130b0/char_144_red/{voiceId}.mp3"}]}}}