ame":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Stun":{"entries":[{"name":"Crownslayer","rarity":6,"isFuture":null},{"name":"Hoederer","rarity":6,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"Jessica the Liberated","rarity":6,"isFuture":null}],"totalCount":63}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"博士和梓兰一样，每天都要讨伐名为“文件”的怪物喵？","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"义经，你还记得随从广场的样子喵？确实喵，这里应该这样画喵——好，这一话完成了，赶紧去给斑点看看喵！没错，把家乡的故事画出来是怀念家乡最好的方式喵，提出这个点子的斑点真聪明喵！","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"泡普卡和宝巫迦陛下的性格完全不同喵！之前她一直盯着我看，我还以为自己做了什么坏事，害怕得睡不着喵！壮着胆子去问她，原来只是想摸摸我喵！现在已经是能够一起睡觉的好朋友了喵！","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"博士，对不起喵！义经之前在训练中差点伤到月见夜喵！因为他把月见夜认成了那个百折不挠的将军，所以下意识就——啊，不是说这边的月见夜不够坚强的意思喵！","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"信赖提升后交谈1","text":"空爆又不见了？我去帮梓兰找找喵！什么，义经，你要拦我？！你居然站在空爆那边喵？！没办法了，决一胜负吧喵！","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"博士也想使用翔虫喵？没问题喵！抓住它尾部分泌的丝线，然后往想要的方向丢出去——糟糕，博士把自己甩飞了，义经，快接住喵！","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"喵？！开会要来不及了？义经——博士，义经让你骑上他喵！但是，要小心，义经的速度很快，以博士的体质——啊，走掉了喵。好像已经听到博士的惨叫声了，没办法，去给博士送药吧喵。","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"义经，你压到我的尾巴了喵……喵？原来是博士喵……","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"我们是来自炎火村随从隐秘队的政宗和义经喵！调查情报和收集素材就交给我们喵！呼——比第一次见到前代陛下时的自我介绍好多了喵！","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"强大的猎人果然都有各自独特的战斗方式喵！","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"编入队伍","text":"狩猎也好，调查也好，都交给我们喵！","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"没错，这可是我们表现的好机会喵！","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"狩猎开始喵！","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"博士，义经嗅到了敌人的味道喵！","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"义经说，敌人就在附近了喵！","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"义经，不要冲动喵！","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"交给我们喵！","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"一定要带回让博士满意的情报和素材喵！","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"让你们见识一下隐秘队的实力喵！","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"一鼓作气解决他们喵！","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"差点打到我了喵！","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"感觉能获得很好的素材喵！","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"能够指挥完成这么困难的任务，博士简直就和那些传说中的猎人一样了不起喵！","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"这次会获得什么样的稀有素材呢，好期待喵！","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"博士，不能掉以轻心，附近还有敌人喵！","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"板车准备好了，快把博士运回去喵！","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"不知道罗德岛和炎火村的锻造场比，哪个比较大喵？","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"敌袭喵？原来是博士喵！","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"罗德岛上的各种器械，好复杂喵……","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"义经，你应该明白的喵？离开炎火村的十年来，我们从未真正分出胜负。哼，别以为只有你变强了，我也变强了喵。今天，是时候了喵，就在这场雪仗里决一胜负——空爆，你偷袭我喵！","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"博士，一起去狩猎喵！","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"博士，为了感谢你一直以来对我们的照顾，我和义经准备了一份炎火村特色的超豪华版兔团子！根据艾草的秘传配方改良而成，保证你吃了以后能够精神百倍地继续工作喵！那还是算了？欸？","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"在泡影国蔓延的“诅咒”，泰拉似乎也存在喵，如果能解开“诅咒”的秘密，我们说不定就能找到回家的路，还能再去一趟泡影国喵！泡普卡他们要是见到了“一模一样”的自己，肯定会吓一跳的喵！","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"linkage","label":"Collaboration","actors":["-"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4215_buddy/{voiceIdLower}.mp3"}]}}}