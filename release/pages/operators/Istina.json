2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":{"2":{"skillName":"Literature Storm","baseRangeId":"y-2","baseRange":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[2,1],[2,3],[2,4],[1,1],[1,2],[1,3],[1,4]]},"levelRangeIds":["x-2","x-2","x-2","x-2","x-2","x-2","x-2","x-2","x-2","x-2"],"grids":{"x-2":{"cols":5,"rows":5,"opCell":[3,3],"rangeCells":[[5,2],[5,3],[5,4],[4,1],[4,2],[4,3],[4,4],[4,5],[3,1],[3,2],[3,4],[3,5],[2,1],[2,2],[2,3],[2,4],[2,5],[1,2],[1,3],[1,4]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,1],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Greetings, I'm here for my shift… That's a peculiar look on your face. Do I seem so unreliable?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"We don't throw ourselves into battle because we want to. We just have a stronger will to survive than most. If you understand, that alone would be enough.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Zima, the girls, and I all came from different schools. But all the students in the city knew the legends of General Zima. Doesn't that sound cool? Literally. Zima is Ursine for 'winter', you see. Hm, yes.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"How did we escape from Chernobog? Hmm... you really don't want to know. Sometimes the truth is better left untold.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Oh? I'm reading a mystery novel… As a matter of fact, it taught me some lessons that proved useful in getting me through that terrible time.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"My favorite books? Hmm, I enjoy topics like politics, economics, and dialectical materialism… Baking magazines and stuff like that are nice too.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Home? My hometown? Obviously, we can't go back there. You know as well as I do that there's nothing left of it. Even if we rebuilt Chernobog, I still…","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Rhodes Island is safe. And there are so many books here in your office... If I could, I'd really prefer to stay here…","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"What will I do in the future? Hmm… No idea. My books don't have an answer for that. I hope someone will offer me one, someday…","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Such a twist is beyond my imagination. 'Every last one of the passengers on this train, you're all murderers!'","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I am Istina. I'm still a student, but I was recruited for my ability to use Arts… Yes, it is rather strange for a student to serve here, isn't it?","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"You want me to be stronger?","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Do you feel like you understand me better now? Naive, you're far from really knowing me.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Now that you've offered me such recognition, I will reveal my true power. Allow me to demonstrate by reducing this office to a fine powder… Just kidding. There are too many precious books here. I would never do something so awful.","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Understood.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Hmm… The team is somewhat different from what I imagined.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Let's show our determination, earnestness, and boundless passion.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"May the star of victory shine upon us.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"What is it, Doctor?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Go ahead.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"I have a distaste for war.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"It seems we must fight.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Come at me.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Please, no need to rush.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Let us take it slow.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Time to teach you a lesson.","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Why do they fight... even when it may cost them their lives? What do they gain from it?","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Doctor, if you have to commend us, now is the time.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Those enemies who fled... We probably won't see them again.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Neither our numbers nor our efforts were sufficient…","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"A secret room, where, shall we say, interesting things happen.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"What?!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"It's too noisy here, I'd rather read in the Doctor's office.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"No, I, I'm not honey-drunk, Sonya just poured me a, a little, but I just felt I should convey to you, a, Happy New Year... Er, are these Sonya's flowers? For the New Year? Why is this flower, burning hot to the touch…","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Hello, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor. This hardcover is my gift to you—Ah, well done, you've discerned without so much as a flip that it contains not literature, but cake. No, I wasn't at all hoping to see you scoop up a handful of icing…","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"'The Silver Branch', 'Mathematical Theory of Originium Arts', 'Superpropositional Logic'... Hm? I'm going through the books I've read this year. Suspense fiction has its merits, but dipping into all manner of knowledge is comforting, in a sense. It lets me believe, undeniably, that I am moving forward.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Risa Mei"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_195_glassb/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Aoi Yuki"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_195_glassb/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Z"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_195_glassb/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Ga-ryeong"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_195_glassb/{voiceIdLower}.mp3"},{"id":"rus","label":"Russian","actors":["Marusia Savicheva"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-regional/main/current/char_195_glassb/{voiceIdLower}.mp3"}]}}}