:null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"It's not the duty of a guard to stand here and do nothing. Why don't we chat a bit?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"With perfect positioning and a suitable environment, my letters will arrive just fine. After all, it's my job, right? I need to do well to survive.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Are you hungry? If you want something to eat, just say the word. I can't compete with Matterhorn in the kitchen, but I can at least cook a decent meal.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"The comms equipment here at Rhodes Island is way too good. At this rate, I'm going to lose my job...","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Anything else you need? Just don't keep me on the line for too long.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Huh? There's a faint smell on the letters? No, you must be imagining things.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"I owe my life to Master SilverAsh. If necessary, I would do anything for him.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"You want me to transport... all these? That's a lot, Doctor! Come on, I'm not a miracle worker!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Seems I'm no match for you. I suppose it's time to retire my business smile for now... *Ahem*... I'd like to show you my true face, from now on.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Doctor, there's a new message for... Ah, never mind.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Esteemed Leader of Rhodes Island, your ally—Courier of the Snow Realm—is here at your service. If you get into any sort of trouble during your contract with Master SilverAsh, just snap your fingers and I'll be there.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Whoa, that's an incredible job well done.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"You'd save a lot of trouble if you sent me onto the battlefield.","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"As a Messenger of the Snow Realm, I'm sure to appear whenever you need me.","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Leave the scouting to me.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I won't blemish the name of the Snow Realm.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Too bad some people just can't live and let live.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"They'll pay for what they've done.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"At your service.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Your orders.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Mhmm.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Forwards!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Attack!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"How's that?","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Haaaghh!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Speeding up!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"I'll bring news of our victory to Rhodes Island right away!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Let's grab a nice dinner after we clean up the battlefield. My treat!","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Anyone injured? I've got medicine and bandages.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Let's get out of here first. Here, this way! Hurry!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I'll greet my roommates and neighbors first.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"How can I help?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Alright, I'll whip up a meal for you later.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Doctor, I've brought you some food from Kjerag to celebrate the New Year. They're still warm, so would you like to try...? Are they to your taste? D—Don't eat so many! The beastmeat isn't that easy to digest!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Call me whenever you need me.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, happy birthday! I have a present for you. You'd like to open it now? How about guessing what's inside first? Mm-hm... Correct, it's a scent sachet! I hope when you're carrying it around, you can feel as though I'm by your side.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"It was Master SilverAsh's choice to partner with Rhodes Island, but I believed in his decision. And my days at Rhodes Island have proven not only how right he was, but also how trustworthy you are.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Joseph May"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_198_blackd/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Daisuke Hirakawa"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_198_blackd/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Ethan"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_198_blackd/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Choi Seung-hun"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_198_blackd/{voiceIdLower}.mp3"}]}}}