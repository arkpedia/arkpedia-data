ity":5},{"name":"Compound Cutting Fluid","quantity":6},{"name":"LMD","quantity":30000}]}]}],"review":{"official":"Courier is a member of the\nKarlan Trade Co. LTD\n, and was born in\nKjerag\n. He is part of the cooperation agreement between the Karlan Trade Co. and\nRhodes Island\n, by which he helps carry out missions for the latter.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":45,"base":{"hp":758,"atk":170,"def":137,"res":0,"redeploy":70,"dp":10,"block":2,"interval":1.05},"max":{"hp":1083,"atk":254,"def":196,"res":0,"redeploy":70,"dp":10,"block":2,"interval":1.05},"rangeId":"1-1"},{"elite":1,"minLevel":1,"maxLevel":60,"base":{"hp":1083,"atk":254,"def":196,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.05},"max":{"hp":1389,"atk":348,"def":273,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.05},"rangeId":"1-1"},{"elite":2,"minLevel":1,"maxLevel":70,"base":{"hp":1389,"atk":348,"def":273,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.05},"max":{"hp":1985,"atk":435,"def":322,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.05},"rangeId":"1-1"}],"trust":{"hp":0,"atk":0,"def":60}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests reveal clear, normal outlines of internal organs, and no abnormal shadows have been detected. Originium granules have not been detected in the circulatory system and there is no sign of infection. At this time, this Operator is believed to be non-infected.\n\n[Cell-Originium Fusion Rate] 0%\nOperator shows no signs of infection at this time.\n\n[Blood Crystal Density] 0.12u/L\nThis Operator has rarely come into contact with Originium."},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"Courier's keen sense of the terrain and environment is entirely from years of experience. In fact, when he was a child, he was not only unfamiliar with the roads, but he would even get lost. The way he tells it, he once got snowbound when he went out to play and almost didn't make it home alive. Fortunately, SilverAsh was hunting nearby and found him, thus returning him to safety. Because of this, no matter who might try to convince or threaten him to turn his back on SilverAsh, Courier will forever be the man's most faithful supporter."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"As a race living in the cold regions of the plateau, the Itra have extraordinary resilience and endurance. Courier is no exception. Still, he likes to keep a low profile. He does everything with skill and with ease, and never lets anyone sees the limits of his abilities. Even SilverAsh is unaware of just what this Itra is capable of."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"People enjoy having their letters delivered by Courier. Not only thanks to his attractive face and sunny disposition, but also because the letters he delivers have a faint fragrance about them. When the topic comes up, Courier will immediately change the subject. If pressed on it, he will hem and haw and his face will blush, a side of Courier very rarely seen."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"Courier rarely loses his signature faint smile, though it should be noted that he has another side - a calm, tranquil, and peaceful side characteristic of one from the snowlands. Only his enemies and his most trusted friends get the chance to see that side of him. If he loses his smile while talking to you, that can only mean one thing - he regards you as a dear friend."},{"section":"Promotion Record","unlock":"Unlocked at E2","description":"Most of the scars on Courier's body came from the people of Kjerag rather than beasts. After all, as an important man, SilverAsh has many enemies that want him dead. Courier always confronts these people in the dark. As for the fights with these rebels, only Courier's scars tell the tale - Courier himself says nary a word."}]},"appearances":[{"label":"Base","iconPath":"/four-star-icons/Courier%20-%20Base.webp","fullPath":"/four-star-skins/Courier%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/four-star-icons/Courier%20-%20Elite%202.webp","fullPath":"/four-star-skins/Courier%20-%20Elite%202.webp"},{"label":"New Routes","iconPath":"/four-star-icons/Courier%20-%20New%20Routes.webp","fullPath":"/four-star-skins/Courier%20-%20New%20Routes.webp"},{"label":"Speechless Sound","iconPath":"/four-star-icons/Courier%20-%20Speechless%20Sound.webp","fullPath":"/four-star-skins/Courier%20-%20Speechless%20Sound.webp"}],"skinObtainByLabel":{"New Routes":"15 OP","Speechless Sound":"15 OP"},"synergyMatches":[],"autoSynergyGroups":[{"name":"Kjerag","type":"faction","entries":[{"operatorName":"Gnosis","operatorIconPath":"/six-star-icons/Gnosis%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"Grants Resist to all [ Kjerag ] Operators after Gnosis has been deployed for 10 seconds","matchedKeyword":"Kjerag"}]},{"operatorName":"SilverAsh the Reignfrost","operatorIconPath":"/six-star-icons/SilverAsh%20the%20Reignfrost%20-%20Base.webp","isContributor":true,"badges":[{"label":"T2","skillIconPath":null,"talentLabel":"T2","sourceText":"When on field, all Kjerag Operators gain Frozen immunity, +80 (+20) DEF, and recover 2% (+0.5%) of Max HP every second; after being deployed for 15 seconds, DEF and HP recovery effects double","matchedKeyword":"Kjerag"}]},{"operatorName":"Degenbrecher","operatorIconPath":"/six-star-icons/Degenbrecher%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"Pramanix the Prerita","operatorIconPath":"/six-star-icons/Pramanix%20the%20Prerita%20-%20Base.webp","isContributor":false,"badges":[]},{"operatorName":"SilverAsh","operatorIconPath":"/six-star-icons/SilverAsh%20-%20Base.webp","