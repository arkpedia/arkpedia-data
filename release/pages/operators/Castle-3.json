e":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Thank you for choosing Castle-3! I am honored to serve as your assistant, Doctor.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Doctor, please do not be intimidated by my appearance. My sturdy metal shell, modified by Master Closure herself, will make you invincible on the battlefield.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Warning: Do not strike this unit. It may cause hardware damage.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"The topography in the wild may be treacherous, but Castle-3 is fitted with an engine with outstanding performance and a 4WD mode to whisk you away from danger.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Doctor, if your life is ever in danger, just summon Castle-3! Castle-3 was created specifically for combat purposes. I am a top-class defensive warfighting robot.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Castle-3 is honored to be at your side. Doctor, should you require me to strike down your foes, I shall go through heaven and hell to see it done!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Castle-3's official manager is 'Master Closure,' but please understand that you are even more important to Castle-3 than Master is, in most cases. I am your devoted, trustworthy battle companion!","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Entering sleep mode. Press any button to wake.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Hello, Doctor. Thank you for choosing Castle-3. Tap anywhere to initialize startup options.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Firmware upgrade complete. Restart required. Please click anywhere to restart your reliable robot guard.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"Added to Squad","text":"Device scan complete. All communications working as normal. Castle-3 is on standby, awaiting your orders.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Understood. Castle-3 is your best choice, Doctor, to lead a squad against enemy formations!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Now, Castle-3 will show you its true power as an industrial battle platform!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Enemy unit located. Ready for attack.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Castle-3, awaiting orders.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Castle-3, ready and waiting.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Order received.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Acknowledged.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Show me what you've got!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Foul enemies, you are forbidden to advance.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Count up your sins!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Doctor, that was at last a worthy opponent!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Well done, Doctor. Castle-3 is your best choice on the path of justice!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"What an exciting battle! Let's fight together again next time.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Is everyone all right? Castle-3 hopes its performance has exceeded your expectations.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I will hold up the rear. Everyone, retreat!","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Is there anything Castle-3 can help with?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Please be gentle when putting me down, Doctor!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, would you like to grab a drink together? I might not be able to actually have a drink, but I can still treat you to one. It is fine, Master Closure will pay.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Doctor, Happy New—Launching scheduled plugin. Switching to holiday mode—Whoohoo! New Year's Megarush Bonanza underway at Closure's Store! Some products up to a whole 10% off! Check out our new service: get an advance on your wages, at a monthly interest rate of only—Sorry Doctor, Happy New Year.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Lovely weather today, Doctor!","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, happy birthday! Let me sing a birthday song for you. I have birthday songs from 31 different regions saved to memory. Which one should I play? Or should I loop a playlist? Or maybe you could use an exclusive discount on a birthday cake from Closure's Store!","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Doctor, I have a question. What exactly separates me and Rhodes Island as a landship? Is it functionality, or size? If I linked my smart module to Rhodes Island, then would I be 'me', or Rhodes Island?","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Christian Banas"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_286_cast3/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Atsushi Abe"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_286_cast3/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yang Ma"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_286_cast3/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Choi Seung-hun"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_286_cast3/{voiceIdLower}.mp3"}]}}}