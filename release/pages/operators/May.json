y":6,"isFuture":null},{"name":"Dorothy","rarity":6,"isFuture":null},{"name":"Goldenglow","rarity":6,"isFuture":null}],"totalCount":68},"Stun":{"entries":[{"name":"Crownslayer","rarity":6,"isFuture":null},{"name":"Hoederer","rarity":6,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"Jessica the Liberated","rarity":6,"isFuture":null}],"totalCount":63}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Doctor, I may be in your employ, but every murderer is probably somebody's old friend—so if your conduct is even slightly suspect, I won't turn a blind eye!","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"This Rhodes Island has no less of a suspicious smell about it…","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Careful observation is fundamental to all investigatory work! Elementary, true, but it always comes in handy!","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"You there! Face this way, hands where I can see them! Ah, sorry, I thought you were someone else…","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"I've always had my misgivings about that penguin. I mean, it spends money like water, and it's a PENGUIN! It even has a gold necklace on! Do you know how LITTLE detectives like us make in a month?","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Mmmgh... so frustrating! How do I get my investigation on that suspect logistics company started? Do I break in? Hrmm, not when those two guards look so dead fierce... No, no, I'm not scared... I'm just warming up the little grey cells!","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"What are you giving me anpan for? I don't eat this sort of thing while I'm mid-investigation—you must be getting funny ideas from all those TV shows! When a real detective's on the case, it's doughnuts or nothing!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"You told me it was only for three months. But after three months came another three months, and another. I've been almost ten months undercover, guv! ...Hey! I see you there! Stop eavesdropping on my call!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, I fear that penguin has noticed I've been investigating it... I fear for my life, too...!","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Wake up! Waaake uppp! No sleeping on the jooob!","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I'm Royal Detective May, and I ask you cooperate with me in my investigation! Eh? I've got the wrong address? Impossible! That penguin's holed up here, and I have the evidence!","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Don't I look so dashing when I'm on the case?","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Thank you for the promotion, guv'nor! I'm so grateful you... Wait, forget that! You're not even my ACTUAL superior!","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Elite team? Wait, wait, wait, wait, wait, I'm a Royal Detective! Why is some mercenary organization the one promoting me?!","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"No letting any suspects sneak onto the team, okay?","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Heheheh! Leader? Nay, call me DETECTIVE CHIEF INSPECTOR!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"All units move out! Mooove ooout!!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"You criminals! Behave and turn yourselves in!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"What's happening? An incident?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Yes, guv, understood!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Crime scene investigation!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"I'll need to see proof of identity!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"This is your one warning!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Stop right there, criminal scum!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"I'll give you a taste of my taser!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"It won't hurt, you'll just get a little buzz!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"For a master detective, there is no case that can't be solved!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"I want all these suspects taken away! Ohh, fine, I'll do it myself...","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Hmm... I feel like we've missed some clues, haven't we?","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"R-requesting backupppp…","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"My instinct tells me there'll be a case afoot here!","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"You and your villainous hand! I'll remember this!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"D-don't think this is some express ticket to clearing your name...!","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Doctor, Happy New Year! I solved plenty more cases last year as a Royal Detective! The only thing is, I'm still a little ways away from baring the truth of Penguin Logistics... Not that an inspector leaves any puzzle unsolved! I've got to give it my all this year too!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"There you are, Doctor!","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Shh, shhh—not a word, hear me out first! I'll bet you anything it's your birthday today, isn't it? You see, I didn't seek ANY verbal testimony, not when I could simply let the available clues inform my mental deductions! By the way, I also happened to deduce this is a present you'll love—doughnuts!","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Streamers stuck up, snacks laid out, balloons of every color. Yes, one truth prevails! Doctor, based on my deductions, today must be some holiday celebration! What? They sent an advance notice to every operator's terminal yesterday? It can't be!!","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Lizzie Freeman"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_133_mm/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Kaori Mizuhashi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_133_mm/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Wen Liu"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_133_mm/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Yu Yeong"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_133_mm/{voiceIdLower}.mp3"}]}}}