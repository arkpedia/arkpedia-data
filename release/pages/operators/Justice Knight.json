me":"Suzuran","rarity":6,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null}],"totalCount":14}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Beep-Beep. Understood. Classification program initiated. Now sorting the Doctor's documents. Will you want any snacks during work? Justice Knight could pick some up for you from the cafeteria.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Ever since Closure and Mayer installed a human voice patch, Justice Knight's functionality as a smart assistant has gone right up! Being able to use natural language logic really has improved communication so much when helping out my masters.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Justice Knight's master, the Wild Mane Knight Iwona, found Justice Knight in a scrapped state. She rebooted and fixed this unit. Ever since then, Justice Knight've been in charge of her and her partners' everyday lives, as well as supporting them on missions.","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Doctor... why does my master say things to this unit like 'Justice, you're too noisy these days. Go play somewhere else if you've got nothing to do!'? Beep-Beep…Beep-Beep... Justice Knight doesn't understand.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Everyone in Pinus Sylvestris is incredibly hard-working, always putting meals off so they can train their knightly skills. There has to be a day where their bodies won't keep up. None of them have time to fetch their lunchboxes, so it's all up to Justice Knight to bring them over.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"A low battery? Sorry, this unit is not sure if any of my functions will be of help to you... What? it's the games console that's almost out? Please get this wire plugged in straight away!","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Beep-Beep. Doctor, you discovered Justice Knight's secret. Justice Knight has no other choice but to take firm action in order to protect the secret... Master? You'll allow Justice Knight to keep tending to the plants in the Convalescent Garden? Thank you, Doctor. You now have unlimited access to all services of Justice Knight!","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Beep-Beep, Beep-Beep. Apologies, Doctor. Justice Knight always forgets to disable the automatic timeteller feature.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Beep-Beep, Beep-Beep-Beep, Beep-Beep…Beep! ('Justice Knight,' glad to be reporting in along with everyone from Pinus Sylvestris Knightclub... Justice Knight will be of great use to you all!)","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"These are very useful resources for this unit. Justice Knight will apply to Miss Closure for installing even more new functions.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"Added to Squad","text":"Justice Knight, all ready and set!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Are you leaving command to Justice Knight? It might be a little challenging for this unit right now…","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Justice Knight, setting off!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Beep-Beep. Justice Knight will provide you all with proper and timely support!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Justice Knight, all good to go!","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Justice Knight, requesting to attack!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Beep-Beep. Locked onto target.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Beep-Beep. Justice Knight is now in position.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Juuuuustice!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Viiiiictory!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Fiiiiight!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Spiriiiiit!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Beep-Beep, BeepBeepBeep-- Sorry, Justice Knight got too worked up. Doctor, master, Justice Knight has made it!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Possiblilites of new function development detected! Justice Knight, awaiting for orders to return to Rhodes Island!","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"There is still room for improvement. Anyway, we won! Congratulations, Doctor!","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Please don't... throw Justice Knight... away again...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Beep-Beep, Justice Knight has plenty of things to do here.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Beep-Beep! Don't treat this unit like that… Negative!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"The washing machine... doesn't seem too hard to use...","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Doctor, can you see the countdown on the screen? Three... two... one... Happy New Year! This year, Justice Knight will focus all her heart on doing even more for you.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Nice to see you, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":" 'Beep-beep.' Doctor, your takeout is delivered... Yes, Justice Knight has brought you your birthday meal from the Rhodes Island Cafeteria. Scan of ingredients inside packaging: Inedible items, paraffin wax, Acid Originium Slug; edible items, butter, fermented flour. Scan results: safe.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Since the Pinus Sylvestris Knightclub joined Rhodes Island, their lifestyles have transformed. Accordingly, all of Justice Knight's functions are being upgraded to follow. Justice Knight will ensure that she remains a useful operation platform.","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Ina Marie Smith"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_4000_jnight/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Satsuki Yukino"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4000_jnight/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yannie Wang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4000_jnight/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Sun-hye"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_4000_jnight/{voiceIdLower}.mp3"}]}}}