ity":4,"isFuture":null},{"name":"Valarqvin","rarity":5,"isFuture":null},{"name":"Vanilla","rarity":3,"isFuture":null},{"name":"Varkáris","rarity":5,"isFuture":null},{"name":"Vendela","rarity":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Ummm... Nice to see you again, Doctor. It makes me happy... hehe...","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Doctor, do you need a break? I made you some tea, and Miss Orchid made cookies. Here, hope you like them… And, umm... Cheer up!","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Why is everyone in Team A6 always fighting with each other...? If things keep going like this, we can't be a team anymore... Fighting is bad. I must make them understand!","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"The gear on my chainsaw is kinda loose, the one that makes the 'vrrrr' sound ... But I don't remember using it lately. Weird...","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Doctor, is Team A6 getting along well...? That's really some good news. Peace is the best... As long as they don't fight, nothing will bother me while I stay with you…","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"I don't know why, but I sometimes get these gaps in my memory. Then when I ask my teammates in A6, they just smile and tell me nothing happened at all...","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Um, Doc-Doctor, did I just pass out...? Um, why is everyone lying on the floor? Miss Catapult? Mr. Midnight? Mr. Spot? Why do you all have bruises on your face? And Miss Orchid too...","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"I'm actually super strong? You say I lost control over my power, when I wanted to stop my friends from fighting each other? That's why I don't remember anything...? Okay, I think I get it! Umm... right, I will put my power to good use!","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Aaaah! The cup! I didn't control my grip... Errmm... I'm in trouble when the Doctor wakes up...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Popukar from Operation Reserve Team A6, reporting in. Um, my teammates in A6 are always arguing. I'm sure you worry about them, Doctor... But I know what to do...","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Umm, Doctor, is the girl in the video... me?","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"I'm so happy I don't even know what to say...! Thank you, Doctor...! Thank you so much!","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_017","title":"Added to Squad","text":"My name is Popukar... Nice to meet you...","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"B-But... I really don't know anything about tactics or strategies or anything…","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Miss Catapult, um, it's time to deploy!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Miss Orchid, don't worry... I'll be fine.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Errrmm...","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"I'm right here.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"I want to stop this fight.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Please stop arguiiing!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Be good and don't move.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Chainsaw got mad…","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"Mr. Midnight, come back here... Miss Orchid is staring at you…","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Can everyone have a good peaceful talk, now...?","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Doctor… Doctor…? Here, I made some tea. You must be tired.","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"**A painful groan** I'm… injured…? It hurts…","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Please don't leave me here alone...","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Aaaugh...","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, headpats…","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year, Doctor. I made some soft and chewy New Year's cakes at the cafeteria... They say my cakes are great. I'm strong, so I always pound the dough well! Hehe...","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Doctor, are you getting along with everyone today...?","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Happy birthday, Doctor. I never really celebrated birthdays before, but now that I'm at Rhodes Island, Orchid always lets me have extra snacks on them... Do you want any? I'll sneak some out for you. Others won't notice!","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Will we all stay together if I'm a good kid, if I'm a little smarter? I want A6 to stay together like a family... Will you help me, Doctor?","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Kayli Mills"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_281_popka/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Chiyo Ousaki"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_281_popka/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yee Chen"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_281_popka/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Ryu Jeom-hee"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_281_popka/{voiceIdLower}.mp3"}]}}}