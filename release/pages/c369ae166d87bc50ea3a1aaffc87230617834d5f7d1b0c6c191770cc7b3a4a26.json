rity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"ATK Down":{"entries":[{"name":"Reed the Flame Shadow","rarity":6,"isFuture":null},{"name":"Rose Salt","rarity":5,"isFuture":null},{"name":"Thorns the Lodestar","rarity":6,"isFuture":null},{"name":"Shamare","rarity":5,"isFuture":null}],"totalCount":5}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":2,"rows":1,"opCell":[1,1],"rangeCells":[[1,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"We've got more kitties! Yeah…","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Laterano cakes are so delicious! But we operators have to pay attention to our diet, right?... aww...","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Not my gloves... I'm sorry, I can't take my gloves off... I don't want you to see my hands. That's the one thing I ask... sorry…","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"A-Are we departing now? Al-Alright, let me just prepare one moment...!","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Do you think it's odd that I have two tails? Do-do-do I look even stranger than I thought? Umm...","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"When my symptoms aren't flaring up, my hand stays all normal... It feels so nice, just being able to hold the kitties like this...","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Doctor, what kind of cake do you prefer? Mango, or matcha? I tried making a few, and... you already ate? Oh, umm, Okay...","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"D-Doctor! Sora... sh-she's the super idol, Sora, isn't she?! I'd recognize her anywhere! I'm her biggest fan! Why is she here at Rhodes Island? And... and... can I ask her for an autograph?","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, have you heard of the Avenue des Champs-Élysées? Yes, I happened to be born there. I really wish I could go back and visit one day... what? Oh, no, I appreciate it, but I'm not lonely. I have you, after all! You're my family.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Aw... Doctor... why are you ignoring me...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Good day... p-please call me Mousse. And... and please don't stare at my hand so much...","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"This is a favor I'll never forget!","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Huh? Pro...promotion?! I-I'm not prepared for this...","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Doctor, I know there's a limit to what I can accomplish, so I swear... I'll do all that I'm able, as well as I'm able! It's... It's the only way I could ever repay you, Doctor...","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Yes, I'll do my best!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"This is in my hands! You can do this, Mousse!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"I essentially blend into the walls, so I'm a good choice for scouting...","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Scouting complete. Sending you enemy coordinates.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"I'm ready!","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Here!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"I'm not scared...!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"From now on, this is my battle...!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Yah!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"No, stay back!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"I can fight too!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"You-You'll regret this!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"It was a tough fight... but I stayed steady through it all...!","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Yay... Oh, oh, sorry, it's not that I like battles that much, but...","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"D-Did I drag us all down?","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I can... keep going...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"E-Excuse me... May I come in...?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Yah!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"D-Doctor... I really can't hold it in anymore... do we have a scratching post? Urghh...","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy new year, Doctor… Help yourself with the pastries there! I personally made some of them, and they go well with the tea I prepared. With my gloves on me though... they may not look as great as what I used to make. B-But should still taste good, I think!","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Hello, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, could you accept this felt doll? I made it with the fur those kittens left behind. It was a lot of fur for a small doll, so I tried a few times to get it right. Do you recognize it, Doctor? It's you... N-No? Aw…","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Sora just gave me more of her albums, and they also came with her signature on them! How nice of her! She also gave me this little heart-shaped doodle on my gloves, saying these are the coolest gloves she's ever seen, and that I looked really special with them. Doctor, I'm thinking, maybe... I'm not as weird as I thought?","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Angel Lin"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_185_frncat/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Natsumi Takamori"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_185_frncat/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yuqi Zhang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_185_frncat/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Jo Kyoung-I"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_185_frncat/{voiceIdLower}.mp3"}]}}}