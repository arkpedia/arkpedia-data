ll},{"name":"Lappland the Decadenza","rarity":6,"isFuture":null}],"totalCount":19},"Stun":{"entries":[{"name":"Crownslayer","rarity":6,"isFuture":null},{"name":"Hoederer","rarity":6,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"Jessica the Liberated","rarity":6,"isFuture":null}],"totalCount":63},"Invisibility":{"entries":[{"name":"Crownslayer","rarity":6,"isFuture":null},{"name":"Ines","rarity":6,"isFuture":null},{"name":"Magallan","rarity":6,"isFuture":null},{"name":"Firewatch","rarity":5,"isFuture":null}],"totalCount":5}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[1,1],[1,2],[1,3],[2,1],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Umm, excuse me… I've been waiting here... for two hours…","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Sorry… I know people keep ignoring me... But... my Arts aren't to blame…","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"My Arts... make me undetectable to people... in certain environments…","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"I… I've never had any friends... S-surely no one wants a friend that…  they can't even notice… right?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"My tail... It curls up when I'm not fighting... So please, don't be afraid…","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Doctor... you can leave the dangerous work to me... After all... my Arts were made for that…","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"These ID tags around my neck… I collected them... I like holding onto evidence... that someone once existed...","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Don't let that 'Nightmare' girl near me!... She's dangerous... My Arts don't work on her... Why…?","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"I… I really want to cure my Oripathy. But if it's cured... what's going to happen to my Arts?... If they're gone, will I... still be of any use...?","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Doctor's ignoring me… I don't like it, hmph...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I'm Manticore... My Arts can take out lives silently... Please don't be scared, you're not my target…","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Thank you... I-I'm looking forward to you teaching me... more...","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Finally, I got a promotion... I always thought I wasn't good enough… so you didn't promote me…","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Did I... manage to help you? I don't have anywhere else to go... My home is here... at Rhodes Island... So please, let me protect it with you...","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"Okay...","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Nobody will like me... as their captain...","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Please don't leave me behind…","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Please choose tactics that make use of my Arts... even if it's something crafty and underhanded... I won't mind...","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"I-I'm ready...","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"I'm…right here…","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Manticore… going dark…","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Ready... to ambush...","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"That must... really hurt…","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Please, Don't come close…","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"I don't like this... either...","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Farewell…","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Even in such terrible battles… your judgement and decisions didn't seem to waver… You're incredible, Doctor…","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"A victory by all means... Still...","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"I can handle the runaways... if you wish...","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"I'm sorry... It's all my fault...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"I'll sit... in the corner...","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Eeeeeek!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Thank you for paying attention to me... I know it's your job... but it still makes me happy…","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year... More people have  noticed me... in the last year... I'm a little scared, but... a lot of them are very warm, and kind... So, I'm going to try as hard as I can... to adapt...","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Hello... Doctor...","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"I'll just put the present on the table and leave... Doctor, happy birthday... Eek! Did-did you notice me...? Um, Happy birthday to you... Doctor.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"I don't want to go through the experience... of losing a friend again... I will defend everyone, with my own life. Even if it's somewhere none of them will see me...","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Haviland Stillwell"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_215_mantic/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Ayaka Suwa"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_215_mantic/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Kousou Mao"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_215_mantic/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Bo-young"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_215_mantic/{voiceIdLower}.mp3"}]}}}