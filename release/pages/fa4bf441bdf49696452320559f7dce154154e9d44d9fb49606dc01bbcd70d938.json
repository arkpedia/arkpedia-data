rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Overload / Charged":{"entries":[{"name":"Horn","rarity":6,"isFuture":null},{"name":"Carnelian","rarity":6,"isFuture":null},{"name":"Ch'en the Holungday","rarity":6,"isFuture":null},{"name":"Gnosis","rarity":6,"isFuture":null}],"totalCount":12},"Slow":{"entries":[{"name":"Suzuran","rarity":6,"isFuture":null},{"name":"Bellone","rarity":6,"isFuture":null},{"name":"Dorothy","rarity":6,"isFuture":null},{"name":"Goldenglow","rarity":6,"isFuture":null}],"totalCount":68}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"还有七小时五十九分钟，没事没事，别紧张，自然点，坚持住……欸？博士，请讲！要我放轻松？我很轻松啊哈哈哈。我经常和上级共处一室的，他们都夸我办事利、利索，真的。","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"您说投诉信？干员向同事表白的信息意外发给了已婚人士？医疗部通知开会结果来了十头驮兽？！是上次信号调试的时候——需、需要罚多少款？一块小蛋糕和一些解释？呜……谢谢。","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"您真的不用我帮您泡咖啡？也不准备骂我？不，我暂时没有犯错——那您是准备开除我了吗……以前那是别人欺负我，我当然知道。我只是以为哪里都一样。我们可以和他们不一样，对吗？","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"博士，您能不能帮忙看看这些调查问卷？已经收上来两小时了，我还是不敢——等等！我还没准备好接受他们说我的设计是毫无价值的……反馈良好？还给了温柔的建议？我看看！","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"晋升后交谈1","text":"这张照片是我爬塔时被人拍到的，后来被登在报上，还好没人发现是我……其实回想起来还是有点后怕，我恐高——但想到这辈子可能都不会再去那么高的地方，我还是把它剪下来留着了。","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"晋升后交谈2","text":"零号公路的通讯塔运行得很顺利，但没给我的生活带来多少改变。不甘心？这次旅程的收获比名声更重要。嘉辛塔、安洁莉娜，还有您……有了大家的信任，我会把通讯塔架设到更远的地方。","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"信赖提升后交谈1","text":"没、没什么好看的！只是一些还不成形的构想……我从前以为连通整条零号公路的通讯是异想天开，但现在，我猜我有资格幻想更多了。具体是什么？等实现的那一天，您会知道的。嘿嘿。","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"离家这几年我到处漂泊，家里的信总是漂了几年都到不了我手里。就算知道无可奈何，内心的失落也很难消解。现在想来，我对通讯技术着迷，就是因为一次次对回信的期待都落空了吧……","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"我与安洁莉娜她们的友情，是从一个谎言开始的。她们为我考虑不想旧事重提，可我知道自己不该忘记。愧疚感不总是负面情绪，它让我学会珍惜真正重要的人——那些让四处漂泊的我不再孤单的人。","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"是看剧、听歌，还是拼模型……再不决定，珍贵的休息时间就要结束了啦——","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"博士好！我是新来的通讯技术工程师，参与过的项目有雷姆必拓的远程通讯网络设计，哥、哥伦比亚的源石电磁、那个、啊——在家背得好好的，完蛋了——","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"战场居然比想象中复杂那么多，回去要把参数全部重新设置一遍……今晚别想睡了！","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"精英化晋升1","text":"技术先锋、勤劳肯学……博士，您能不能把这些表扬的话写在晋升纪念照背后？我想寄回家里，嘿嘿。","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"精英化晋升2","text":"我下阶段的目标，是思考我做的事情的实际意义，不过分关注他人的评价。对了，博士您刚才准备说我什么呀……好好奇啊——","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"编入队伍","text":"技术终归是要走出实验室的，我……接受验证。","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"我会确保信号通畅——不会辜负大家的信任！","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"发射器接收器通讯器，请保佑我一切顺利——求求了！","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"各位好，本次技术升级由我来演示。请……多多包涵。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"信号接收良好，完毕。","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"我不紧张……","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"能落地的才是好设计。","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"能应用的才是好技术。","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"对不起对不起，下次我一定做得更好！","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"超导电磁发射技术，辛苦体验一下！","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"源石信号切割技术，麻烦感受一下！","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"……您就是那个不断挑刺的家伙吧？现在您满意了吗？满意了吗！","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"呜哇——您知道这个实验结果我等了多少天嘛！拜仪器真的有用啊！","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"刚才真的好紧张！希望接下来的工作也能这样圆满地完成……","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"博士辛苦了，谢谢您今天的指导。刚才那些错漏的数据就留给我处理吧。","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"本组数据不可用，记录完毕，准备重启实验。意外地冷静？我吗？也没有啦，所谓的好心态是被无数次失败锻炼出来的。","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"我会尽量小心调试，如果出现信号波动、设备乱飞、小范围冒火花……请务必先和我沟通，不要投诉，拜托了——","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"啊，您是在和我开玩笑吗？对不起没反应过来——下次我会配合的！","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"这是……我的一个小发明，不介意的话请拿去试用。我会来收集反馈的……您不嫌烦的话。","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"月末总结季末总结年终总结都凑一块儿了……博士也是？那……我们把笔放下，伸展四肢让身体与地面平行，放松眼轮匝肌，呵——啊，一年就这么一天，放纵一下吧……","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"博士……","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"博士，生日快乐。这个——不是小飞虫，是外形经过改良的信号发射器。希望能在您外出工作的时候帮得上……呃呃啊啊等等，被羽兽叼走了——对不起对不起，我马上给您重做一个！","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"从我出生以来，好像人生中每一次向前迈步，不是形势所迫，就是因为倒霉。但我也差不多该长大了，对吗？下一步，无论如何选择，我都会从容地、坚定地、像大人一样地向前走。","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["藤泽玲香"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4236_tmslot/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["赵爽"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4236_tmslot/{voiceIdLower}.mp3"}]}}}