 enemy and additionally deals 110% of ATK as physical damage and 50% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":15,"spCost":51,"duration":30},{"level":6,"mastery":null,"description":"Attack range expands ; each attack targets 1 more enemy and additionally deals 115% of ATK as physical damage and 50% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":15,"spCost":50,"duration":30},{"level":7,"mastery":null,"description":"Attack range expands ; each attack targets 1 more enemy and additionally deals 120% of ATK as physical damage and 60% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":25,"spCost":49,"duration":30},{"level":null,"mastery":1,"description":"Attack range expands ; each attack targets 1 more enemy and additionally deals 130% of ATK as physical damage and 60% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":25,"spCost":47,"duration":30},{"level":null,"mastery":2,"description":"Attack range expands ; each attack targets 1 more enemy and additionally deals 140% of ATK as physical damage and 60% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":25,"spCost":46,"duration":30},{"level":null,"mastery":3,"description":"Attack range expands ; each attack targets 1 more enemy and additionally deals 150% of ATK as physical damage and 65% of ATK as Corrosion ; enemies within Botani's range has their Corrosion cooldown recovery rate increased by 25%","initialSp":25,"spCost":45,"duration":30}],"recommendation":[],"cost":{"m1":[{"name":"Skill Summary - 3","quantity":5},{"name":"Chiral Refractor","quantity":3},{"name":"Aggregate Cyclicene","quantity":3}],"m2":[{"name":"Skill Summary - 3","quantity":6},{"name":"Orirock Concentration","quantity":6},{"name":"Solidified Fiber Board","quantity":3}],"m3":[{"name":"Skill Summary - 3","quantity":10},{"name":"Polymerization Preparation","quantity":4},{"name":"Cyclicene Prefab","quantity":4}]},"pairings":[],"techniques":[]}],"skillCost":{"2":[{"name":"Skill Summary - 1","quantity":4}],"3":[{"name":"Skill Summary - 1","quantity":4},{"name":"Polyketon","quantity":5}],"4":[{"name":"Skill Summary - 2","quantity":6},{"name":"Device","quantity":2}],"5":[{"name":"Skill Summary - 2","quantity":6},{"name":"Orirock Cube","quantity":8}],"6":[{"name":"Skill Summary - 2","quantity":6},{"name":"Loxic Kohl","quantity":4}],"7":[{"name":"Skill Summary - 3","quantity":6},{"name":"Crystalline Component","quantity":3},{"name":"Transmuted Salt","quantity":2}]}},"baseSkills":[],"modules":[{"type":"Original","name":"Botani's Badge","stages":[]},{"type":"Upgrade","name":"RIT-X: Yesterday, Today, Tomorrow","mission":{"requirement1":"Deal a total of 60,000 damage with your own Botani","requirement2":"Clear Main Theme 16-8 with a 3-star rating; You must deploy your own Botani, and have her use Echoes of the Quiet Realm at least once"},"stages":[{"stage":"Stage 1","attributesIncreased":"HP +95 , ATK +24","effectLabel":"New trait","effectText":"Elemental Injury dealt to Elite and Leader enemies increases by 18%","cost":[{"name":"Module Data Block","quantity":2},{"name":"Cyclicene Prefab","quantity":3},{"name":"LMD","quantity":40000}]},{"stage":"Stage 2","attributesIncreased":"ATK +30 , DEF +27","effectLabel":"Breaking the Silence improved","effectText":"Every enemy inflicted with Corrosion increases Botani's ASPD by +7 (Maximum 3 stacks)","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Stick","quantity":20},{"name":"Oriron Block","quantity":4},{"name":"LMD","quantity":50000}]},{"stage":"Stage 3","attributesIncreased":"ATK +35 , DEF +30","effectLabel":"Breaking the Silence improved","effectText":"Every enemy inflicted with Corrosion increases Botani's ASPD by +7 (Maximum 4 stacks)","cost":[{"name":"Module Data Block","quantity":2},{"name":"Data Supplement Instrument","quantity":8},{"name":"Refined Solvent","quantity":5},{"name":"LMD","quantity":60000}]}]}],"review":{"official":"伯塔尼，原名季申娜·维克托罗夫娜·别利亚耶娃，曾就读于圣骏堡的帝国理工大学，肄业，经凛冬干员介绍加入罗德岛，继续学习和研究源石通讯技术，并参与外勤任务。","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":50,"base":{"hp":423,"atk":207,"def":50,"res":5,"redeploy":80,"dp":15,"block":1,"interval":1.6},"max":{"hp":623,"atk":297,"def":72,"res":5,"redeploy":80,"dp":15,"block":1,"interval":1.6},"rangeId":"y-2"},{"elite":1,"minLevel":1,"maxLevel":70,"base":{"hp":623,"atk":297,"def":72,"res":10,"redeploy":80,"dp":17,"block":1,"interval":1.6},"max":{"hp":842,"atk":382,"def":95,"res":10,"redeploy":80,"dp":17,"block":1,"interval":1.6},"rangeId":"y-2"},{"elite":2,"minLevel":1,"maxLevel":80,"base":{"hp":842,"atk":382,"def":95,"res":15,"redeploy":80,"dp":17,"block":1,"interval":1.6},"max":{"hp":1080,"atk":461,"def":108,"res":15,"redeploy":80,"dp":17,"block":1,"interval":1.6},"rangeId":"y-2"}],"trust":{"hp":240,"atk":40,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"造影检测结果显示，该干员体内脏器轮廓清晰，未见异常阴影，循环系统内源石颗粒检测未见异常，无矿石病感染迹象，现阶段可确认为非矿石病感染者。\n\n【体细胞与源石融合率】0%\n干员伯塔尼没有被源石感染的迹象。\n\n【血液源石结晶密度】0.11u/L\n干员伯塔尼具备较强的矿石病防护意识。\n\n干员伯塔尼曾自行“改造”右侧犄角，嵌入金属天线以提升自身接收通讯信号的能力。经医疗部检测分析，该行为未对神经系统造成损害，但连接处的缺损和金属材料带来的颈椎健康隐患，仍是后续需要关注的重点。"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"季申娜·维克托罗夫娜·别利亚耶娃不是伯塔尼所使用的第一个名字，却是目前陪伴她最久的一个名字。\n那被粘贴在墙壁上的奖状，镶嵌在宝石相框里的发黄的照片，还有一厚沓违规处罚决定书，都忠实地记录着季申娜曾经历的那些重要时刻。\n在很长一段时间里，季申娜都以为，自己是因为足够幸运才考上了位于圣骏堡的帝国理工大学，并从女大公叶莉萨维塔手里领到了那一大笔丰厚的奖学金。事后女大公曾派人来邀请她进入那栋肃穆的楼宇，可令她不解的是，自己最后只是站在那里，远远看着女大公和几位幕僚交谈，她在温暖的炉火旁等了一个小时，但女大公从始至终都没看过她一眼。等她走出那栋楼时，才发觉外面原来这么冷。\n帝国理工大学并不如季申娜想象中那般美好。这是久负盛名的“贵胄花园”，达官贵人们将自己难以管教的子女送进这座富丽堂皇的学校住上几年，便能让他们摇身一变成为“高级知识分子”。但这样的地方，注定没有来自布列斯克的平民埃拉菲亚的位置。甚至于，在这所学校里想找出几个不是乌萨斯的学生都很困难。季申娜常在深夜被同学锁在寝室外，或是在清晨四处寻找自己“神秘失踪”的鞋子和围巾。\n为了减少麻烦，季申娜干脆在全天开放的图书馆找了个储藏间住进去。这为她博来了“书呆子”的外号，但也让她终于拥有了一片清净之地。她曾在图书馆里翻到一本写着“科谢尼娅·马尔科芙娜·涅留朵娃”名字的笔记，那似乎是一位非乌萨斯学生写下的生存指南。尽管时过境迁，笔记上的一些地点和人名都已发生变化乃至消失，但季申娜还是从中汲取到了自己所需要的勇气。书本是更称职的老师，她照着专业教科书中的指引，制作出了自己一直想要的通讯装置，她甚至还改造了自己的犄角，只为能听见更远处传来的讯号......\n然后，在那个晚上，一切都改变了。\n来自远北的怒吼和悲嚎将她淹没，她试图将自己听到的一切告诉别人，却发现自己根本没有发出声音的能力。无法发声，就无法催生改变。她听着远北传来的声音，感受到雪花割破肌肤的痛感，也终于想清楚为什么那天女大公召见了她，却又将她晾在一边。\n多么简单的道理，和自己能考上这座贵族专属院校的原因一样——女大公需要她这样的寒门贵子，来彰显自己的仁治与慈爱。而她需要做的，只是被看见，被街道上围观的人们看见自己走进女大公的楼宇，并在那里待上一个多小时。然后民众们便会说，看哪，我们的女大公是多么仁慈亲和。原来她自以为的努力和幸运的结果，不过是一场被安排好的政治表演。\n那晚过后，季申娜的名字开始频繁出现在学校的各项处罚决定书上，而“伯塔尼”这个最初被用来取笑她的外号，却开始在那些试图为远北的不幸发声的学生们中间流传。"},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"在许多事情都告一段落之后，伯塔尼终于在罗德岛见到了Mantra和Raidian，并如愿收获了一支由Raidian亲笔签名的麦克风。在得知Mantra小队的干员有时会公开讲解如何高效使用远距通信的源石技艺后，伯塔尼空闲时就常待在工程部的分享室，希望能碰上几场分享会。\n\n其实从那些分享会上我收获了很多。大家好像彼此都不太熟悉，互相离得远远地坐着。我不太擅长记忆人脸，所以一开始对着面生的同事也不敢贸然上前打招呼，我甚至无法判断对方是“讲师”还是“学生”。\n不过幸好，这样尴尬的状况没持续多久。某天我刚修理完头顶的天线，讲师们便主动来考我。不得不说，那些问题还真的挺有难度，有的我答不上来，讲师们也会流露出失望的神色——从那以后，我常常在宿舍熬夜钻研，尽量跟上他们的节奏。我应该......表现得还可以，也确实受益于这种独特的教学方式，我学到了很多新知识。\n如果说有什么让人意外的，那就是我发现讲师人数好像远远大于前去听分享会的学生的人数，而且不知道为什么，讲师们都总是揪着我提问。\n——干员伯塔尼\n\n我也去了工程部的分享室，我原本以为Mantra小队前辈们的不定期分享会只是个传说，没想到居然是真的！\n伯塔尼前辈好像不太喜欢说话，所以前两次分享会我们都只是尴尬地坐着，谁也不敢上前提问。直到那天，她头上的天线忽然摇晃起来，我知道那其实是在催促我们提问呢，于是就壮着胆子上前去了！\n伯塔尼前辈的乌萨斯口音给我留下了很深的印象，她讲话不疾不徐，十分有条理。有时候我问了不严谨的问题，她就会立刻停下来，让我先自己思考，我只好回到宿舍熬夜钻研，第二天她才会将正确的答案告诉我。就这样，短短几周，我和其他几个刚刚加入工程部的新人干员都觉得自己的技术水平和理论水平有了很大的进步。我们还联名写了表扬信寄给Mantra前辈，谢谢她和她小队的干员对我们的帮助！\n——某工程部干员\n\n啊，我还说为什么每次办分享会都没人来听呢，原来大家都去了分享室——我可是一直在茶水间等着大家啊！\n在茶水间讨论学术问题不一直是工程部的风格吗？难道是我搞错了？\n算了，不要紧。先把这封感谢信藏好，可别被队长发现了......什么叫信是队长让你转交给我的？她已经知道了？！\n——干员极境"},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"季申娜·维克托罗夫娜·别利亚耶娃是伯塔尼目前使用时间最长的名字，却不是她的第一个名字。\n她的第一个名字来自萨米的冰凇和泉水，她说，那个名字无法以其他任何语言翻译。那是姐姐给她起的名字。\n说起“姐姐”这个词时，伯塔尼的眼神突然变得暗淡。\n姐姐和她完全不像，甚至也不像她们的母亲。某天姐姐说要带她去看冰泉，却将她独自留在了覆雪的林地中。她一遍遍呼唤着姐姐的名字，恐惧地在地上掘出浅浅的土坑，试图将自己藏起来......她不知道自己在黑暗的密林里待了多久，记忆似乎从那里断开了。后来某一次围坐在火堆旁时，姐姐对妹妹说，其实姐姐当时就在不远处看着她。“那你为什么不回应我？”她向姐姐发问。姐姐说，因为她发音不准，始终没能叫对姐姐的名字。她记得自己曾看向姐姐的眼睛，却只看到了“失望”。\n\n那次被落在密林里之后，姐姐给了我一个对讲机，是她自己做的。她教会我如何调到一个特殊的频道，如何对着它喊话，又如何接收回应。\n那时的我太过年幼，无法理解姐姐在做的事；妈妈也许有所察觉，但她从不愿意向我提起。\n我还记得我们搬家离开萨米那天，走着走着，姐姐突然停下了。她说：“就到这里吧。”\n她说的依然是萨米语，她说她只能送我和妈妈到这里了。我想要和她一起走，可她不愿意，她说我已经有了乌萨斯语的名字，就不能再和她一起回去。妈妈一言不发，只是流泪。\n我记得那时，我手里拿着姐姐给我的对讲机，我想起来之前每次我找不到她，只要在那个频道里喊她的名字，她就会及时出现，并告诉我，我又把哪个音念错了。\n于是我打开了对讲机，却突然不知道该喊些什么——我竟然完全想不起来她的萨米语名字了，仿佛关于萨米的一切信息都在飞速地从我脑海中消失。慌乱中，我喊出了那个从那时起将要陪伴我很多年的乌萨斯语名字。\n姐姐没有停下，她消失在了雪地里。也许，当时我用正确的发音喊出了正确的名字，她就会留下？我不知道。\n之后我弄丢了那个对讲机，也许是妈妈故意扔掉的。我一直想再得到一个。\n——某次心理诊疗中的自述录音，干员伯塔尼已同意人事部调用这份录音文件"},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"“卡托加事件”过后，罗德岛陆陆续续接收了很多事件亲历者，试图帮助他们走出心理上的困境。\n而最终成为罗德岛干员的那些人中，伯塔尼是表现得最为配合的一个，也是最早同意使用“真实情境暴露式创伤记录自我诊疗仪·β型”并与医疗部同步诊疗记录的一个。\n说实话，她这种“无所谓”的表现相当反常——这是医疗部对伯塔尼的初步判断。\n\n【语音记录】\n（电子杂音）\n......吗？嗯，好像又有电磁干扰。刚才说的那些内容应该都录制上了吧？\n坏消息是，我没找到停止录制并保存的按钮，也不敢随便拆解这台机器。但好消息是，电量还有2%，它没电关机前应该会自动保存......的吧？那就再说一会儿好了。我是怎么被关进封锁区，怎么和索尼娅她们一起逃出来的，都原原本本地告诉你们了。剩下的，还有什么可以说的呢？\n难道真的要讲讲，我是怎么在衣柜里躲了两三天，用只有自己能听见的声音向外求救吗？不......又或者要讲讲......我是怎么夺走别人的生命的......\n（沉重的呼吸声）\n不......不。\n我不是......故意的。至少，杀第一个人的时候，不是。他当时......挥着刀，好像感觉不到痛一样。\n我只是想......活下去。我不想再躲在那个衣柜里，那个衣柜的门板背面，全是带血的抓痕......在我躲进去前，就已经有人死在那里了。\n没人能听见我，我做的一切都没有用......卡托加区，是一具......给活人的棺材。\n（剧烈的干呕声）\n......对不起。\n我该怎么，删除这段录音？\n人们在死去......我为什么还在这里自言自语？\n不，不该这样——\n（录音中断）\n\n这份录音文件是由伯塔尼主动递交的，她承认自己没能控制好情绪，导致了“真实情境暴露式创伤记录自我诊疗仪·β型”的意外损毁，她只能从存储装置中提取出幸存的部分录音。\n和录音文件一起提交的还有一柄折断的匕首。伯塔尼说，这是她从那个藏身的衣柜里带出来的，她不清楚这柄匕首曾属于谁，是否是用来自保的武器，也不愿去猜想那个人最后结局如何。当时她带走这柄折断的匕首只是出于一种朦胧的责任感，带着这份“责任”，她活了下来，却始终不敢回头去看。她的原话是“就像落枕一样，一旦回过头去，会很痛，很痛，但总会不痛的，只是时间问题。现在我的时间到了，我感觉自己可以放下它了。不过......我不知道该交给谁，你们愿意收下吗？”\n\n对了，我想了解一下“真实情境暴露式创伤记录自我诊疗仪·β型”的知识产权问题。我曾试图修好它，但最终没能成功。现在我仿照它的核心结构制作了一些小型录音装置，我想问问这种情况我需要向可露希尔小姐支付专利使用费吗？请放心，我只会用它们来录制日记。之前的诊疗中，我还挺适应这种自我谈话的。至少我在发出声音，至少我能听见。\n——干员伯塔尼"},{"section":"Promotion Record","unlock":"Unlocked at E2","description":"季申娜，我的孩子，愿你收到这封信时一切都好。\n谢谢你将你的新地址和近况告诉我，这令我惊惧不已的心宽慰不少。\n家里没什么好担忧的，布列斯克的天气总是这样，但在这里我起码还能收到你的信，还能以合理的价格买到面粉和蔬菜，不是吗？至于你说的搬家，我考虑过，孩子，我真的考虑了很久。但很抱歉，我现在的地址是你姐姐仅有的关于我们俩的信息，我总是盼望着我的两个孩子都能平平安安地走进家门......季申娜，你会原谅妈妈吗？\n你所说的罗德岛，我最近也和他们接触过了。他们人很好，只是个个都板着一副面孔，为了不被人怀疑，他们还特意换上了什么“第三局”的制服，真是辛苦他们了。他们每周都会来拜访我，给我带来一些食物和布料，顺便替你取走你留下的一些旧物件，上次他们来，还把你寄回的信件也带走了，说是为了保密必须销毁掉。虽然不知道你为什么要请他们把小时候从萨米带过来的玩具都寄去罗德岛......也许你还留着一些那里的记忆吧。对了，那些人还问我，你最近有没有跟你的老朋友联络过。可我又怎么知道呢？他们还特意写下了那位朋友的名字，好像怕我耳聋听不清一样，真是贴心。\n说到这里，季申娜，你是什么时候认识那位“费佳”小伙的？他人怎么样？你怎么从来没和我提起过？\n迫切想要知道更多你和“老朋友”之间故事的妈妈"}]},"appearances":[{"label":"Base","iconPath":"/five-star-icons/Botani%20-%20Base.webp","fullPath":"/five-star-skins/Botani%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/five-star-icons/Botani%20-%20Elite%202.webp","fullPath":"/five-star-skins/Botani%20-%20Elite%202.webp"}],"skinObtainByLabel":{},"synergyMatches":[],"autoSynergyGroups":[{"name":"Supporter","type":"class","entries":[{"operatorName":"Suzuran","operatorIconPath":"/six-star-icons/Suzuran%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When deployed, increases the SP recovery rate of all Supporters by +0.4/second (only the highest effect of this type takes place)","matchedKeyword":"Supporter"}]},{"operatorName":"Breeze","operatorIconPath":"/five-star-icons/Breeze%20-%20Base.webp","isContributor":true,"badges":[{"label":"T1","skillIconPath":null,"talentLabel":"T1","sourceText":"When this unit's skill is active, all Medic and Supporter Operators gain status resistance","matchedKeyword":"Supporter"}]},{"operatorName":"Matsukiri","operatorIconPath":"/five-star-icons/Matsukiri%20-%20Base.webp","isContributor":true,"badges":[{"label":"Match of Myriad Tricks","skillIconPath":"/skill-icons/Matsukiri%20-%20Match%20of%20Myriad%20Tricks.webp","talentLabel":null,"sourceText":"Gradually generates 15 DP, ATK +70% , recovers HP by 10% of Max HP per second; DP cost of all Defender and Supporter Op