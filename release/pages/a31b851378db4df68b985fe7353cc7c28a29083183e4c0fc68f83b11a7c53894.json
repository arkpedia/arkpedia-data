chniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":{"2":{"skillName":"Echoes of the Quiet Realm","baseRangeId":"y-2","baseRange":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[2,1],[2,3],[2,4],[1,1],[1,2],[1,3],[1,4]]},"levelRangeIds":["y-7","y-7","y-7","y-7","y-7","y-7","y-7","y-7","y-7","y-7"],"grids":{"y-7":{"cols":5,"rows":3,"opCell":[2,2],"rangeCells":[[3,1],[3,2],[3,3],[3,4],[3,5],[2,1],[2,3],[2,4],[2,5],[1,1],[1,2],[1,3],[1,4],[1,5]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,1],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"一走进这间办公室，我的耳机里就传来奇怪的杂音……博士，是您的音响连接错设备了吗？啊，原来是防监听系统在运作？真抱歉，我这就关掉身上的装置。","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"外面好像又刮风了。小时候住在布列斯克，总担心夜里起大风，风会灌进来扑灭炉火。有很多年，我常在梦中被远北的风声吵醒——现在还会吗？当然不，我现在又没睡着。嗯？不是这个意思？","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"不明白的地方？没有，文件写得很清楚。看起来很困惑？啊，因为我的两只角重量不太平衡，头歪一点会没那么累。您对我改装的天线感兴趣吗？我可以把设计图——啊，不，其实不疼的。","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"我注意到您常常陷入深思，真令人羡慕。我的思绪总是太浅，因此经常后知后觉。比如？比如听见远北消息的那晚我才想通，我能考入帝国理工大学，不过是那位女大公的政绩需要，多讽刺呀。","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"晋升后交谈1","text":"城市里的人以为自己可以将矿区的惨剧挡在门外，但他们错了。城市不是他们的，甚至连门板也不属于他们。我离开了布列洁诺伊，又离开了圣骏堡，可我依然听得到那追在身后的脚步声。","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"晋升后交谈2","text":"来到这里后，我见到了Mantra女士，也终于找到了那个声音。她，还有Raidian女士，都是很了不起的人。您说笑了，我不是来求签名的。不过真能签名的话，我有几支珍藏的麦克风——","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"信赖提升后交谈1","text":"起初我只是在大学的学生会电台里负责播诵每日格言，某天我没来得及准备，就念了自己写的文章。后来事情意外传了出去，有个学生气愤地找上门，要求我也念一念他写的。对，就是拉列亚。","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"开始记录。今天还剩下许多文书工作，预定的远距离通联测试要再次推迟——嗯？在叫我吗？只是在录制我的日记，您不介意的话我就继续了。希望明天录音的时候不要再被打断了。结束。","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"被关进封锁区后，我一直试图向外界呼救，但我能触及的只有静默。我每天都因为这样的“失声”而焦虑到呕吐，结果其实我身边有个人一直能听见，费佳那家伙——呃，不，该怎么称呼他？","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"您需要的话，我可以播放一些舒缓助眠的音乐。没关系，我戴上耳机就听不到了，不用担心。","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"博士，我记得您，罗德岛加密信号里那个高频出现的特殊波形。您叫我伯塔尼就好，我习惯了别人这样叫我。“书呆子”，我将它理解为一种夸奖。","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"画面有点看不清——欸，凑近后屏幕上的雪花点更多了！设备信号干扰吗？稍等，我把身上的装置都关掉，只要十几分钟就好。","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"精英化晋升1","text":"对我所做之事的表彰？谢谢您。我曾在大学的阁楼角落里捕捉到罗德岛的表彰简讯，当时的我不可能想到，有一天我也会获得这样的嘉奖。","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"精英化晋升2","text":"谢谢您的肯定，即便我觉得自己配不上这样的荣誉。同样的勋章，戴在不同人的身上就有不一样的分量。我要向Mantra女士和其他同伴学习的还有很多。","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"编入队伍","text":"作战通讯频道已接入，现在开始进行测试。","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"这里是伯塔尼，现在开始核对时间码。","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"全员，保持静默，我们出发。","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"目标已出现。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"正在守听。","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"等待应答。","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"坐标已同步。","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"伯塔尼已就绪。","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"去听，远北的风就在身后！","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"去看，火炬就在你的手上！","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"去思考，我们为何相互争斗！","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"去嘶喊，让所有人都能听到！","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"静默解除，现在我们可以欢呼了。博士，这是值得庆贺的胜利。伯塔尼结束。","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"做得不错，博士。伯塔尼结束。","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"伯塔尼结束。","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"呼叫所有人，呼叫所有人，请仔细听我的声音，我会带着大家撤离。","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"机械运转的轻微底噪……令人安心的氛围。","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"欸，您也听到什么了吗？","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"不可以摸那只角哦。它不会电到您，只是碰到它的话，我的脑子里就会响起很吵的杂音——啊，您信了。","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"不知道为什么，总觉得这里的新年灯光比圣骏堡的更温暖，风也柔和得多。看那边，有些干员已经开始跳舞了……您也想试一试吗？嗯，我刚好收听到一支曲子，您或许会喜欢。","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"博士，今天的状态如何？简报已经放在桌上了，要我念给您听吗？那么，现在播报今日新闻——","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"博士，快戴上我的耳机。你有听到奇怪的嘀嘀声吗？可不可以帮我记录下来？谢谢你！欸，好像是某种信息码，如果逐个翻译过来——没错！是“祝你生日快乐！”不过，蛋糕还在来的路上。","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"在来自远北的声音响彻整个乌萨斯的那晚，我意识到仅仅聆听是不够的。只有发出声音让更多人听见，才有可能带来改变。哪怕一次只能改变一点，哪怕这一点非常微小，罗德岛也会和我一起，对吗？","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["织田亚希"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_4223_botany/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["则灵"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_4223_botany/{voiceIdLower}.mp3"},{"id":"rus","label":"Russian","actors":["Nana Sarkisyan"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-regional/2a37ac36d9320539e61d117ad1e2521183134daf/current/char_4223_botany/{voiceIdLower}.mp3"}]}}}