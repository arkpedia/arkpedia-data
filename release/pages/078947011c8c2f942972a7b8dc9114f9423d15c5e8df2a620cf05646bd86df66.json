me":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[1,1],[1,2],[1,3],[2,1],[2,3],[2,4],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,2],"rangeCells":[[1,1],[1,2],[1,3],[1,4],[2,1],[2,3],[2,4],[3,1],[3,2],[3,3],[3,4]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"做你的助理？你的意思是让一个字都没认全的小病人替你分担工作？还是说，你怕我又闯什么祸所以要盯紧我？不不，我没意见，你说了算，谁让你才是老大呢。","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"你为什么比我高那么多？如果我在你打盹的时候盯着你看，你会做噩梦吗？那你会发现吗？啧，太可惜了。可以给我些图钉玩儿吗？我保证不会让你感觉到——咳，保证不会扎到你的！","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"圣骏堡动力层里又闷又热，我以前在那替人清扫源石管道，捡了很多被困死的甲虫和蝴蝶——别怕，我没带在身上。唉，小时候真笨，还以为自己比虫子幸运。但我当时在那里，就说明我们其实一样。","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"我现在不想说话。和心情无关，只是——就当我说累了，好吗？我在想事情，和你无关的事。我不吃零食，别和我说话了！唉，思路全乱了！给我看看你有什么零食？算了，要一起去贩卖机上买点吗？","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"晋升后交谈1","text":"无聊，无聊，无聊。这些“文件”怎么都长得一模一样？你每天看的就是这种东西吗……真可怜。要来玩一会儿玻璃弹珠吗？不不，这些是我的，不能借给你，你得自己去外面捡。","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"晋升后交谈2","text":"这只羽兽没有名字。什么为什么？它不是我的宠物，也不是商店里的商品，为什么需要一个名字？它愿意待在我身边，也不是为了食物或取暖。也许它明天就不来了，一切都说不定。","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"信赖提升后交谈1","text":"从文具架上偷拿刀片的人找到了吗？真遗憾。不过你说得对，人就是会被亮闪闪的东西吸引，我在马特维的读书笔记里看到过，有些贵族甚至会为一条项链而买凶抢劫——不，我可没说是我干的。","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"饼干和热茶——你想收买我？调解关系，和谁？你误会了，我并不讨厌罗莎琳，但是她差点把安托沙揍成一摊源石虫胶，不，我没夸张。另外，你要是真想收买我，不如用刀片、大头针或者飞蛾标本。","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"马特维给我的书？不，里面没写什么大道理，只有一些他和安托沙经历过的事。我读得很慢，或者说我其实不太情愿去读。我知道你想问什么，没错，我会想他们，一直会。我还是更想听他亲口讲。","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"哎呀呀，不是故意要吓你的，我已经站在这里观察你很久了——从你刚睡着的时候开始的，怎么了？","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"你就是索尼娅老大的老大？叫我乌啾就行。索尼娅说你很厉害，不过你看着不像是能打过她的样子。行吧，别担心，真打起来我会帮你的——你笑什么？","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"你这东西在哪个街口买的，电影画面这么清晰，也没有奇怪的水印……什么意思，这不是盗版的？也不是电影？！","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"精英化晋升1","text":"这是给我的？款式这么老气，你确定没有拿错吗——哦，原来是晋升勋章，好吧，谢谢你。感言？呃，那么就“继续努力”吧，争取下次送我块更漂亮的。","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"精英化晋升2","text":"又给我一块勋章？真不错，要是再下一场雨，今天就完美了。看看天气预报？唉，我手上的报纸只是伪装用的道具，你真想知道八年前的圣骏堡是什么天气吗？","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"编入队伍","text":"嘶——来之前也没人提醒我会有这么多人。","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"不用盯着我看，自己做自己的事吧。","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"总有人得狠心去伤害别人的感情，也总得有人来疗愈那些受伤的心灵——看来大家都有所牺牲，对吧？放心，我会好好治疗他们的。","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"嘘——小声点。敌人的动静？我不知道呀，我只是想安静会儿。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"就这样吧，别犹豫了。","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"你才是老大，听你的。","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"遵——命。","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"当——然。","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"知道你不怕疼，但还是试试这个吧——是不是好多了？","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"喂！不许殴打我的病人！什么？那家伙不是我们这边的？","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"对，就这么打！别怕，有我在呢！","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"我来缝合伤口，放心，肯定会缝得很漂亮的。","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"这次真的值得夸一夸自己哦，老大。","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"瞧你紧张的样子，我都说了我会帮你的！","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"看我做什么？想听听我的评价吗，还是算了？啧，万一我打算夸夸你呢？","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"我闻到了危险的气息——是谁喷香水了吗？没有的话，应该就是敌人要追上来了，快跑吧。","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"太亮了，我需要一个灯光照不到的角落……我就喜欢，怎么了？","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"你洗过手了吗？不是嫌弃你，只是我刚整理完我的收藏，安全起见，你等会儿最好还是再洗一遍。","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"无可奉告。是的，你还没问，但不影响我的回答……哎呀，问吧问吧，瞧你那表情——说真的，你本来打算跟我说什么？快告诉我！","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"我不喜欢新年肉冻和馅饼，但我倒是挺喜欢在小纸条上写下愿望再烧掉的传统。以往我都写“有地方住”，然后就认识了安托沙。后来我改成“能吃饱肚子”，就来了这里。现在嘛——不告诉你！","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"奇怪，总有一种被人盯着的感觉……你来得正好，快看看你桌上的加湿器是不是有点古怪？没有？不可能不可能，我的直觉一向很准的！","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"欸，被你发现了。本来想趁你到办公室之前偷偷放在这里的。给，我照着你的样子缝的布娃娃，可爱吧？毕竟你平时也挺照顾我的，祝你生日快乐！什么叫不习惯我这样说话？喂！你跟我讲清楚！","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"“道路”，这个词安托沙教过我很多次，想跟我说清楚它的含义，但马特维总会阻止他，说光听别人讲是没法明白的，最好还是自己去看，自己去走。博士，我在罗德岛上看了许多，我还想走更远。","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["寺泽百花"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4224_turdus/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["施丛昊"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4224_turdus/{voiceIdLower}.mp3"},{"id":"rus","label":"Russian","actors":["Vasilisa Eldarova"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-regional/main/current/char_4224_turdus/{voiceIdLower}.mp3"}]}}}