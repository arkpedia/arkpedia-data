it","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":5,"opCell":[3,1],"rangeCells":[[1,1],[1,2],[2,1],[2,2],[2,3],[3,2],[3,3],[3,4],[4,1],[4,2],[4,3],[5,1],[5,2]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"有什么需要我做的事都请吩咐我，只要是我能做到的。有没有不情愿做的事？非要说的话请尽量不要让我去杀害无辜的人。嗯，我没有其他补充。","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"之前我所在的组织里那些发号施令的人，都会要求必须在称呼他们时使用“指挥官”“长官”“队长”“您”之类的词。如果你希望的话我也会照做。没有这类规定吗？我明白了。","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"这些需要我手写的文书工作，还是请你再考虑一下，我写的字嘛……我也试过练字，但成果就是现在这样。你看，没有只要愿意花时间就一定能做得比别人好的道理。","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"我没有理由拒绝配合医疗部那位萨卡兹的研究，虽然我不觉得无法长大这件事有什么研究价值。在玻利瓦尔没能长大成人就离世的孩子有很多，而我只是还活着而已。","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"晋升后交谈1","text":"我已经记不清，有多少人在最后一刻来临之前，要我替他们去看那个不再需要更多人为之牺牲的未来，我没有办法拒绝。可我能看到的只有下一个对我这么说的人，一个接一个。","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"晋升后交谈2","text":"来到罗德岛的原因？你不会喜欢听的。说实话，我不能理解任何一个为了某样追求而舍弃生命的人，所以我只能做一些模仿来尝试理解他们。反正除了不想死以外，我也没有什么想要追求的目标。","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"信赖提升后交谈1","text":"我听过那个童话故事。但你看，我不会飞，也没有不要长大的想法，更不会“处理”掉即将长大的同伴们。嗯？不太对吗？我印象里好像是有这样一段，是隔了太久记错了吗……","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"请不要把我当小孩子看待……既然有得选，那偏爱烤肉和汽水也很正常吧。与其说小孩子喜欢挑食，不如说大家在面对小孩子时总会觉得自己有资格说对方挑食。","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"我最近的生活好像有点太安心，也太开心了。不，我不是说这有什么不好的，只是……我也不知道。如果我开始变得安于现状，这会是对一些人的辜负和背叛吗？","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"别在意，我还不困，你累的话就先休息吧。","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"代号是佩德洛，今天起正式成为罗德岛的干员。我会尽快熟悉贵司的业务，希望我们合作愉快，嗯。","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"跟这些比起来，以前我执行过的那些根本不能叫战术呢。","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"精英化晋升1","text":"看来你对我的表现还算满意？我很开心。","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"精英化晋升2","text":"我吗？真的没问题吗？啊，我只是难得有些兴奋。你也知道，那些将军当然不会把小孩子当成什么有价值的资源。","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"编入队伍","text":"我会全力配合此次战术执行。","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"我已收到战术预测，请给我下一步的指示。","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"我们都会活着回来的。","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"敌方的部署与预测相符，按原定计划执行我方战术。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"我已了解。","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"我将执行。","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"我将前往。","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"我已经抵达，等候下一个指令。","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"放下你的武器。","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"停止你的抵抗。","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"执行掩护射击。","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"我们都会活下来的。","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"你用最小的代价结束了这场灾难……谢谢你。","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"我们胜利了。我们阻止了更多无辜的人被杀死，对吧。","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"你遏止了进一步的打击，但愿我们的敌人不会给别处带去更多痛苦与死亡……","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"别难过，我们都还活着，这比什么都要紧。","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"要我去哪里都行，你说了算。","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"唔嗯？别这样，我怕痒。","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"别把我当小孩子……唉，随便你吧。","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"又过了一年。以前我会有点分不清今年和去年，还有再之前的每一年，它们之间到底有什么区别……但这一年我确实见到了一些值得被记住的新东西，真好。希望我不会太快忘记它们。","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"你回来了，这比什么都好。","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"今天是你的生日吧。嗯，是没有跟我说过，你没记错。只是去年看到大家给你送礼物，我就在终端的日历上备注了一下。总之，生日快乐，礼物收好。","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"“……在这充满意义的日子，希望我和博士也能回顾过去的收获，再次实现自我的——”嗯，怎么了？很奇怪，不用背诵了？好吧，被你看出来我找人帮忙准备了稿子，我真的不太懂这个。","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["白石冬弥"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4234_pedro/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["杨泽泉"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4234_pedro/{voiceIdLower}.mp3"}]}}}