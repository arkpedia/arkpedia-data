,[2,4],[1,1],[1,2],[1,3]]},"levelRangeIds":["3-4","3-4","3-4","3-4","3-4","3-4","3-4","3-4","3-4","3-4"],"grids":{"3-4":{"cols":4,"rows":5,"opCell":[3,1],"rangeCells":[[5,1],[5,2],[5,3],[4,1],[4,2],[4,3],[4,4],[3,2],[3,3],[3,4],[2,1],[2,2],[2,3],[2,4],[1,1],[1,2],[1,3]]}},"changesAt":[]}},"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}},{"elite":1,"talent":null,"range":{"cols":4,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[2,4],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Good morning, Doctor. Can I paint a portrait of you? And don't worry, I'll try not to... bring it to life. Besides, it's not like I can bring everything to life, you know.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Maybe I wasn't supposed to appear here?…","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Doctor... what color are you, reflected in my eyes?","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"There are lots of fun, creative things here at Rhodes Island. I'm feeling inspired…","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"See my lovely 'assistants'? Hehe… What? You think they're scary? But, but they're so cute!","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"Heh, so these are the colors of your soul…? Alright then, look at me. And paint me in those colors, your colors.","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"That's right. Even if no one understands me, I'll keep making art. No matter what kinds of monsters my works might become…","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"We artists are a unique breed… We spend at least thirty days a month stuck in a rut, thinking all our work is trash. And we only make any progress when inspiration strikes after midnight.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"In the end, the mottled world sleeps peacefully in the dark depths—Yes, that's the true color of the ocean. Black is the only color you see? Looks like I still have more to share with you…","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Are you... dreaming? Is the world in your dreams as colorful as the beings of this world, Doctor…?","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"I'm Deepcolor, a painter. Yes, just a 'painter', nothing more.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"What's this unsettling feeling...?","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Um, could you just... stop caring about me? If you keep treating me so well... I-I don't know what I might become…","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"Thank you, Doctor. Now, let's complete this work of art, shall we?","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"You're sending me to fight? Seriously?!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"I can't lead so many people.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Do your best, everyone!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Is that who we're fighting?!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Me?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"What do I do?","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Scumble-scumble...","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Aww, I just need a minute!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"No need to rush.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Let's take it slow.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"You'll have to get past my 'assistants' first.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Can you defeat my little ones?","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"If you really make me mad... you won't like what happens next.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Let me sketch these triumphant heroes.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Aw, got my clothes dirty again...","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"If only battles were like sketches. I'd just erase that one and redo it…","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"This room's got a nice design.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Hm?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Doctor, since we happen to have some time off, want to see my latest work?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year, Doctor. What colors do I see for the coming year? Hm… the aroma of food, smiling operators, and presents full of kindness… a warm, tender turmeric? It's like nothing I've ever felt. I have to get this onto a canvas.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Good morning, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Here's a hand-drawn birthday card. Do you like it? Heheh. I have two birthdays myself, in a way. I achieved a new form, after accepting the gift. Here, Doctor, look—I created this color, but it is entirely yours.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"What day is it? Oh, of course. I see my 'assistants' are all joining in on the fun. Alright, why don't we let them make an even more beautiful piece for Rhodes Island?","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Jenny Yokobori"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/main/current/char_110_deepcl/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["You Taichi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_110_deepcl/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Misty"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_110_deepcl/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Sae-hae"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/main/current/char_110_deepcl/{voiceIdLower}.mp3"}]}}}