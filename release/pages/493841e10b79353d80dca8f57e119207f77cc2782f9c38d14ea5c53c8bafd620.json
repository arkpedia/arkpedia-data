 -1"},{"level":3,"benefit":"Redeployment time -4 seconds"},{"level":4,"benefit":"Max HP +200"},{"level":5,"benefit":"Redeployment time -6 seconds"},{"level":6,"benefit":"DP cost -1"}],"totalCost":[{"name":"Cardigan's Token","quantity":5}]},"promotion":[{"tier":"Elite 1","upgrades":["Maximum attributes increased.","DP cost +2 .","New talent: Max HP Up ."],"prerequisite":"Raise Cardigan to Level 40.","cost":[{"name":"LMD","quantity":10000}]}],"skills":{"skillList":[{"name":"Regeneration α","recoveryType":"Auto Recovery","activationType":"Manual","duration":null,"levels":[{"level":1,"mastery":null,"description":"Restores HP by 20% of Max HP","initialSp":0,"spCost":26,"duration":0},{"level":2,"mastery":null,"description":"Restores HP by 23% of Max HP","initialSp":0,"spCost":25,"duration":0},{"level":3,"mastery":null,"description":"Restores HP by 25% of Max HP","initialSp":0,"spCost":24,"duration":0},{"level":4,"mastery":null,"description":"Restores HP by 30% of Max HP","initialSp":5,"spCost":23,"duration":0},{"level":5,"mastery":null,"description":"Restores HP by 32% of Max HP","initialSp":5,"spCost":22,"duration":0},{"level":6,"mastery":null,"description":"Restores HP by 35% of Max HP","initialSp":5,"spCost":21,"duration":0},{"level":7,"mastery":null,"description":"Restores HP by 40% of Max HP","initialSp":10,"spCost":20,"duration":0}],"recommendation":[],"cost":null,"pairings":[],"techniques":[]}],"skillCost":null},"baseSkills":[{"name":"Warehouse Organization α","facility":"Factory","eliteLevel":"Base","description":"When this Operator is assigned to a Factory, capacity limit +6 and productivity +10%"},{"name":"Liveliness","facility":"Dormitory","eliteLevel":"Elite 1","description":"When this Operator is assigned to a Dormitory, restores +0.2 Morale per hour to another Operator assigned to that Dormitory whose Morale is not full (Only the strongest effect of this type takes place); furthermore, self Morale recovered per hour +0.4"}],"modules":[],"review":{"official":"Cardigan is a member of\nOp Reserve Team A4\nand a citizen of\nLeithanien\n. Before taking up her current position, she was a member of the Bobsled Patrol Team. After an exceptional performance on her tests, she received permission to join\nRhodes Island\n.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":40,"base":{"hp":1197,"atk":190,"def":229,"res":0,"redeploy":70,"dp":16,"block":3,"interval":1.2},"max":{"hp":1597,"atk":244,"def":342,"res":0,"redeploy":70,"dp":16,"block":3,"interval":1.2},"rangeId":"0-1"},{"elite":1,"minLevel":1,"maxLevel":55,"base":{"hp":1597,"atk":244,"def":342,"res":0,"redeploy":70,"dp":18,"block":3,"interval":1.2},"max":{"hp":2130,"atk":305,"def":475,"res":0,"redeploy":70,"dp":18,"block":3,"interval":1.2},"rangeId":"0-1"}],"trust":{"hp":300,"atk":0,"def":0}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging tests reveal clear, normal outlines of internal organs, and no abnormal shadows have been detected. Originium granules have not been detected in the circulatory system and there is no sign of infection. At this time, this Operator is believed to be non-infected.\n\n[Cell-Originium Fusion Rate] 0% \nOperator shows no signs of infection at this time.\n\n[Blood Crystal Density] 0.09u/L \nPhysical data reveal this Operator to be in a roughly healthy state."},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"[Cardigan]\nCardigan is a proactive and confident Operator who carries out both daily tasks and combat missions with vigor. As a member of Reserve Op Team A4, Cardigan is very fond of all her teammates."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"[Cardigan's History 1]\nCardigan was born the oldest of five children in the frigid northern region of Leithanien to a mother and father who worked in the forests. Growing up in a comfortable and relaxed household, she had harmonious and intimate relationships with all her family members. When she was a child, she dreamed of becoming a professional skier. With her family's support, she took a shot at her dream, but ultimately failed to succeed. She quit ski training and was recruited by a bobsled patrol team. It was during this time that Cardigan underwent defensive and tactical training."},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"[Cardigan's History 2]\nBefore she was recruited by Rhodes Island, she left her hometown, curious about city life. She made her way to the center of Leithanien to seek work, but due to its focus on Arts and her lack of talent for it, as well as her love of sport, she felt the city wasn't a good fit for her. During her stay in Leithanien, she met fellow travelers Steward and Adnachiel and formed a deep friendship with them. Even after the two of them became infected, Cardigan continued to put all her effort into helping her friends make it through, and contacted Rhodes Island to seek treatment for them."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"[Cardigan's...]\nA list of broken items.\nSofa back leather 14 square centimeters. Cause of damage: Weapon wasn't unequipped and its edge cut everything up.\nMedic Operator Ansel's office chair legs. Cause of damage: Got over-excited and lost balance. Chair legs bent as a result.\nA 90*120cm tactics book. Cause of damage: Over-excitement resulted in book getting broken with a hammer.\nSignature of person responsible: Cardigan. Signature of team leader: Melantha.\nOutcome: After finance personnel calculate damage, they inform the responsible party that payment will be deducted from their salary in 12 equal installments for compensation. Responsible party has been handed over to team leader for Reserve Op Team discipline and re-education."}]},"appearances":[{"label":"Base","iconPath