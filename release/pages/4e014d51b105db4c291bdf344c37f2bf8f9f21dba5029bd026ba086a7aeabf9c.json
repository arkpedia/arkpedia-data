e":null},{"name":"Vendela","rarity":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{"Self-Sustain":{"entries":[{"name":"Blemishine","rarity":6,"isFuture":null},{"name":"Entelechia","rarity":6,"isFuture":null},{"name":"Executor the Ex Foedere","rarity":6,"isFuture":null},{"name":"Hoshiguma the Breacher","rarity":6,"isFuture":null}],"totalCount":96}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":1,"rows":1,"opCell":[1,1],"rangeCells":[]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Here I am! What should we play, baseball or board games? Oh, you're working?","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Where was I born, you ask? Well, umm...no idea. But that doesn't matter, right?","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Hello, Professor Rhodes Island! Wait, am I calling you by the right name?...","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Hm, what's my assignment today? To capture some long, sleek animals?","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_005","title":"Talk after Promotion 1","text":"Hey! Don't knock on my backpack! Oh, sorry, I'm not mad, I'm just worried. If you're not careful, you could hurt your hand! Here, let me show you how it's done.","category":"profile","status":"current","unlock":null,"order":5},{"id":"CN_006","title":"Talk after Promotion 2","text":"If anyone dares to hurt you, I'll smash them with my baseball bat. Oh, uh... so... there really are people who hurt you? Um... actually, I'm not that good at fighting, hehe…","category":"profile","status":"current","unlock":null,"order":6},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"I love spending the whole day just walking down the street. I get to watch the people, enjoy the sunshine, and then… lose my way!","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"You've been treating my sickness, and you gave me a place to live... you're really so kind...","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"Doctor, are you my big brother? Or big sister?... Well, does't matter! I'm not leaving you, even if you throw me out! It's not like I can walk far anyway.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"Oh, the Doctor is busy. I'll just play by myself then...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Hm? Where am I? Who am I?","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"I can make myself super tough! It's my only special skill!","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_013","title":"Promotion 1","text":"Promotion? What's a promotion?... Whatever, let's play for a bit longer! You and me, together!","category":"profile","status":"current","unlock":null,"order":13},{"id":"CN_014","title":"Promotion 2","text":"New position or not, I don't really care. All I want is to be by your side every day. Can you grant this tiny wish of mine?","category":"profile","status":"current","unlock":null,"order":14},{"id":"CN_017","title":"Added to Squad","text":"I've got lots of friends here!","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Everybody, let's go!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"We'll be fine if we stick together!","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Everyone, let's play!","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"I'm here~!","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Doctor!","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Ora ora!","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Hey, dummies, bring it on!","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Muda muda muda muda!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"C'mon, show me what you got!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"This is my playground!","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"I won't back down!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"Was that tough? Didn't feel much different from any other battle.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Homerun!","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Safe!","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Aww... struck out…","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"Just don't throw fireballs at me, okay?","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Wow, fun!","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"Hey Doctor! Can we play a little bit longer? Just a little bit!","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy new year, Doctor! I'm looking for the place I was first found. It's somewhere around on the deck. Was it here… or there?... Hm? Why am I looking for it? Because I was actually having a cozy nap when you guys found me. The sunshine was so warm... And I want to take a nap like that again! Hehe...","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Heya! Doctor!","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Hey, hey, Doctor! Happy birthday! These are for you: this baseball bat, these mitts, and this baseball! Come on, let's play!... You still got work to do? You're working on your birthday? Can't you take a day off? Aww…","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Hehe, they're all busy having fun outside! I'm gonna pack up my bag a little, then get out and return with cool stuff loaded on my back! What's in my bag? A baseball, pair of mitts, and… Doctor, just between you and me, and promise to keep it from the Medical Department—I also got some snacks in there!","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"en","label":"English","actors":["Xanthe Huynh"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_150_snakek/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Ayaka Suwa"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_150_snakek/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Gelin Tian"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_150_snakek/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Jung Hye-won"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_150_snakek/{voiceIdLower}.mp3"}]}}}