null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Morning, Doctor... Mind if I lay out my sleeping bag here...? Thanks. The rest is up to you...","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"How do I fight? Using Arts, of course... Want me to show you the power of earth?","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"What time is it...? See, I don't work mornings, noons, afternoons, or nights...","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"You'll make an S-sized uniform for me...? No thanks. My oversized one works as a sheet when I take naps... plus, it's really warm.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"Dooooctoooooor? I need a break! I'm competing in the Speedy Sleep Contest.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"Doctor, check this out. This isn't my normal wand, it's a pendulum. You're feeling very sleepy and will nap in five minutes without giving me any work... Zzzz...","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"I was hoping I could tell you about my homeland, Doctor.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"After you went to sleep, I somehow didn't feel sleepy at all anymore... Hmmmph...","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"Hello? Hellooooo? Can you hear me? Down here. Down heeeeere! Nice meeting you, big Doctor. I'm Durin the Caster.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"Whoa... I've fiiiinally gotten s-tron-ger.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"Added to Squad","text":"The secret to staying healthy is to sleep whenever you can.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Captain's orders: everyone, save your energy and take a nap!","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"I wanna dig a hole in the ground and make a shelter to sleep in, if you don't mind.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Take over for me. Thaaanks.","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Wooo.","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Hmm?","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"What a pain.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Okaaaay, I'll do it.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"You're going down!","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Gooooooo!","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_029","title":"4-star Result","text":"Why do we have annoying missions like this? Can't we do something easier...? Still, it's nice that we won.","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"Of course we won. I worked real hard supporting you with my Arts.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"Doctor, are you still worried about those ones that got through?","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Ugghh... Sorry... I'll try harder next time...","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"The Land of Giants... Here I aaaaaaaaaaaaaaam!","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Hmmm?","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"I'm in a good mood, so how about a magic trick?","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":"Happy New Year, Big Doctor. There's lots of tasty foods at the cafeteria. Have you been eating well? Oh, right, I saw Myrtle carrying a huge sack with her to the cafeteria just now. Too late, though. I already ate all the cheese fried fowlbeast.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"*Yawn*... Good morning...","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Big Doctor, Big Doctor, Happy birthday! If you're another year older, does that mean you're getting taller, too? I bought you a sleeping bag. If you're getting taller, I don't know how long it'll fit...?","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"Because of how short I am, nobody ever notices whether I'm working or playing hooky... Rhodes Island gave me a really comfortable environment to sleep in, though, so I still gotta do some things every now and then to repay the favor. Doctor, I'm looking forward to a good year.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_005","title":"Post-Promotion Talk 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_013","title":"Elite Promotion 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2002,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2003,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["Emma Ballantine"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_501_durin/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Akari Kageyama"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_501_durin/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Menglu Yang"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_501_durin/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Yang Jung-hwa"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_501_durin/{voiceIdLower}.mp3"}]}}}