ame":"Tuye","rarity":5,"isFuture":null},{"name":"Typhon","rarity":6,"isFuture":null},{"name":"U-Official","rarity":1,"isFuture":null},{"name":"Ukusik","rarity":5,"isFuture":null},{"name":"Ulpianus","rarity":6,"isFuture":null},{"name":"Underflow","rarity":5,"isFuture":null},{"name":"Utage","rarity":4,"isFuture":null},{"name":"Valarqvin","rarity":5,"isFuture":null},{"name":"Vanilla","rarity":3,"isFuture":null},{"name":"Varkáris","rarity":5,"isFuture":null},{"name":"Vendela","rarity":5,"isFuture":null},{"name":"Verdant","rarity":4,"isFuture":null},{"name":"Vermeil","rarity":4,"isFuture":null},{"name":"Vetochki","rarity":5,"isFuture":null},{"name":"Vigil","rarity":6,"isFuture":null},{"name":"Vigna","rarity":4,"isFuture":null},{"name":"Vina Victoria","rarity":6,"isFuture":null},{"name":"Violet Mizutsune Orchid","rarity":6,"isFuture":null},{"name":"Virtuosa","rarity":6,"isFuture":null},{"name":"Viviana","rarity":6,"isFuture":null},{"name":"Viy","rarity":6,"isFuture":null},{"name":"Vulcan","rarity":5,"isFuture":null},{"name":"Vulpisfoglia","rarity":6,"isFuture":null},{"name":"W","rarity":6,"isFuture":null},{"name":"Waai Fu","rarity":5,"isFuture":null},{"name":"Wakaba Mutsumi","rarity":5,"isFuture":null},{"name":"Wang","rarity":6,"isFuture":null},{"name":"Wanqing","rarity":5,"isFuture":null},{"name":"Warfarin","rarity":5,"isFuture":null},{"name":"Warmy","rarity":5,"isFuture":null},{"name":"Weedy","rarity":6,"isFuture":null},{"name":"Whislash","rarity":5,"isFuture":null},{"name":"Whisperain","rarity":5,"isFuture":null},{"name":"Wild Mane","rarity":5,"isFuture":null},{"name":"Wind Chimes","rarity":5,"isFuture":null},{"name":"Windflit","rarity":5,"isFuture":null},{"name":"Windscoot","rarity":4,"isFuture":null},{"name":"Wiš'adel","rarity":6,"isFuture":null},{"name":"Wulfenite","rarity":5,"isFuture":null},{"name":"Xingzhu","rarity":5,"isFuture":null},{"name":"Yahata Umiri","rarity":5,"isFuture":null},{"name":"Yato","rarity":2,"isFuture":null},{"name":"Yu","rarity":6,"isFuture":null},{"name":"Yūtenji Nyamu","rarity":5,"isFuture":null},{"name":"Zima","rarity":5,"isFuture":null},{"name":"Zima the Raging Tide","rarity":6,"isFuture":null},{"name":"Zinogre S Catapult","rarity":5,"isFuture":null},{"name":"Zuo Le","rarity":6,"isFuture":null}],"techniqueUnitIcons":{},"techniqueBranchOperators":{},"techniqueGroupOperators":{},"techniqueRelatedOperators":{},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[2,2],[2,3],[3,1],[3,2]]}}],"voiceData":{"textLocale":"en","lines":[{"id":"CN_001","title":"Appointed as Assistant","text":"Forgive me, Doctor... There are limits to what I can do, including in conversation... but I'm honored to be your assistant. I look forward to helping you with your work.","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"Talk 1","text":"Doctor, time heals all wounds. Please have more confidence in yourself. Your Operators have chosen to follow you because we believe that you will bring positive change.","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"Talk 2","text":"Many Infected have relocated to Rhodes Island... not because they have any particular goals to achieve, but simply because they want a place to call home. The world outside no longer accepts them, after all...","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"Talk 3","text":"Owl may not seem very friendly, but she's got a good heart. Please excuse her and pay her no mind.","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"Talk after Trust Increase 1","text":"12F? That was the day I 'came to' this world. You could consider it my birthday.","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"Talk after Trust Increase 2","text":"I might not be able to spend my entire life serving one person... but at least I can start working on it now.","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"Talk after Trust Increase 3","text":"She has finally found you, Doctor. What a perilous journey it's been. You're very important to her, as well as to everyone else.","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"Idle","text":"I'll be by your side watching over you, Doctor, even in your sleep. So rest easy, you have nothing to fear.","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"Onboard","text":"You have my thanks for allowing me to join you. From now on, I will do my best to serve you, Doctor, with my alchemical skills. I have never had a name... but if you must call me something, you can refer to me as 12F.","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"Watching Battle Record","text":"I see, I understand now. Thank you for your guidance.","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"Added to Squad","text":"I may not possess outstanding skills, but I will do my best.","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"Appointed as Squad Leader","text":"Will it be alright for me to be the leader? Anyway, thank you for your trust, Doctor.","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"Depart","text":"Relax, Doctor. We will complete this operation in no time.","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"Begin Operation","text":"Everyone, get ready for battle. ","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"Selecting Operator 1","text":"Your orders?","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"Selecting Operator 2","text":"Ready for action.","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"Deployment 1","text":"Got it.","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"Deployment 2","text":"Copy.","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"In Battle 1","text":"Please show me the path.","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"In Battle 2","text":"Burn to ashes.","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"In Battle 3","text":"Clear away all obstacles.","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"In Battle 4","text":"Watch out, Owl!","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"4-star Result","text":"I'm used to failure... but a victory after countless defeats is always the most precious one. Don't you agree, Doctor?","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3-star Result","text":"This victory is all yours, Doctor. And I am honored to be a pawn in your game of chess.","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"Sub 3-star Result","text":"That was a hard-won victory, but we did it. Are you all right, Owl?","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"Operation Failure","text":"Failure is only normal. Don't be discouraged. I've been in many wars, and my experience tells me that your victory will come soon.","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"Assigned to Facility","text":"If you'd like, I can help. No trouble.","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"Tap","text":"Aah! Be careful.","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"Trust Tap","text":"I am so thankful for all that you have done for me. I feel ashamed I have so little with which to repay your kindness. Forgive me, Doctor.","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"Title","text":"Arknights.","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"New Year's blessing","text":" 'I want to live through the coming year.' That's probably every mercenary's wish they only dare think deep down, and never risk saying out loud. Doctor, may all be peaceful in your New Year.","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"Greeting","text":"Good morning to you, Doctor.","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"Birthday","text":"Doctor, happy birthday. I'm very curious, actually. Is this your real birthday, or is it maybe a particularly significant day to you? Oh, perhaps I'm prying too much. Please, forgive me.","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"Anniversary Celebration","text":"I was just a lucky survivor, and found a place to call home in Rhodes Island. I will devote all the power I have, and I look forward to the ending that you lead us towards, Doctor.","category":"special","status":"current","unlock":null,"order":44},{"id":"CN_005","title":"Post-Promotion Talk 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2000,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_006","title":"Post-Promotion Talk 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2001,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_013","title":"Elite Promotion 1","text":null,"category":"unused","status":"unused","unlock":null,"order":2002,"availablePacks":["cn","en","jp","kr"]},{"id":"CN_014","title":"Elite Promotion 2","text":null,"category":"unused","status":"unused","unlock":null,"order":2003,"availablePacks":["cn","en","jp","kr"]}],"packs":[{"id":"en","label":"English","actors":["James Phoon"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-english/58e999c42e9fb00832d571ab35a1666000557088/current/char_009_12fce/{voiceIdLower}.mp3"},{"id":"jp","label":"Japanese","actors":["Atsushi Kakehashi"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/15ab8a81f1fc3b7e9b5486cf00c5afdc4b948649/current/char_009_12fce/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["Yuxuan Liu"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/88535cc2a7c43056f2c370850184545b8c478a43/current/char_009_12fce/{voiceIdLower}.mp3"},{"id":"kr","label":"Korean","actors":["Kim Young-sun"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-korean/38e75788058bbbbc5b17330a1591245fbb08f822/current/char_009_12fce/{voiceIdLower}.mp3"}]}}}