","quantity":4},{"name":"Sugar Lump","quantity":2},{"name":"RMA70-24","quantity":2}],"m3":[{"name":"Skill Summary - 3","quantity":6},{"name":"D32 Steel","quantity":2},{"name":"Oriron Block","quantity":2}]},"pairings":[],"techniques":[]}],"skillCost":{"2":[{"name":"Skill Summary - 1","quantity":2}],"3":[{"name":"Skill Summary - 1","quantity":2},{"name":"Sugar Substitute","quantity":4}],"4":[{"name":"Skill Summary - 2","quantity":3},{"name":"Polyester","quantity":2}],"5":[{"name":"Skill Summary - 2","quantity":3},{"name":"Oriron","quantity":2}],"6":[{"name":"Skill Summary - 2","quantity":3},{"name":"Loxic Kohl","quantity":2}],"7":[{"name":"Skill Summary - 3","quantity":4},{"name":"Manganese Ore","quantity":3}]}},"baseSkills":[{"name":"Clue Search β","facility":"Reception Room","eliteLevel":"Base","description":"When this Operator is assigned to the Reception Room, Clue search speed increases by 20%"},{"name":"Negotiation","facility":"Trading Post","eliteLevel":"Elite 1","description":"When this Operator is assigned to a Trading Post, order limit +5 and Morale consumed per hour -0.25"}],"modules":[{"type":"Original","name":"Rope's Badge","stages":[]},{"type":"Upgrade","name":"HOK-X: Tin Casket","mission":{"requirement1":"During battle, have Rope use Double Hook a total of 10 times (excluding Support Units)","requirement2":"Clear Main Theme 3-3 with a 3-star rating; You must deploy your own Rope, and cause Crownslayer to fall into a pit"},"stages":[{"stage":"Stage 1","attributesIncreased":"HP +100 , ATK +22","effectLabel":"New trait","effectText":"While being pulled, enemies take Arts damage proportional to the distance traveled [ note 1 ]","cost":[{"name":"Module Data Block","quantity":1},{"name":"RMA70-12","quantity":4},{"name":"LMD","quantity":20000}]},{"stage":"Stage 2","attributesIncreased":"HP +160 , ATK +27","effectLabel":"Auditory Training improved","effectText":"Gains 35% Physical Dodge","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Stick","quantity":15},{"name":"Coagulating Gel","quantity":5},{"name":"LMD","quantity":25000}]},{"stage":"Stage 3","attributesIncreased":"HP +200 , ATK +31","effectLabel":"Auditory Training improved","effectText":"Gains 40% Physical Dodge","cost":[{"name":"Module Data Block","quantity":1},{"name":"Data Supplement Instrument","quantity":5},{"name":"Orirock Cluster","quantity":6},{"name":"LMD","quantity":30000}]}]}],"review":{"official":"Rope is a cat burglar from the slums of\nLungmen\n, who got caught during a botched caper. Sent to\nRhodes Island\non a special recommendation from Madam\nCh'en\nafter Lungmen formed a partnership with the island.\nResponsible for intelligence gathering. Uses a rope and grappling hook in combat to disorient the enemy.","editor":null,"rating":null},"synergies":[],"techniques":[{"technique":null,"techniqueDescription":null,"description":null}],"guides":[],"stats":{"phases":[{"elite":0,"minLevel":1,"maxLevel":45,"base":{"hp":744,"atk":313,"def":142,"res":0,"redeploy":70,"dp":10,"block":2,"interval":1.8},"max":{"hp":1006,"atk":448,"def":209,"res":0,"redeploy":70,"dp":10,"block":2,"interval":1.8},"rangeId":"2-2"},{"elite":1,"minLevel":1,"maxLevel":60,"base":{"hp":1006,"atk":448,"def":209,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.8},"max":{"hp":1307,"atk":582,"def":276,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.8},"rangeId":"3-2"},{"elite":2,"minLevel":1,"maxLevel":70,"base":{"hp":1307,"atk":582,"def":276,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.8},"max":{"hp":1720,"atk":728,"def":325,"res":0,"redeploy":70,"dp":12,"block":2,"interval":1.8},"rangeId":"3-2"}],"trust":{"hp":0,"atk":0,"def":60}},"files":[{"section":"Clinical Analysis","unlock":"Unlocked at 25 trust","description":"Imaging test for this Operator showed blurry outline of internal organs with visible unusual dark spots. Unusually high concentration of Originium particles were present in her circulation, indicating signs of infection and confirming her as infected at this stage. \n\n[Cell-Originium Assimilation] 18% \nWhile only a few vestiges of infection are visible on surface, internal organs have been severely compromised. \n\n[Blood Originium-Crystal Density] 0.30u/L \nBy the time she joined Rhodes Island, Operator Rope had already missed the best window of opportunity for treatment. Malnutrition and environmental factors put her health in imminent danger. \nCurrently, given proper care, she is in stable condition. I hope she will continue to take better care of herself. \n—Silence"},{"section":"Archive File 1","unlock":"Unlocked at 50 trust","description":"A coy thief. \nShe smiles at everyone, but it's a polite, distant smile. \nPilfering is second nature to her. She will sometimes pickpocket someone without even realizing it. At least she knows to give it back now."},{"section":"Archive File 2","unlock":"Unlocked at 100 trust","description":"Rope doesn't begrudge her parents. She knows sometimes a poor family just has to abandon a child or two. At least her parents cried when they kicked her out of the house. \nRope doesn't hate the world either, knowing that no matter how much she curses the gods, won't give her what she needs to eat. Not to mention all the worse things she's seen from her years in the slums. \nOf course, Rope never had any problem stealing. She knew it was wrong, but what could she do?"},{"section":"Archive File 3","unlock":"Unlocked at 150 trust","description":"Rope actually loved prison, since her meals were taken care of, and she got a free bed out of the deal. If it wasn't for the rehabilitation classes, she would've gotten herself caught on purpose. \nOf course, she'd still slip up occasionally, but she knew every one of the guards and they were impressed with her thieving skills. \nShe did wonder if they might actually hire her as a cop. What she never expected was getting 'sold' to a place called Rhodes Island."},{"section":"Archive File 4","unlock":"Unlocked at 200 trust","description":"Rope still isn't used to life on the island. \nShe gets food, clothes, and a roof over her head. Plus there's a lot of freaks and weirdos here. Nobody looks down on her because of her background, and even when she does steal from them, they just want her to return it with an apology. \nWith all that, she doesn't need to use any of the survival skills she honed in the slum. It's all very foreign to her. \nBut it feels... not too bad."}]},"appearances":[{"label":"Base","iconPath":"/four-star-icons/Rope%20-%20Base.webp","fullPath":"/four-star-skins/Rope%20-%20Base.webp"},{"label":"Elite 2","iconPath":"/four-star-icons/Rope%20-%20Elite%202.webp","fullPath":"/four-star-skins/Rope%20-%20Elite%202.webp"},{"label":"Imp's House","iconPath":"/four-star-icons/Rope%20-%20Imp's%20House.webp","fullPath":"/four-star-skins/Rope%20-%20Imp's%20House.webp"},{"label":"Summer Flowers FA008","iconPath":"/four-star-icons/Rope%20-%20Summer%20Flowers%20FA008.webp","fullPath":"/four-star-skins/Rope%20-%20Summer%20Flowers%20FA008.webp"}],"skinObtainByLabel":{"Summer Flowers FA008":"15 OP","Imp's House":"40 DC / 400 UC"},"synergyMatches":[],"autoSynergyGroups":[],"allOperatorNames":[{"name":"12F","rarity":2,"isFuture":null},{"name":"Aak","rarity":6,"isFuture":null},{"name":"Absinthe","rarity":5,"isFuture":null},{"name":"Aciddrop","rarity":4,"isFuture":null},{"name":"Adnachiel","rarity":3,"isFuture":null},{"name":"Akafuyu","rarity":5,"isFuture":null},{"name":"Akkord","rarity":4,"isFuture":null},{"name":"Alanna","rarity":5,"isFuture":null},{"name":"Almond","rarity":5,"isFuture":null},{"name":"Ambriel","rarity":4,"isFuture":null},{"name":"Amiya","rarity":5,"isFuture":null},{"name":"Amiya (Guard)","rarity":5,"isFuture":null},{"name":"Amiya (Medic)","rarity":5,"isFuture":null},{"name":"Andreana","rarity":5,"isFuture":null},{"name":"Angelina","rarity":6,"isFuture":null},{"name":"Angelina the Mellow Wish","rarity":6,"isFuture":null},{"name":"Ansel","rarity":3,"isFuture":null},{"name":"Ao