afjalla","rarity":6,"isFuture":null},{"name":"Texas the Omertosa","rarity":6,"isFuture":null},{"name":"Logos","rarity":6,"isFuture":null}],"totalCount":8}},"forms":null,"skillRanges":null,"overviewRanges":[{"elite":0,"talent":null,"range":{"cols":3,"rows":3,"opCell":[2,1],"rangeCells":[[1,1],[1,2],[1,3],[2,2],[2,3],[3,1],[3,2],[3,3]]}}],"voiceData":{"textLocale":"zh-CN","lines":[{"id":"CN_001","title":"任命助理","text":"当年帮凯尔希做过的事，也不是不能帮你做。凡是生物样本，甭管昆虫、草籽还是十几米长的顶级掠食者，我都能给你带来。怎么带……谁教你这么问问题的？","category":"profile","status":"current","unlock":null,"order":1},{"id":"CN_002","title":"交谈1","text":"给你，“高级饲料”，那些生物学家送的，我看着硌硬。一个两个都求我讲我当年见过的昆虫，我真讲，他们又打瞌睡。说是要写“昆虫学巨著”，连味道和口感都不关心，写什么写？","category":"profile","status":"current","unlock":null,"order":2},{"id":"CN_003","title":"交谈2","text":"凯尔希还四脚着地的时候，可没这么郁闷，怎么回事？我当初才花十五年就领会了完美的鸡生，她又多折腾了这么些年，怎么反而……你说，我是不是该从现在开始帮她研究猫科完美食谱？","category":"profile","status":"current","unlock":null,"order":3},{"id":"CN_004","title":"交谈3","text":"什么叫你的源石？我吃进去就是我的胃石了，帮助消化的，很重要好吗？哎哎哎干嘛干嘛？告诉你，我这小屋和存钱罐是一回事，取东西只能靠砸的。你难道要为了取几颗破石头，对我做那种事？","category":"profile","status":"current","unlock":null,"order":4},{"id":"CN_007","title":"信赖提升后交谈1","text":"是吗，凯尔希是为了救你才死的？那个在我被样本追得满地乱跑的时候也只会说“扫描中，进度50%”的凯尔希，知道救人？是你把她变成这样的吗，还是……是她自己？哼，那就好。","category":"profile","status":"current","unlock":null,"order":7},{"id":"CN_008","title":"信赖提升后交谈2","text":"可露希尔是藏你这儿了吧？她还有至少十个改装需求没给我处理呢，可不能跑——啧，平衡没调好而已，你不用劝我。我连喙都没了，还不能装液压钳保险杠喷火器和螺旋桨了吗？","category":"profile","status":"current","unlock":null,"order":8},{"id":"CN_009","title":"信赖提升后交谈3","text":"别再给我介绍羽兽了，我和那些泰拉原生动物没半点关系，我们充其量算是趋同演化的产物。你要是真在乎我那方面的身心健康，还不如找个像鸡蛋的玩意放进我的小屋里。我看你的热水壶就不错啊？","category":"profile","status":"current","unlock":null,"order":9},{"id":"CN_010","title":"闲置","text":"咯——咯咯——咯——","category":"profile","status":"current","unlock":null,"order":10},{"id":"CN_011","title":"干员报到","text":"你就是这群人类的首领？那你管管外面那个“人事干员”，非要把我的种族填成什么“黎博利”，我都说了一万遍了，我是鸡，原鸡，很难理解吗？","category":"profile","status":"current","unlock":null,"order":11},{"id":"CN_012","title":"观看作战记录","text":"你是说，他们这么折腾既不是为了捕食，也不是为了求偶？怎么跟凯尔希似的。","category":"profile","status":"current","unlock":null,"order":12},{"id":"CN_017","title":"编入队伍","text":"都长这么高干嘛！让让，让让，我看不见路了。","category":"combat","status":"current","unlock":null,"order":17},{"id":"CN_018","title":"任命队长","text":"你、你、你，还有你，都冲进去，动静越大越好。这就是计划。","category":"combat","status":"current","unlock":null,"order":18},{"id":"CN_019","title":"行动出发","text":"凯尔希，我们走！","category":"combat","status":"current","unlock":null,"order":19},{"id":"CN_020","title":"行动开始","text":"人类都长一个样吗？生物演化的重大退步啊。","category":"combat","status":"current","unlock":null,"order":20},{"id":"CN_021","title":"选中干员1","text":"当年给凯尔希找样本，我可都是自由发挥的。","category":"combat","status":"current","unlock":null,"order":21},{"id":"CN_022","title":"选中干员2","text":"你肯定有比指挥一只鸡更重要的事可做吧？","category":"combat","status":"current","unlock":null,"order":22},{"id":"CN_023","title":"部署1","text":"你们人类选窝的眼光，我还真是不敢恭维啊……","category":"combat","status":"current","unlock":null,"order":23},{"id":"CN_024","title":"部署2","text":"又不是孵蛋，为什么要待在这儿不能动？","category":"combat","status":"current","unlock":null,"order":24},{"id":"CN_025","title":"作战中1","text":"（激烈鸣叫的同时扇动仅剩的羽毛）","category":"combat","status":"current","unlock":null,"order":25},{"id":"CN_026","title":"作战中2","text":"我现在看起来就这么不好吃吗？唉。","category":"combat","status":"current","unlock":null,"order":26},{"id":"CN_027","title":"作战中3","text":"哦哟，连只上万年的老鸡都追不上？","category":"combat","status":"current","unlock":null,"order":27},{"id":"CN_028","title":"作战中4","text":"那你们还是当年有毛的时候更吓人。","category":"combat","status":"current","unlock":null,"order":28},{"id":"CN_029","title":"完成高难行动","text":"看到了吗，鸡到底还是这颗星球的霸主。","category":"combat","status":"current","unlock":null,"order":29},{"id":"CN_030","title":"3星结束行动","text":"你们该研究的都研究完了吧，样本我吃了啊……不行？我一只鸡管你们什么人道主义？","category":"combat","status":"current","unlock":null,"order":30},{"id":"CN_031","title":"非3星结束行动","text":"他们这逃跑速度跟蠕动似的，你们能忍住不追？","category":"combat","status":"current","unlock":null,"order":31},{"id":"CN_032","title":"行动失败","text":"凯尔希，想想办法，我要死了！","category":"combat","status":"current","unlock":null,"order":32},{"id":"CN_033","title":"进驻设施","text":"能跑的屋子是现在的什么流行趋势吗？","category":"profile","status":"current","unlock":null,"order":33},{"id":"CN_034","title":"戳一下","text":"别抓兜帽？不行，我爪子痒了。","category":"profile","status":"current","unlock":null,"order":34},{"id":"CN_036","title":"信赖触摸","text":"是是，风向标可太好玩了。那我的尾巴呢，就那么不好玩吗？","category":"profile","status":"current","unlock":null,"order":36},{"id":"CN_037","title":"标题","text":"明日方舟。","category":"profile","status":"current","unlock":null,"order":37},{"id":"CN_038","title":"新年祝福","text":"司康？呃，我刚吃掉最后一块。不打紧，你等一下——咯，咳咳，咯——好了，给你，吃吧。你那是什么表情？我只是让它稍稍接触了我的内饰，又没消化。赶紧给我吃！","category":"special","status":"current","unlock":null,"order":38},{"id":"CN_042","title":"问候","text":"给我掐羽管。","category":"special","status":"current","unlock":null,"order":42},{"id":"CN_043","title":"生日","text":"生日？那是蛋被生下来的日子，还是我破壳的日子啊？哈，别纠结了，俩日子我都不知道。我也不用知道你的生日是你出生的日子，还是你作为博士苏醒的日子。它是我能给你送沙虫腿的日子就成。","category":"special","status":"current","unlock":null,"order":43},{"id":"CN_044","title":"周年庆典","text":"最后的鸡，最后的人类，哈，听着还真是沉重。但那些早就死了、埋了、变了黎博利的鸡，我管不着，我只用对凯尔希负责。你呢？就一定要替所有人操心吗？至少偶尔，不能只对一个人负责吗？","category":"special","status":"current","unlock":null,"order":44}],"packs":[{"id":"jp","label":"Japanese","actors":["新井里美"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-japanese/main/current/char_4227_gallus/{voiceIdLower}.mp3"},{"id":"cn","label":"Mandarin","actors":["花玲"],"status":"current","audioTemplate":"https://raw.githubusercontent.com/arkpedia/arkpedia-voice-mandarin/main/current/char_4227_gallus/{voiceIdLower}.mp3"}]}}}