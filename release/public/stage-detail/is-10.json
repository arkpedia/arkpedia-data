ementalDamageRes":null,"attackInterval":2.8}},"famiglia_soldier":{"slug":"famiglia_soldier","name":"Famiglia Soldier","icon":"/enemies-icons/Famiglia Soldier.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Low-level mafiosi who obey the orders of their superiors unquestioningly. Their lives are hardly worth anything, but their deaths are sufficient cause for their famiglia to seek revenge.","abilities":["Increases Blood Debt by a miniscule amount when defeated"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1,"stats":{"hp":3500,"atk":320,"def":120,"res":10,"elementalRes":null,"elementalDamageRes":null,"attackInterval":1.8}},"famiglia_intimidator":{"slug":"famiglia_intimidator","name":"Famiglia Intimidator","icon":"/enemies-icons/Famiglia Intimidator.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Famiglia-trained strongmen, their imposing statures a bluff of sorts. In actuality, famiglie value their mastery of Siracusan language over raw violence.","abilities":["More likely to be attacked by allied units","Increases Blood Debt when defeated"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.5,"stats":{"hp":9000,"atk":500,"def":900,"res":10,"elementalRes":null,"elementalDamageRes":null,"attackInterval":3}},"famiglia_capo":{"slug":"famiglia_capo","name":"Famiglia Capo","icon":"/enemies-icons/Famiglia Capo.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Arts"],"flavourText":"A famiglia capo, highly respected and holding great power. Rumor has it that he never sets down his weapon, and though nobody knows where it might be hidden, some speculate that it may be inside his cigar.","abilities":["Increases Blood Debt whenever an enemy unit is defeated within range"],"levelCount":1,"level":0,"levelAssumed":false,"statsO