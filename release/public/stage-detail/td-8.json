ite":0,"potential":0,"skill_index":0,"skill_level":1},{"unit":"Wyvern Riding: Gloomweaver","unit_id":"trap_282_ctlspy","count":0,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1},{"unit":"Wyvern Riding: Rocksheller","unit_id":"trap_283_ctlblk","count":0,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1},{"unit":"Wyvern Riding: Zinogre","unit_id":"trap_284_ctlzog","count":0,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1},{"unit":"Wirebug Blitz","unit_id":"trap_275_pycfly","count":3,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true},{"unit":"Ironsilk Binding","unit_id":"trap_276_pycstp","count":3,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true},{"unit":"Not-Fully-Charged Counterattack","unit_id":"trap_273_pycgp","count":5,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true},{"unit":"Houei-Style Assault","unit_id":"trap_274_pyctrn","count":2,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true}]},"hasConditionalSpawns":false},"borrowedGeometryFrom":null,"enemyDetails":{"crestcaller":{"slug":"crestcaller","name":"Crestcaller","icon":"/enemies-icons/Crestcaller.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"The most commonly seen beast in the outskirts of Houei. Herd animals that feed on bamboo. Though small and weak, they reproduce very quickly, and are depicted in even the oldest annals of Houei.","abilities":["Temporary gains Frighten when nearby enemy units die.","Gains extended Frighten when <Lord of Thunder> is on the field."],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.9,"stats":{"hp":4000,"atk":300,"def":100,"res":20,"elementalRes":0,"elementalDamageRes":0,"attackInterval":2}},"shellsnap_newt":{"slug":"shellsnap_newt","name":"Shellsnap Newt","icon":"/enemies-icons/Shellsnap Newt.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Ranged","damageType":["Physical"],"flavourText":"Newts that dwell in the depths of the bamboo groves. Naturally timid, they carry around their own eggshells even after hatching, so that they may withdraw into them at any time.","abilities":["Curls up and stops attacking when your units are nearby, or if <Lord of Thunder> is on the field."],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.75,"stats":{"hp":8000,"atk":350,"def":250,"res":20,"elementalRes":0,"elementalDamageRes":0,"attackInterval":4}},"guzzlemuff":{"slug":"guzzlemuff","name":"Guzzlemuff","icon":"/enemies-icons/Guzzlemuff.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Large beasts that dwell upon snowy mountains. They are huge, and their strong forelimbs are able to effortlessly grab smaller beasts—adult humans, even—before swallowing them whole in their enormous mouths. Houei has many tales involving them, mostly used to scare children.","abilities":["Eats adjacent enemies with Weight 2 or below, increasing the Attack Range of its next attack and dealing AoE damage."],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.6,"stats":{"hp":12000,"atk":550,"def":800,"res":20,"elementalRes":0,"elementalDamageRes":0,"attackInterval":4}},"lord_of_thunder":{"slug":"lord_of_thunder","name":"Lord of Thunder","icon":"/enemies-icons/Lord of Thunder.webp","rank":"Boss","race":null,"movement":"Ground","attackPosition":"Melee and Ranged","damageType":["Arts"],"flavourText":"The Iju of the previous cycle, named for the thunder and lightning twisting around its form. Allegedly, it gathers countless Thunderbugs while it hunts. It can manipulate the electricity coursing over it to increase the strength of its leaps or enter a supercharged state.","abilities":["Charging State","[Charge Electricity] Charges in place, accumulating stacks of charge. Becomes supercharged at a certain number of charges.","[Thunderclap Roar] Stuns all other units in a large range.","[Lightning Leap] Charges up and leaps to the area with the most allied units, dealing area damage to allied units. Then charges up and leaps to the area covered by the fewest allied Attack Ranges and performs [Charge Electricity] 2 times.","[Thunderous Rampage] Charges up and locks on to an allied unit within a certain range, charging towards them (stopped by high ground), and dealing damage to allied units it passes through. Then, [Charge Electricity] twice.","[Homing Ball Lightning] Charges up and leaps to the area covered by the fewest allied Attack Ranges, then fires three lightning balls that deal Arts damage. Then performs [Charge Electricity] 2 times.","Supercharged State","[Thunder Armor] Immune to Paralysis, and gains status resistance.","[Scatter Lightning] Returns to Charging State after taking a certain amount of damage, or when it enters a mountable state.","[Greater Thunderclap Roar] Stuns all other units in a large range, and temporarily gains increased ATK.","[Chain Thunderclap] Charges up and leaps to the area with the most allied units, dealing area damage to allied units 3 times.","[Thunderous Gallop] Charges up and locks on to an allied unit within a certain range, charging towards them (stopped by high ground), and dealing damage to allied units it passes through.","[Spread Lightning] Charges up and leaps to the area covered by the fewest allied Attack Ranges, and fires six lightning balls that deal Arts damage.","Wyvern Riding State","[Wyvern Riding: Thunderous Rampage] After placing 'Wyvern Riding: Zinogre', Lord of Thunder charges directly towards the target, taking heavy damage if it hits high ground. If Lord of Thunder hits high ground twice while Wyvern Riding is active, it is temporarily toppled, reducing its DEF and RES, and its tail can be cut after dealing a certain amount of damage."],"levelCount"