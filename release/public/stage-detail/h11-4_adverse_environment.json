alRes":null,"elementalDamageRes":null,"attackInterval":2.5}},"rampaging_rotchaser":{"slug":"rampaging_rotchaser","name":"Rampaging Rotchaser","icon":"/enemies-icons/Rampaging Rotchaser.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical","Arts"],"flavourText":"Originium Arts creation of the Nachzehrer King. They do not understand the concept of healing, even if they are stopped. They exist only to create death. Thoughts are incompatible with death, and they never stop.","abilities":["Attacks cause the target to take Arts damage over time; effect removed when the target is healed"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1.4,"stats":{"hp":16000,"atk":700,"def":200,"res":20,"elementalRes":null,"elementalDamageRes":null,"attackInterval":1.8}},"advanced_sarkaz_wither_tank":{"slug":"advanced_sarkaz_wither_tank","name":"Advanced Sarkaz Wither Tank","icon":"/enemies-icons/Advanced Sarkaz Wither Tank.webp","rank":"Elite","race":"Machina","movement":"Ground","attackPosition":"Melee and Ranged","damageType":["Physical"],"flavourText":"Advanced equipment of the Nachzehrer army, clearing up obstacles for the army's march. Its attack power increases at close range. It is a powerful siege weapon, but its main role is to spread corruption.","abilities":["Only attacks ground units","Melee attacks deal more damage","After several attacks, the next attack will release Corruption"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.7,"stats":{"hp":15000,"atk":850,"def":750,"res":10,"elementalRes":null,"elementalDamageRes":null,"attackInterval":4.5}},"sarkaz_wither_maw":{"slug":"sarkaz_wither_maw","name":"Sarkaz Wither Maw","icon":"/enemies-icons/Sarkaz Wither Maw.webp","rank":"Elite","race":"Sarkaz","movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Elite member of the Nachzehrer army. Devours any obstacle in its way, including