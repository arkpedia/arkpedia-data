nts them from using skills"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1,"stats":{"hp":12,"atk":40,"def":100,"res":30,"elementalRes":null,"elementalDamageRes":null,"attackInterval":1}},"bloody_chef":{"slug":"bloody_chef","name":"Bloody Chef","icon":"/enemies-icons/Bloody Chef.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"More butcher than cook, the fleet's chefs are more adept at dismembering carcasses than making the aftermath fit for human consumption. The smell of blood from the kitchen is enough to make even the most hardened sailors lose their appetite.","abilities":["More likely to be attacked","Nearby enemies and <Saltheap Cannons> take far less Physical/Arts damage from sources in the direction of the shield"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.5,"stats":{"hp":15000,"atk":1000,"def":1500,"res":40,"elementalRes":0,"elementalDamageRes":0,"attackInterval":5}},"battleline_advance_guard":{"slug":"battleline_advance_guard","name":"Battleline Advance Guard","icon":"/enemies-icons/Battleline Advance Guard.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Heavily-armed personnel in charge of advancing the frontline. Typically made up of grumpy old veterans who take out their anger towards their superiors on anything standing in their way.","abilities":["Each time this unit is blocked, the next attack's ATK is greatly increased."],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":15000,"atk":1350,"def":1000,"res":0,"elementalRes":null,"elementalDamageRes":null,"attackInterval":5}},"battleline_breacher":{"slug":"battleline_breacher","name":"Battleline Breacher","icon":"/enemies-icons/Battleline Breacher.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":