ted"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":5000,"atk":500,"def":150,"res":0,"elementalRes":null,"elementalDamageRes":null,"attackInterval":3.2}},"urban_whirlwind_walker":{"slug":"urban_whirlwind_walker","name":"Urban 'Whirlwind Walker'","icon":"/enemies-icons/Urban 'Whirlwind Walker'.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Arts"],"flavourText":"A mass of fluffy critters fighting over cotton candy, and it's a little hard to tell where the fur ends and where the candyfloss begins. The main reason the Candy House grandpa is so angry is because they snatched his wig off too!","abilities":["Explodes on first attack, dealing AoE Arts damage and spawning Carmine Steam","Summons a Hot Spring 'Mischievous Rascal' and Fashion Street 'Hearty Heavy' upon dying"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1.5,"stats":{"hp":5000,"atk":1000,"def":250,"res":0,"elementalRes":null,"elementalDamageRes":null,"attackInterval":2}},"fluffy_buddy":{"slug":"fluffy_buddy","name":"'Fluffy Buddy'","icon":"/enemies-icons/'Fluffy Buddy'.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":null,"damageType":["Arts","Healing"],"flavourText":"If these gentle and difficult-to-perceive fluffy critters suddenly appear in front of you, don't be frightened! In the hot springs, atop the white clouds, and in your memories... Will you still think of them years down the line?","abilities":["Hidden in map, can be revealed by Carmine Steam or Pure White Steam","When in contact with Carmine Steam, its explosion produces more Carmine Steam on surrounding tiles and dealing Arts damage to nearby allied units","When in contact with Pure White Steam, its explosion produces more Pure White Steam on surrounding tiles and healing surrounding allied units"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.5,"stats":{"hp":500,"atk":500,"def":50,"res":50,"elementalRes":null,"elementalDamageRes":null,"attackInterval":5}},"fashion_street_ordinary_aviator":{"slug":"fashion_street_ordinary_aviator","name":"Fashion Street 'Ordinary Aviator'","icon":"/enemies-icons/Fashion Street 'Ordinary Aviator'.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"A fluffy critter that has found something nice from the aviation shop. It can fly, but it's not very good at it. Sometimes it can float up real high, but don't mistake it for a pink cloud!","abilities":["Low-Altitude Hovering","Can stack with a Fashion Street 'Hearty Heavy' and is capable of long-range attacks after combining"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.35,"stats":{"hp":18000,"atk":550,"def":50,"res":20,"elementalRes":null,"elementalDamageRes":null,"attackInterval":3.5}},"dolly_sovereign_of_sheep":{"slug":"dolly_sovereign_of_sheep","name":"Dolly, Sovereign of Sheep","icon":"/enemies-icons/Dolly, Sovereign of Sheep.webp","rank":"Boss","race":null,"movement":"Ground","attackPosition":"Ranged","damageType":["Arts"],"flavourText":"Sovereign of Sheep, traveling through the barrenlands and enjoying lava surfing. He sees everyone as equals, and is happy to leave their 'mark' on this great land. Now, it's time to have some fun with him!","abilities":["Unblockable; permanently in Low-Altitude Hovering","[Wool Barrier] Physical and Arts damage taken is significantly reduced when the Barrier is active. When Barrier value reaches 0, Dolly will lose his Barrier and fall, losing Low-Altitude Hovering and becoming disarmed.","Barrier value can be significantly reduced by Steam Soda Bottle explosions.","Dolly loses Barrier value when taking damage from Operators standing around a Decorative Geyser.","Airy Dolly","Prioritizes attacking ground units, and applies Carmine Steam on tiles the targets are on","[Elated Firebreathing] Locks onto a unit, and afterwards lets loose a vertical line of fire on that target's location from top to bottom, dealing Arts damage to all units on tiles in that column and generating Carmine Steam on the tiles","[Unintentional Explosion] Stops attacking to charge energy. After a period of time, ignites all Carmine Steam from right to left, dealing Arts and Burn to all targets in range","Frantic Dolly","Cannot attack, leaves Carmine Steam on tiles it travels over","Deals Arts damage and Burn to units he bumps into","Dolly no longer uses [Elated Firebreathing], and will only use [Unintentional Explosion] upon making landfall"],"levelCount":2,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.35,"stats":{"hp":60000,"atk":750,"def":800,"res":60,"elementalRes":null,"elementalDamageRes":null,"attackInterval":7}}},"dropIcons":{"4002":"/item-icons/originite_prime.png","30083":"/item-icons/manganese_ore.png","act27side_token_fur_rep_1":"/item-icons/fluffy_critter_wool_act27side_token_fur_rep_1.png"},"previewFile":"sl-8.webp","emergency":null,"devices":[{"col":5,"description":null,"hidden":false,"key":"trap_122_stmpq","kind":"device","name":"Decorative Geyser","row":4},{"col":6,"description":null,"hidden":false,"key":"trap_122_stmpq","kind":"device","name":"Decorative Geyser","row":4}],"playbackPaths":{"0":{"points":[[5,1],[6,2],[7,2],[8,2],[9,2],[9,1],[10,1]],"distances":[0,1.4142135623730951,2.414213562373095,3.414213562373095,4.414213562373095,5.414213562373095,6.414213562373095],"length":6.414213562373095,"breaks":[],"flying":false,"holds":[],"nodes":[[5,1],[10,1]]},"1":{"points":[[6,1],[6,2],[7,2],[8,2],[9,2],[9,1],[10,1]],"distances":[0,1,2,3,4,5,6],"length":6,"breaks":[],"flying":false,"holds":[],"nodes":[[6,1],[10,1]]},"2":{"points":[[9,1],[10,1]],"distances":[0,1],"length":1,"breaks":[],"flying":false,"holds":[],"nodes":[[9,1],[10,1]]},"3":{"points":[[5,6],[6,6],[7,6],[8,6],[9,6],[10,6]],"distances":[0,1,2,3,4,5],"length":5,"breaks":[],"flying":false