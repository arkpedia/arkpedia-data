ngs","Immune to Slow"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":20000,"atk":200,"def":325,"res":60,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1}},"sapid_auspice":{"slug":"sapid_auspice","name":"'Sapid Auspice'","icon":"/enemies-icons/'Sapid Auspice'.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":null,"damageType":["Physical"],"flavourText":"Abomination born of a convergence of Sapidity. Likes to hover over places where many gather, an auspicious symbol that drives out illness and keeps disaster away.","abilities":["Deals True damage to all enemy units in its path","Cannot be attacked, does not count towards the defeated enemies counter, will not deplete Life Points on leaving the field"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":3,"stats":{"hp":100,"atk":8000,"def":0,"res":0,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1.6}},"vapid_blight":{"slug":"vapid_blight","name":"'Vapid Blight'","icon":"/enemies-icons/'Vapid Blight'.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":null,"damageType":["Physical"],"flavourText":"Abomination born of a convergence of Vapidity. Likes to hover over places that are barren and broken, a symbol of misfortune.","abilities":["Deals True damage to all allied units in its path","Cannot be attacked, does not count towards the defeated enemies counter, will not deplete Life Points on leaving the field"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":3,"stats":{"hp":100,"atk":1500,"def":0,"res":0,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1.6}},"prosperity":{"slug":"prosperity","name":"Prosperity","icon":"/enemies-icons/Prosperity.webp","rank":"Elite","race":"Apparition","movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Abomination born of the people's longing for a better li