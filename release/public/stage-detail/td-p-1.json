ove. They weave extremely sticky webs between the bamboo stalks. A moment of carelessness will leave you bound, turning you into their next meal.","abilities":["Fires threads at the allied unit with the highest HP in Attack Range, dealing continuous Stun and Arts damage.","Wyvern Riding: Gloomweaver moves to target location and fires threads at the 3 enemies with the highest HP in Attack Range, dealing continuous Stun and Arts damage, then leaves the field."],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1,"stats":{"hp":18000,"atk":275,"def":660,"res":30,"elementalRes":0,"elementalDamageRes":0,"attackInterval":2.5}},"cautelotaur":{"slug":"cautelotaur","name":"Cautelotaur","icon":"/enemies-icons/Cautelotaur.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"A predator crafty by nature, with sightings of this species rarely reported. After feeding on the Chitotex Clawbeast, it uses the leftover carapace as a defensive tool, blocking fatal attacks in fights.","abilities":["After feeding on a <Chitotex Clawbeast> or <Keratex Clawbeast>, keeps its shell to use as a defensive tool, significantly lowering all damage except to the rear"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.75,"stats":{"hp":20000,"atk":1090,"def":480,"res":0,"elementalRes":null,"elementalDamageRes":null,"attackInterval":1.8}}},"dropIcons":{"4002":"/item-icons/originite_prime.png"},"previewFile":"td-p-1.webp","emergency":null,"devices":[{"col":4,"description":null,"hidden":false,"key":"trap_012_mine","kind":"device","name":"Interference Mine","row":4},{"col":5,"description":null,"hidden":false,"key":"trap_012_mine","kind":"device","name":"Interference Mine","row":3},{"col":7,"description":null,"hidden":false,"key":"trap_012_mine","kind":"device","name":"Interference Mine","row":4},{"col":8,"description":null,"hidden":false,"key":"trap_012_mine","kind":"device"