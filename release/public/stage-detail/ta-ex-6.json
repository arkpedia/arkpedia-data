lite":0,"potential":0,"skill_index":0,"skill_level":1}]},"hasConditionalSpawns":true},"borrowedGeometryFrom":null,"enemyDetails":{"draw_bow_screech":{"slug":"draw_bow_screech","name":"Draw Bow - Screech","icon":"/enemies-icons/Draw Bow - Screech.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":"Ranged","damageType":["Physical"],"flavourText":"Scriptgeist driven mad from the influence of Sui, whose original name was 'Bow'. The histories write: 'Where does the bowstring return, across thousands of miles to the Pass?' Every goodbye on that bridge was solemn and earnest. The sandstorm rages, and the bowstring wails, yet its bearer is nowhere to be seen, but for the lingering echoes of the string's ring.","abilities":["Hits 3 times","Prioritizes attacking allies on Glyph Tiles"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.7,"stats":{"hp":9000,"atk":210,"def":150,"res":5,"elementalRes":0,"elementalDamageRes":0,"attackInterval":4}},"wield_arms_oppress":{"slug":"wield_arms_oppress","name":"Wield Arms - Oppress","icon":"/enemies-icons/Wield Arms - Oppress.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Scriptgeist driven mad from the influence of Sui, whose original name was 'Soldier'. The histories write: 'Upon the peaks was the beast cornered and killed.' It was the battlefield where the Feranmut was hunted, and where countless soldiers were buried. Swords and spears lie buried, and tears of blood have stopped flowing. The bleached bones shall know spring no more.","abilities":["Vanishes when encountering another type of enemy, granting the target a portion of this unit's ATK, DEF, and RES, stacking up to 3 times per unit"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":1,"stats":{"hp":5400,"atk":500,"def":250,"res":5,"elementalRes":0,"elementalDamageRes":0,"attackInterval":3}},"frost_play_f