ats":{"hp":13000,"atk":350,"def":50,"res":10,"elementalRes":0,"elementalDamageRes":0,"attackInterval":2}},"drifting_aroma":{"slug":"drifting_aroma","name":"Drifting Aroma","icon":"/enemies-icons/Drifting Aroma.webp","rank":"Elite","race":"Apparition","movement":"Ground","attackPosition":null,"damageType":["Arts"],"flavourText":"Abomination born of the influence of a Sui Proxy. Boil chili and pepper in the pot, add some burdenbeast tallow, and let the aroma drift across town. Do not be too hasty when you tuck in, lest the heat burn your mouth.","abilities":["Continuously inflicts Arts damage and Burn to its surroundings","Immune to Slow"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":20000,"atk":200,"def":325,"res":60,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1}},"fasting":{"slug":"fasting","name":"'Fasting'","icon":"/enemies-icons/'Fasting'.webp","rank":"Elite","race":"Apparition","movement":"Ground","attackPosition":"Ranged","damageType":["Arts"],"flavourText":"Abomination born of the influence of a Sui Proxy. Originally a chopsticks holder left to collect dust for a century. The chopsticks are laid aside when food no longer has taste. Abhorring life and abhorring death, such loud laments summon Vapidity.","abilities":["Periodically summons 1 <Vapidity>"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.7,"stats":{"hp":15000,"atk":600,"def":400,"res":50,"elementalRes":0,"elementalDamageRes":0,"attackInterval":4}},"pseudomut":{"slug":"pseudomut","name":"Pseudomut","icon":"/enemies-icons/Pseudomut.webp","rank":"Elite","race":"Apparition","movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Similar in appearance to a Feranmut, it looks like an ancient 'God', but it is no more than a mere beast. It has become extinct in modern times, for its greed never diminished, despite no longer having the reputation of the Feranmuts to draw from.","abilities":["When blocked for the first time, devours the blocker and gains Low-Altitude Hovering","Returns devoured Operator when defeated"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.6,"stats":{"hp":35000,"atk":450,"def":1500,"res":40,"elementalRes":null,"elementalDamageRes":null,"attackInterval":4}},"sapid_auspice":{"slug":"sapid_auspice","name":"'Sapid Auspice'","icon":"/enemies-icons/'Sapid Auspice'.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":null,"damageType":["Physical"],"flavourText":"Abomination born of a convergence of Sapidity. Likes to hover over places where many gather, an auspicious symbol that drives out illness and keeps disaster away.","abilities":["Deals True damage to all enemy units in its path","Cannot be attacked, does not count towards the defeated enemies counter, will not deplete Life Points on leaving the field"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":3,"stats":{"hp":100,"atk":8000,"def":0,"res":0,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1.6}},"vapid_blight":{"slug":"vapid_blight","name":"'Vapid Blight'","icon":"/enemies-icons/'Vapid Blight'.webp","rank":"Normal","race":"Apparition","movement":"Ground","attackPosition":null,"damageType":["Physical"],"flavourText":"Abomination born of a convergence of Vapidity. Likes to hover over places that are barren and broken, a symbol of misfortune.","abilities":["Deals True damage to all allied units in its path","Cannot be attacked, does not count towards the defeated enemies counter, will not deplete Life Points on leaving the field"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":3,"stats":{"hp":100,"atk":1500,"def":0,"res":0,"elementalRes":0,"elementalDamageRes":0,"attackInterval":1.6}},"prosperity":{"slug":"prosperity","name":"Prosperity","icon":"/enemies-icons/Prosperity.webp","rank":"Elite","race":"Apparition","movement":"G