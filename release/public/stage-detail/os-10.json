_10142_xdturt","slug":"frostdillo","name":"Frostdillo","database_level":0},{"enemy_id":"enemy_10144_xdelk","slug":"greathorn_rhuul","name":"Greathorn Rhuul","database_level":0},{"enemy_id":"enemy_1574_xdagt","slug":"maiden_of_snow_and_ice","name":"Maiden of Snow and Ice","database_level":0},{"enemy_id":"enemy_1575_xdmon","slug":"kjeragandr","name":"Kjeragandr","database_level":0},{"enemy_id":"enemy_1576_spbell","slug":"karlan_saintess","name":"Karlan Saintess","database_level":0},{"enemy_id":"enemy_1577_iceball","slug":"coldness","name":"'Coldness'","database_level":0},{"enemy_id":"enemy_1578_icecage","slug":"saintesss_snowrobe","name":"Saintess's Snowrobe","database_level":0}],"suppliedUnits":{"fixed_squad":[],"deployable_tokens":[{"unit":"Avalanche Trigger System","unit_id":"trap_267_xdmac1","count":3,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true},{"unit":"Snow Retention System","unit_id":"trap_268_xdmac2","count":2,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true},{"unit":"Avalanche Control System","unit_id":"trap_269_xdmac3","count":2,"level":1,"elite":0,"potential":0,"skill_index":0,"skill_level":1,"hidden":true}]},"hasConditionalSpawns":false},"borrowedGeometryFrom":null,"enemyDetails":{"snowchild":{"slug":"snowchild","name":"Snowchild","icon":"/enemies-icons/Snowchild.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Tiny creatures that hop around the uninhabited Kjerag snowfields. Rather careless and prone to accidents. In spring, their coat turns from snow-white to a dusty gray and grows fluffy.","abilities":["Takes extra damage on colliding with high ground"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.6,"stats":{"hp":5500,"atk":200,"def":200,"res":10,"elementalRes":0,"elementalDamageRes":0,"attackInterval":5}},"fluffy_snowball":{"slug":"fluffy_snowball","name":"Fluffy Snowball","icon":"/enemies-icons/Fluffy Snowball.webp","rank":"Normal","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Creatures indigenous to Kjerag, popular amongst tourists for their soft, fluffy fur and friendly nature. Some claim that their fur was once the main clothing material for the people of Kjerag, but there is no evidence to verify this claim.","abilities":["Absorbs passing Snowchildren to increase its weight, HP, ATK, DEF, and RES","Returns to initial form on colliding with high ground"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":5500,"atk":200,"def":200,"res":10,"elementalRes":0,"elementalDamageRes":0,"attackInterval":5}},"cave_snowsprite":{"slug":"cave_snowsprite","name":"Cave Snowsprite","icon":"/enemies-icons/Cave Snowsprite.webp","rank":"Normal","race":null,"movement":"Flying","attackPosition":"Ranged","damageType":["Arts"],"flavourText":"Nocturnal creatures that dwell in the caves of Kjerag, able to fly in even the fiercest blizzards. Their main diet is berries, moss, and mushrooms. Kjerag hunter lore says that encountering them in the forests is a sign that the hunt will go well.","abilities":["Flying unit.","Can land on deployable high ground, where its attacks become ranged and deal Arts damage","Increases Avalanche Warning Index when landing in an Avalanche Area","Takes off again after some time"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.6,"stats":{"hp":4500,"atk":200,"def":100,"res":10,"elementalRes":0,"elementalDamageRes":0,"attackInterval":3}},"frostdillo":{"slug":"frostdillo","name":"Frostdillo","icon":"/enemies-icons/Frostdillo.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Creatures with heavy shells on their backs. Despite their intimidating appearance, they are actually docile and friendly and can be trained to serve as burdenbeasts. They can get back on their feet even when flipped on their backs.","abilities":["Loses all DEF and RES and becomes unable to move for some time on colliding with high ground"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.5,"stats":{"hp":8000,"atk":500,"def":3200,"res":80,"elementalRes":0,"elementalDamageRes":0,"attackInterval":3}},"greathorn_rhuul":{"slug":"greathorn_rhuul","name":"Greathorn Rhuul","icon":"/enemies-icons/Greathorn Rhuul.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Melee","damageType":["Physical"],"flavourText":"Burdenbeasts with massive horns on their heads. Their unique name comes from Kjeragandr's blessing. It is said that someone once witnessed Her mumbling to this creature: 'Rhuul, rhuul...' Since then, 'Rhuul' has become its new name.","abilities":["[Clash of Brawn] Performs Charged Attacks and tries to push units that block it","After charging, deals damage to the target and pushes it back one tile; if unable to push, deals more damage and stuns the target for several seconds","Charge can be interrupted by negative statuses like Stun and Shift"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.7,"stats":{"hp":15000,"atk":800,"def":500,"res":20,"elementalRes":0,"elementalDamageRes":0,"attackInterval":5}},"karlan_saintess":{"slug":"karlan_saintess","name":"Karlan Saintess","icon":"/enemies-icons/Karlan Saintess.webp","rank":"Elite","race":null,"movement":"Ground","attackPosition":"Ranged","damageType":["Arts"],"flavourText":"The chosen one. She rings her bell, again and again, for you, and for Her.","abilities":["Revives when defeated","First Phase","[Pious Prayer] Prays at specific locations, dealing damage to and paralyzing the <Maiden of Snow and Ice> when prayer is complete","Prayer can be interrupted by negative statuses like Stun and Shift","Ritual enters the second phase when all prayer steps are complete","Phase 2","[Heart of Breakthrough] Periodically attacks, breaking the protection of <Kjeragandr> and allowing the <Maiden of Snow and Ice> to be attacked"],"levelCount":1,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.8,"stats":{"hp":10000,"atk":1000,"def":250,"res":15,"elementalRes":0,"elementalDamageRes":0,"attackInterval":5}},"kjeragandr":{"slug":"kjeragandr","name":"Kjeragandr","icon":"/enemies-icons/Kjeragandr.webp","rank":"Boss","race":null,"movement":"Ground","attackPosition":"Ranged","damageType":["Arts"],"flavourText":"As white, as beautiful, as vast as the great icefields, She is mesmerizing and magnificent, beyond reckoning then, now, and forever.","abilities":["Periodically gives <Maiden of Snow and Ice> protection, preventing her from being attacked","Attacks together with <Maiden of Snow and Ice>, dealing Arts damage to units in an entire row and inflicting Cold","Partners with <Maiden of Snow and Ice> to unleash [Rimechill] and [Wintertide], boosting skill effects","[Silent Whiteout] Deals heavy Arts damage to all units on the field and inflicts Cold, shared by all allied units; Cold duration increases with each cast; can be cast when not on the field"],"levelCount":2,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.1,"stats":{"hp":125000,"atk":600,"def":600,"res":40,"elementalRes":0,"elementalDamageRes":0,"attackInterval":7}},"maiden_of_snow_and_ice":{"slug":"maiden_of_snow_and_ice","name":"Maiden of Snow and Ice","icon":"/enemies-icons/Maiden of Snow and Ice.webp","rank":"Boss","race":null,"movement":"Ground","attackPosition":"Ranged","damageType":["Physical"],"flavourText":"The eons and the frost both weigh upon her. Beneath her silent visage, you see the complexity of her regard, regret, relief, and resolve.","abilities":["Can perform long-ranged attacks that inflict Cold","Periodically gains increased ATK and DEF","After a long time has passed, deals Arts splash damage to all allied units on the field, and drains all Life Points","[Rimechill] Stops attacking, summoning several <'Coldness'> to lock on to the location of the <Karlan Saintess> and release there; the number of <'Coldness'> increases with each cast","<'Coldness'> takes shape after some time and flies towards the target; if not destroyed before it reaches the target, deals Arts damage in a large area and increases Avalanche Warning Index in the area","When <Kjeragandr> is on the field, also summons an equivalent number of <'Coldness'> and releases them at a targeted Operator","First Phase","Cannot be attacked; can only be damaged by [Pious Prayer] from the <Karlan Saintess>","Phase 2","[Wintertide] Stops attacking whenever HP drops by a certain percentage, summoning <Saintess' Snowrobe> to imprison the <Karlan Saintess>; during this time, <Kjeragandr> will continuously summon icicles to attack allied units, increasing the Avalanche Warning Index of areas where the icicles land","<Saintess' Snowrobe> continuously loses HP, releasing the <Karlan Saintess> when destroyed, allowing her to move again"],"levelCount":2,"level":0,"levelAssumed":false,"statsOverridden":false,"moveSpeed":0.1,"stats":{"hp":125000,"atk":600,"def":600,"res":40,"elementalRes":0,"elementalDamageRes":0,"attackInterval":7}}},"dropIcons":{"4002":"/item-icons/originite_prime.png","act46side_token_detector":"/item-icons/multi_functional_snow_detector.png"},"previewFile":null,"emergency":null,"devices":[{"col":5,"description":"Enemies increase the Avalanche Warning Index when entering the Avalanche Area Deploying Operators within the area will also increase the Index's value","hidden":false,"key":"trap_265_xdice1","kind":"device","name":"Saintess Statue","row":4},{"col":9,"description":"Enemies increase the Avalanche Warning Index when entering the Avalanche Area Deploying Operators within the area will also increase the Index's value","hidden":false,"key":"trap_265_xdice1","kind":"device","name":"Saintess Statue","row":2},{"col":15,"description":"Enemies increase the Aval