[{"time":3.06,"text":"And I felt it for ages"},{"time":6.8100000000000005,"text":"Before she showed me the path"},{"time":10.06,"text":"My heart was in pieces"},{"time":13.88,"text":"Everything was falling apart"},{"time":18.87,"text":"“он ушел”"},{"time":21.3,"text":"“lo odio”"},{"time":24.02,"text":"“così felice”"},{"time":26.34,"text":"“I know you tried hard”"},{"time":29.29,"text":"“Siempre te amaré”"},{"time":31.59,"text":"“Das Leben ist hart”"},{"time":33.88,"text":"“Я страдаю”"},{"time":38.83,"text":"Stuck in the depths of darkness"},{"time":42.83,"text":"She called my name"},{"time":46.28,"text":"Casted the gaze"},{"time":50.21,"text":"Blank as the sun"},{"time":54.33,"text":"Revealing my path"},{"time":63.03,"text":"(Footsteps)"},{"time":68.84,"text":"Huh"},{"time":70.69,"text":"I feel it."}]