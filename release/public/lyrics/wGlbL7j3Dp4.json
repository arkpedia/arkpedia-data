[{"time":29.922,"text":"As we wade into the golden gleaming light"},{"time":34.909,"text":"Victoria, for you we fight"},{"time":38.617,"text":"We are the ones who always rise"},{"time":46.72,"text":"A hero born to ease our plight"},{"time":50.728,"text":"To light within, ignite"},{"time":59.485,"text":"Ever the battle"},{"time":63.064,"text":"We struggle and saddle on"},{"time":67.321,"text":"Honor and ardor lost"},{"time":71.165,"text":"An onerous cost"},{"time":75.226,"text":"To reawaken"},{"time":79.015,"text":"This part so forsaken in us"},{"time":83.29,"text":"Though we may fall…we will rise again."},{"time":97.453,"text":"We face our failures, standing side by side"},{"time":102.798,"text":"Arise my friends we’ll turn this tide"},{"time":106.704,"text":"To arms we stride with head held high/towards the sky"},{"time":114.663,"text":"To rebuild our hope anew"},{"time":124.023,"text":"With everything we made"},{"time":128.058,"text":"The sacrifice we gave"},{"time":132.049,"text":"To watch it fade away"},{"time":140.184,"text":"Now arm in arm my friend"},{"time":144.212,"text":"Together we can mend"},{"time":148.175,"text":"And build our strength again"},{"time":154.891,"text":"Awaken"},{"time":156.77,"text":"Me again"},{"time":158.821,"text":"A churning tide it swells within"},{"time":162.764,"text":"Awaken"},{"time":164.73,"text":"We are the ones who will rise."},{"time":173.775,"text":"We raise the banner"},{"time":177.021,"text":"With thunder we clamor on"},{"time":181.235,"text":"Honor and ardor lost"},{"time":185.206,"text":"An onerous cost"},{"time":189.236,"text":"To reawaken"},{"time":192.941,"text":"A hope so forsaken in us"},{"time":197.2,"text":"Though we may fall we will rise again, reborn"},{"time":209.282,"text":"Victoria, there’s no need to mourn"},{"time":212.927,"text":"We will mend"},{"time":214.829,"text":"And defend"},{"time":217.25,"text":"We will ascend reborn"},{"time":221.105,"text":"Awaken"},{"time":222.796,"text":"Me again"},{"time":224.897,"text":"A turning tide it swells within"},{"time":228.838,"text":"Awaken"},{"time":231.02,"text":"We are the ones who will rise again."},{"time":237.93,"text":"We are reborn again"}]