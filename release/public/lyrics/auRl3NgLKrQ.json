[{"time":22.75,"text":"Stop the fire"},{"time":25.5,"text":"A mockingbird sings"},{"time":27.19,"text":"My name, laughing, calling me"},{"time":30.57,"text":"Who’s the liar?"},{"time":33.33,"text":"Maybe you’re in my bones, my blood"},{"time":38.04,"text":"Take it all"},{"time":40.67,"text":"Filling me up, I’m empty"},{"time":43.73,"text":"Heartbeats"},{"time":44.63,"text":"Counting down, if I could stop the clock, you’d win"},{"time":54.76,"text":"So whisper the names of your enemies"},{"time":58.9,"text":"There’s a darker cloud"},{"time":60.19,"text":"Than what you left inside"},{"time":62.18,"text":"Growing like the winter wind"},{"time":65.06,"text":"I can bear your weight"},{"time":66.41,"text":"Your words and selfish pride"},{"time":68.21,"text":"You will not escape this sin"},{"time":71.76,"text":"This is my revenge"},{"time":73.03,"text":"I’ll take us to the end"},{"time":74.98,"text":"You can watch beneath my skin"},{"time":77.89,"text":"Fear is just a smokescreen, heat is still my friend"},{"time":81.08,"text":"I will use the burn to win"},{"time":89.65,"text":"Whispering"},{"time":92.17,"text":"Falling into a sleepwalk"},{"time":95.08,"text":"Pacing carefully"},{"time":97.07,"text":"I don’t dream"},{"time":99.8,"text":"Closing each chapter without pain"},{"time":104.57,"text":"Silent watch"},{"time":107.17,"text":"There was a time I had a family, everything"},{"time":112.15,"text":"Frozen halt"},{"time":115,"text":"Oh, my numb epiphany"},{"time":119.38,"text":"So whisper the names of your enemies"},{"time":123.52,"text":"There’s a darker cloud"},{"time":124.94,"text":"Than what you left inside"},{"time":126.9,"text":"Growing like the winter wind"},{"time":129.58,"text":"I can bear your weight"},{"time":131.12,"text":"Your words and selfish pride"},{"time":133.02,"text":"You will not escape this sin"},{"time":136.35,"text":"This is my revenge"},{"time":137.74,"text":"I’ll take us to the end"},{"time":139.63,"text":"You can watch beneath my skin"},{"time":1