[{"time":2,"text":"作词：Adam Gubman"},{"time":4,"text":"作曲：Adam Gubman"},{"time":6.24,"text":"Open oceans, crushing waters"},{"time":9.24,"text":"Deep regrets of mothers daughters"},{"time":11.76,"text":"Open rifts, to cast adrift a"},{"time":14.47,"text":"Ghost ship sinking"},{"time":15.92,"text":"abyssal dreaming"},{"time":17.5,"text":"To sleep, to fall on a safe shore...."},{"time":23.26,"text":"Holding a paper wall"},{"time":24.94,"text":"building a damn, they are flooding the circuits"},{"time":27.91,"text":"to find who I am"},{"time":29.37,"text":"Make a list, write it down, in time"},{"time":34.48,"text":"Sometimes we need it all, sometimes, resign"},{"time":37.48,"text":"To a world where the center is never a line"},{"time":40.64,"text":"Make a move, take it back, it's mine"},{"time":45.73,"text":"Gather raindrops"},{"time":46.97,"text":"I'm filling the ocean up"},{"time":48.81,"text":"Take every part of me"},{"time":50.68,"text":"(Take it all and...)"},{"time":52.34,"text":"Fit it together"},{"time":53.42,"text":"I'm building a boat"},{"time":55.5,"text":"Cheers as the horns resound"},{"time":56.97,"text":"Echos of those who drown"},{"time":58.53,"text":"Carry myself, let me"},{"time":59.91,"text":"Dream of deep stay asleep..."},{"time":71.75,"text":"Find the break"},{"time":72.54,"text":"water, warm"},{"time":73.34,"text":"Keep it calm"},{"time":74.23,"text":"Be afraid to rattle the cage Take a risk"},{"time":78.91,"text":"Take a dive"},{"time":79.66,"text":"Take it down"},{"time":80.4,"text":"suddenly surrender, take back everything"},{"time":85.52,"text":"From the open shore"},{"time":87.02,"text":"I will learn to fly"},{"time":88.65,"text":"Soaring past the great divide"},{"time":91.58,"text":"Voices that surface seem to call out all the lies"},{"time":98.13,"text":"Is it still a sin"},{"time":99.81,"text":"If I let them in"},{"time":101.45,"text":"As they sail to calmer tides"},{"time":105.41,"text":"I'll awaken what's asleep inside"},{"time":137.65,"tex