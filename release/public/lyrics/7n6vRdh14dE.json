[{"time":23.292,"text":"How many winters in a gaze,"},{"time":27.925,"text":"Lost inside a maze?"},{"time":31.094,"text":"And how many feelings unspoken,"},{"time":35.627,"text":"Held in this hand?"},{"time":39.06,"text":"The weight of the old skies on my shoulders,"},{"time":43.791,"text":"Sunlight in disguise"},{"time":46.008,"text":"Who would have known"},{"time":47.591,"text":"There's an end to eternity?"},{"time":53.677,"text":"The lone tale is no more"},{"time":57.277,"text":"As a breeze brushes by"},{"time":61.294,"text":"As the days drift on by"},{"time":65.06,"text":"Found a steady shore of trust"},{"time":69.294,"text":"In this vast world"},{"time":72.976,"text":"As we walk side by side"},{"time":76.859,"text":"The script is fading away"},{"time":80.943,"text":"And the frozen dawn streams forth"},{"time":85.227,"text":"Into the new"},{"time":108.127,"text":"Now I can see"},{"time":111.076,"text":"You were always there for me"},{"time":115.093,"text":"Setting my burden down,"},{"time":117.777,"text":"A quiet spring has come"},{"time":119.724,"text":"I am in a brand new chapter"},{"time":148.243,"text":"As a breeze brushes by"},{"time":152.027,"text":"As the days drift on by"},{"time":156.109,"text":"Found a steady shore of trust"},{"time":160.342,"text":"In this vast world"},{"time":164.092,"text":"As we walk side by side"},{"time":168.275,"text":"The script is fading away"},{"time":172.175,"text":"And the frozen dawn streams forth"},{"time":175.927,"text":"The weight of yesterday"},{"time":180.141,"text":"Will never hold me again"},{"time":183.977,"text":"Cause when the tides turn and sway"},{"time":188.21,"text":"We'll know our way"},{"time":192.026,"text":"Don't need to be afraid"},{"time":195.993,"text":"Set sail and row away"},{"time":199.976,"text":"Never felt so safe,"},{"time":202.646,"text":"With you, I can step into the new"}]