[{"time":16.951,"text":"乱成线"},{"time":19.563,"text":"不过山茶花落地"},{"time":23.871,"text":"三菩提"},{"time":27.072,"text":"无意识而无依"},{"time":31.68,"text":"如是 我闻过"},{"time":38.803,"text":"如是 我闻过"},{"time":44.345,"text":"（一）花一木皆成因"},{"time":60.425,"text":"梦化成现实困住我"},{"time":64.681,"text":"无所从又无所去躲"},{"time":68.375,"text":"梦化成现实困住我"},{"time":72.339,"text":"万生皆因果"},{"time":74.953,"text":"惦朝霞"},{"time":82.233,"text":"乱成麻"},{"time":90.69,"text":"非以身普渡 又何度泞路"},{"time":98.238,"text":"兀自聊以束 亦是空和无"},{"time":105.373,"text":"不知何求 与执念为谋"},{"time":110.071,"text":"贪和念无谓是色即空 非空"},{"time":120.136,"text":"无知所故 与执念为伍"},{"time":124.797,"text":"淘尽灰色泥泞路"},{"time":133.231,"text":"固执"},{"time":149.685,"text":"非以身普渡 何度泞路"},{"time":153.311,"text":"兀自聊以束 是无亦是空"},{"time":156.999,"text":"非以身普渡 何度泞路"},{"time":160.725,"text":"是无亦是空"},{"time":175.599,"text":"是空亦是无"},{"time":191.387,"text":"坠落又怎罔顾"},{"time":194.521,"text":"虔诚如一"},{"time":196.184,"text":"将往事送菩提"},{"time":197.699,"text":"无所依 无往"},{"time":199.828,"text":"无妨 且听着哭啼 走进雾里"},{"time":203.489,"text":"穿到界外断了人间雨"},{"time":208.833,"text":"我盼如一"},{"time":210.859,"text":"往事能送菩提"},{"time":212.522,"text":"无所依 无往"},{"time":214.601,"text":"无妨 且走一遭"},{"time":216.264,"text":"让那褪去的如泡影般惨⽩的"},{"time":220.001,"text":"化成儿时听说"},{"time":222.099,"text":"随花骨朵而掉落"}]