[{"time":12.79,"text":"表演者："},{"time":14.79,"text":"Zongli（宗立）—— 人声、键盘类乐器"},{"time":16.79,"text":"Jiaju（嘉琚）—— 琵琶"},{"time":18.79,"text":"Yang （王阳）—— 二胡"},{"time":23.79,"text":"站在岔口路上权衡对与错"},{"time":27.09,"text":"犹豫不决咿呀"},{"time":31.41,"text":"如果所有计算准确无错"},{"time":34.62,"text":"是否就能来到地图上的地方"},{"time":38.58,"text":"犹疑呀"},{"time":42.09,"text":"算盘敲打"},{"time":43.32,"text":"哟咿呀"},{"time":50.13,"text":"公式套用错啦"},{"time":53.52,"text":"人生就像是掷了一个又一个骰子"},{"time":57.42,"text":"管它会带我去哪儿呢"},{"time":62.07,"text":"你说一就不二"},{"time":63.09,"text":"我却想独一无二"},{"time":65.19,"text":"出手 转呀转"},{"time":68.88,"text":"不要停下——"},{"time":72.33,"text":"随意呀"},{"time":103.92,"text":"无人的街道上特别寂静"},{"time":107.37,"text":"犹豫不决咿呀"},{"time":111.45,"text":"如果我只听从内心的声音"},{"time":114.66,"text":"是否就能来到愿望中的地方"},{"time":118.17,"text":"时空就像出了一个又一个谜题"},{"time":122.04,"text":"上天他也掷骰子哦？"},{"time":126.09,"text":"你要百里挑一"},{"time":127.83,"text":"我却说九九归一"},{"time":129.99,"text":"出发转呀转"},{"time":133.62,"text":"不要停下——"},{"time":136.89,"text":"随意随意呀"},{"time":152.67,"text":"将骰子抛向空中缓缓落下"},{"time":160.14,"text":"无限可能的叠加态"},{"time":167.82,"text":"人生就像 掷了一个又一个骰子"},{"time":171.72,"text":"何必去在乎输赢呢"},{"time":175.56,"text":"别害怕不一样"},{"time":177.33,"text":"谁又能给谁下定义"},{"time":179.55,"text":"出发 闯一闯"},{"time":183.12,"text":"不要停下——"},{"time":186.33,"text":"随意随意呀"}]