[{"time":8.855,"text":"A fowl who's flying through the wind"},{"time":12.107,"text":"Still needs a place to land"},{"time":15.772,"text":"This world is a fragile thing"},{"time":19.204,"text":"So darling take my hand"},{"time":23.036,"text":"And when the river starts to flood"},{"time":26.515,"text":"And water starts to rise"},{"time":30.403,"text":"I'll be there to pick you up"},{"time":33.708,"text":"And pull you from the tide"},{"time":37.573,"text":"I'll be"},{"time":39.988,"text":"Your Guardian angel"},{"time":44.276,"text":"I'll keep"},{"time":47.515,"text":"You safe from danger"},{"time":51.523,"text":"A place where you don't worry"},{"time":55.14,"text":"Gentle, safe and holy"},{"time":58.044,"text":"I'll pick up your broken pieces"},{"time":62.076,"text":"And rewrite all the pages"},{"time":65.5,"text":"It's dark outside"},{"time":67.363,"text":"I'll light the fire"},{"time":69.091,"text":"and help you find"},{"time":70.924,"text":"The sanctuary inside"},{"time":76.595,"text":"Ah"},{"time":81.395,"text":"The sanctuary inside"},{"time":83.58,"text":"Ah"},{"time":88.508,"text":"The sanctuary inside"},{"time":100.621,"text":"A treehouse just for you and me"},{"time":104.124,"text":"with all our favorite things"},{"time":107.965,"text":"A secret magic melody"},{"time":112.285,"text":"That only we can sing"},{"time":115.069,"text":"and outside when it's dark and rains"},{"time":118.362,"text":"Like a flashlight guide you home again"},{"time":122.364,"text":"Lock our castle, toss the key"},{"time":125.65,"text":"Where we are queen and king"},{"time":130.5,"text":"I'll be"},{"time":132.291,"text":"Your Guardian angel"},{"time":136.092,"text":"I'll keep"},{"time":138.749,"text":"You safe from danger"},{"time":147.307,"text":"I've walked the path you're on"},{"time":154.907,"text":"Know you're not alone"},{"time":161.492,"text":"I'll be the map that leads you to"},{"time":168.324,"text":"find the sanctuary inside"},{"time":177.436,"text":"place where you don't worry"},{"time":180.516,"text":"Gentle, safe and holy"},{"time":183.69,"text":"I'll pick up your broken pieces"},{"time":188.02,"text":"And rewrite all the pages"},{"time":190.9,"text":"It's dark outside"},{"time":192.701,"text":"I'll light the fire"},{"time":194.291,"text":"and help you find"},{"time":196.164,"text":"The sanctuary inside"},{"time":201.714,"text":"Ah"},{"time":206.691,"text":"The sanctuary inside"},{"time":208.796,"text":"Ah"},{"time":214.452,"text":"The sanctuary inside"}]