[{"time":1.099,"text":"That night with a hope colored light"},{"time":10.134,"text":"Shone you against the bleak"},{"time":18.59,"text":"Last night how your eyes burned so bright"},{"time":27.332,"text":"Now to the sky they seek"},{"time":36.102,"text":"Why must fate write in scarlet"},{"time":44.87,"text":"Cured by blood that the stars let"},{"time":52.654,"text":"In the morrow"},{"time":56.741,"text":"Shall this sorrow"},{"time":61.246,"text":"Finally cease"},{"time":65.606,"text":"Come my peace"},{"time":70.95,"text":"That night like a candle's last light"},{"time":79.566,"text":"Flickered our laughs and dreams"},{"time":88.182,"text":"Lost knight how your song echoed bright"},{"time":96.804,"text":"Now you in silence sleep"},{"time":105.662,"text":"Why must fate dance our threads so"},{"time":114.183,"text":"Tangled close just to spread so"},{"time":122.045,"text":"In the morrow"},{"time":126.013,"text":"Pray let sorrow"},{"time":130.43,"text":"Part us too"},{"time":134.805,"text":"Face the truth"},{"time":175.47,"text":"Why must fate write in scarlet"},{"time":183.374,"text":"Cured by blood that the stars let"},{"time":191.374,"text":"In the morrow"},{"time":195.892,"text":"Pray let sorrow"},{"time":199.966,"text":"Part us too"},{"time":203.997,"text":"Embrace the truth"}]