[{"time":1.097,"text":"铁花飞"},{"time":3.13,"text":"A frozen breath"},{"time":6.434,"text":"A calloused hand"},{"time":9.701,"text":"Walking through a peaceful neighborhood"},{"time":16.584,"text":"Isn't it beautiful?"},{"time":19.701,"text":"Such a beautiful"},{"time":23.535,"text":"Such a beautiful vibrancy"},{"time":29.88,"text":"I am alright"},{"time":33.063,"text":"I am content"},{"time":36.248,"text":"Looking through an old kaleidoscope"},{"time":43.18,"text":"Isn't it laughable?"},{"time":47.03,"text":"The pain we held close"},{"time":50.197,"text":"Dissolves into smoke readily"},{"time":56.462,"text":"As I'm finally on the receiving side of misfortune"},{"time":62.964,"text":"I can see your reasons"},{"time":66.38,"text":"And your clingy demons"},{"time":69.597,"text":"Like a rotten mandarin"},{"time":72.763,"text":"Inside, we had good intentions"},{"time":76.296,"text":"I may be still unripened"},{"time":79.729,"text":"But I'm not afraid"},{"time":82.563,"text":"在这一刻，我的心平静如水"},{"time":90.129,"text":"没有谁能迫我退悔"},{"time":96.163,"text":"四面楚歌，这颗心无惧无畏"},{"time":103.364,"text":"铁花飞，飘逸不残灰"},{"time":110.846,"text":"千年之后还剩下什么？"},{"time":114.297,"text":"灵魂的重量又怎能取舍"},{"time":117.446,"text":"有共存才有未来可说"},{"time":120.829,"text":"不一定牵着手"},{"time":121.963,"text":"但一定永远向前走"},{"time":124.097,"text":"正确了又能证明什么？"},{"time":127.263,"text":"就算能从过去找出差错"},{"time":130.746,"text":"身世境遇不由人选择"},{"time":134.179,"text":"有理解就足够"},{"time":135.463,"text":"盼日夜细水长流"},{"time":141.296,"text":"Let our memories unite"},{"time":144.496,"text":"Then maybe we'll see a new sight"},{"time":148.929,"text":"Yes we're both right"},{"time":150.829,"text":"I know we're both right"},{"time":153.497,"text":"In the tiny birdcage we divide"},{"time":158.096,"text":"Seeing the world with my own eyes"},{"time":159.994,"text":"And for a minute I was embarrassed by my short insight"},{"time":163.13,"text":"All this time I was so focused on myself"},{"time":166.563,"text":"Making sure this strongest strongest woman was all they saw"},{"time":170.146,"text":"Right?"},{"time":171.079,"text":"小时候只是服从"},{"time":172.379,"text":"成长过程中开始疑问"},{"time":174.026,"text":"为什么你不再是我印象中那样完美无缺？"},{"time":177.347,"text":"长大后终于理解"},{"time":178.7,"text":"逞强也是一种爱的表现"},{"time":180.499,"text":"呵，原谅你，也原谅我自己"},{"time":182.685,"text":"在这一刻，我的心平静如水"},{"time":190.102,"text":"没有谁能迫我退悔"},{"time":196.151,"text":"四面楚歌，这颗心无惧无畏"},{"time":203.318,"text":"铁花飞，飘逸不残灰"},{"time":210.934,"text":"千年之后还剩下什么？"},{"time":214.034,"text":"灵魂的重量又怎能取舍"},{"time":217.282,"text":"有共存才有未来可说"},{"time":220.568,"text":"从此不再寂寞，因为这间心房已解锁"},{"time":224.201,"text":"正确了又能证明什么？"},{"time":227.482,"text":"就算能从过去找出差错"},{"time":230.768,"text":"身世境遇不由人选择"},{"time":233.869,"text":"有理解就足够"},{"time":235.53,"text":"盼日夜细水长流"}]