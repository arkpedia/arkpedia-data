[{"time":27.75,"text":"Waiting by the window to revel in the last light of day"},{"time":37.69,"text":"Hoping that these empty halls are here to guide my way"},{"time":44.04,"text":"Trying to find"},{"time":47.77,"text":"To find the cure, I toil"},{"time":52.07,"text":"long after the setting sun"},{"time":57.77,"text":"Endeavoring to show them all"},{"time":62.07,"text":"To heal the damage done"},{"time":68.73,"text":"All that I strive for"},{"time":73.86,"text":"The oath I swore"},{"time":79.1,"text":"And yet this malady wears on"},{"time":83.82,"text":"Forever they fall"},{"time":88.82,"text":"And as the day wains"},{"time":93.78,"text":"I feel your pain"},{"time":98.82,"text":"But there’s more yet to ascertain"},{"time":108,"text":"Dedicated to this research, trials that keep me hidden away"},{"time":118.24,"text":"Medicinally minded, I’ll keep your aches at bay"},{"time":125.13,"text":"Silent, I’ll mend"},{"time":129.84,"text":"Soothe your hurt"},{"time":132.69,"text":"In an ascetic sacrifice"},{"time":137.35,"text":"I try"},{"time":139.81,"text":"To keep you alive"},{"time":146.92,"text":"All that I strive for"},{"time":151.96,"text":"The oath I swore"},{"time":156.98,"text":"And yet this malady plagues on"},{"time":162.53,"text":"Forever we fall"},{"time":167.15,"text":"And as the day wains"},{"time":172.1,"text":"I feel your pain"},{"time":177.06,"text":"I pray my efforts aren’t in vain"},{"time":180.48,"text":"Should ever you fall"}]