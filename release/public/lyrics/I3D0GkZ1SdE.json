[{"time":41.066,"text":"Long may we fall"},{"time":47.438,"text":"In the light of it all"},{"time":55.646,"text":"This trembling hope"},{"time":62.144,"text":"To become something more"},{"time":73.062,"text":"As I gaze"},{"time":76.492,"text":"To the sky"},{"time":81.334,"text":"Stars fall like tears of heaven from my eyes"},{"time":87.445,"text":"In my heart"},{"time":91.231,"text":"I feel my home"},{"time":95.725,"text":"That place I've seen in dreams, but never been before"},{"time":108.39,"text":"Long may we fall"},{"time":114.262,"text":"In the light of it all"},{"time":122.093,"text":"This trembling hope"},{"time":128.382,"text":"To become something more"},{"time":136.021,"text":"Eternal in a soft bloom"},{"time":139.59,"text":"These petals float"},{"time":143.339,"text":"Atop an ocean of love"},{"time":150.621,"text":"Swimming through a holy soil"},{"time":154.514,"text":"Our hearts will ache this song"},{"time":161.614,"text":"Into the beyond"},{"time":169.011,"text":"As I gaze"},{"time":172.252,"text":"To the sky"},{"time":177.301,"text":"Stars fall like tears of heaven from my eyes"},{"time":183.477,"text":"In my heart"},{"time":187.334,"text":"I feel my home"},{"time":191.725,"text":"That place I've seen in dreams, but never been before"},{"time":202.15,"text":"As I blaze"},{"time":205.619,"text":"Through the light"},{"time":210.581,"text":"Stars erupt and planets blossom from the night"},{"time":217.164,"text":"My heart"},{"time":220.724,"text":"Screams for home"},{"time":225.136,"text":"Though I might never make it"},{"time":228.35,"text":"I will brave that void"},{"time":271.054,"text":"Sometimes I wonder if you dreamed me into existence."},{"time":276.62,"text":"On your knees, crying like the cello cries;"},{"time":281.614,"text":"In tongues of men, in tongues of angels,"},{"time":285.829,"text":"Sinking through the fathomless,"},{"time":288.9,"text":"Singing the name I had before I was born."},{"time":294.519,"text":"The world holds its breath."},{"time":298.131,"text":"Take me with you."},{"time":300.845,"text":"Like fiery contrails in the night sky,"},{"time":305.182,"text":"To the furthest reaches of Elysium we go."}]