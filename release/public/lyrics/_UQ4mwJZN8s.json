[{"time":9.36,"text":"语言"},{"time":10.16,"text":"An artificial medium to deliver thoughts"},{"time":13.38,"text":"思想"},{"time":14.12,"text":"An expression of self limited by language"},{"time":17.46,"text":"自我"},{"time":18.24,"text":"An echo chamber for our personal truths"},{"time":21.52,"text":"真实"},{"time":22.32,"text":"An array of rules agreed upon within a confined space"},{"time":25.6,"text":"空间"},{"time":26.4,"text":"An ark for the fittest"},{"time":27.46,"text":"A host for our parasitic lives"},{"time":29.6,"text":"生命"},{"time":30.44,"text":"A collection of experiences"},{"time":31.75,"text":"A longing for cure and extension"},{"time":33.73,"text":"良药"},{"time":34.5,"text":"A pill of empathy"},{"time":35.39,"text":"A bitter proof of our desperation for expansion"},{"time":37.73,"text":"扩张"},{"time":38.43,"text":"Must we burn it all down?"},{"time":39.6,"text":"We must burn it all down"},{"time":41.4,"text":"I'm at your feet"},{"time":45.52,"text":"Look at me please"},{"time":49.6,"text":"Listen to me"},{"time":53.56,"text":"I am speaking"},{"time":56,"text":"留心不踩踏花儿"},{"time":60.24,"text":"我们前行"},{"time":63.04,"text":"燃烧整个世界"},{"time":67.12,"text":"燃烧整个世界"},{"time":71.16,"text":"只求你不凋谢"},{"time":76.76,"text":"Let's put down the weapons and unwind"},{"time":81.8,"text":"就算前途短暂"},{"time":84.88,"text":"因为有你的陪伴"},{"time":87,"text":"我的故事不再凄惨"},{"time":105.94,"text":"Oh"},{"time":107.72,"text":"I know it is not your fault"},{"time":111.8,"text":"It's the environment we grew up in"},{"time":116.92,"text":"Destined to be cruel"},{"time":119.96,"text":"We still have the tiniest power to make it stop"},{"time":128.08,"text":"The cycle of hate dissolves"},{"time":131.64,"text":"Only when someone takes the loss"},{"time":135.02,"text":"花开"},{"time":137.22,"text":"花谢"},{"time":139,"text":"花开"},{"time":141.04,"text":"花谢"},{"time":143.08,"text":"花开"},{"time":145.12,"text":"花谢"},{"time":147.16,"text":"花开"},{"time":149.88,"text":"我还记得遇见你那瞬间"},{"time":156.56,"text":"花色如此纯洁"},