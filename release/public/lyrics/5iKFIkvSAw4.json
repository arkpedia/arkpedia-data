[{"time":10.974,"text":"Guitars, Mandolin, Backing Vocals, Mix: Obadiah Brown-Beach"},{"time":13.794,"text":"Lead Vocals: Serge Liberovsky"},{"time":16.231,"text":"Vocal Recording Engineer: Matthew Carl Earl"},{"time":19.246,"text":"Это было, когда улыбался"},{"time":26.953,"text":"Только мертвый, спокойствию рад."},{"time":38.606,"text":"а то, что случилось,"},{"time":44.953,"text":"Пусть черные сукна покроют,"},{"time":54.19,"text":"И пусть унесут фонари…"},{"time":65.891,"text":"Ночь."},{"time":74.037,"text":"Уже безумие крылом"},{"time":78.093,"text":"Души накрыло половину,"},{"time":82.676,"text":"И поит огненным вином"},{"time":87.356,"text":"И манит в черную долину."},{"time":91.905,"text":"И поняла я, что ему"},{"time":96.433,"text":"Должна я уступить победу,"},{"time":101.079,"text":"Прислушиваясь к своему"},{"time":105.87,"text":"Уже как бы чужому бреду."},{"time":121.537,"text":"И только пыльные цветы,"},{"time":128.398,"text":"И звон кадильный, и следы"},{"time":132.725,"text":"Куда-то в никуда."},{"time":139.891,"text":"И прямо мне в глаза глядит"},{"time":146.656,"text":"И скорой гибелью грозит"},{"time":155.823,"text":"Огромная звезда."},{"time":165.615,"text":"Bridge:"},{"time":166.434,"text":"Перед этим горем гнутся горы,"},{"time":189.101,"text":"Не течет великая река."},{"time":207.795,"text":"Уже безумие крылом"},{"time":211.726,"text":"Души накрыло половину,"},{"time":216.476,"text":"И поит огненным вином"},{"time":221.094,"text":"И манит в черную долину."},{"time":225.858,"text":"И поняла я, что ему"},{"time":230.282,"text":"Должна я уступить победу,"},{"time":234.872,"text":"Прислушиваясь к своему"},{"time":239.663,"text":"Уже как бы чужому бреду."}]