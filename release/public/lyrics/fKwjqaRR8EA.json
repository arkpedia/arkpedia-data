[{"time":8.32,"text":"作曲/作词：Adam Gubman"},{"time":13.32,"text":"Home, left her homeland miles behind,"},{"time":13.32,"text":"她的故乡在身后"},{"time":19.27,"text":"The hunter she walks, on the seacoast way"},{"time":19.27,"text":"猎人啊，走上海岸"},{"time":23.53,"text":"with her path before her"},{"time":23.53,"text":"她的道路在身前"},{"time":27.37,"text":"Crash, and the driftwood floats, evermore"},{"time":27.37,"text":"覆潮之下的浮木，无所依归"},{"time":32.99,"text":"It's the salt on my skin"},{"time":32.99,"text":"皮囊之上的盐晶，析出印记"},{"time":36.1,"text":"Leaving their mark, where the walls once towered."},{"time":36.1,"text":"高塔矗立"},{"time":41.34,"text":"Oh, it's more than a dream"},{"time":41.34,"text":"胜似梦境"},{"time":45.14,"text":"It's a play, the tides attending"},{"time":45.14,"text":"那是一场戏剧，是潮汐的把戏"},{"time":48.22,"text":"Oh, our world comes apart at the seams"},{"time":48.22,"text":"噢，世界也破碎支离"},{"time":54.78,"text":"From the chaos"},{"time":54.78,"text":"混乱失序"},{"time":56.91,"text":"Scared and afraid"},{"time":56.91,"text":"心生畏惧"},{"time":58.36,"text":"I will wander"},{"time":58.36,"text":"我感到踟蹰难安"},{"time":60.44,"text":"I will remain"},{"time":60.44,"text":"我决定寸步不移"},{"time":62.18,"text":"Strong, but it sets with the sun"},{"time":62.18,"text":"往日辉煌，随斜阳落尽"},{"time":66.7,"text":"Hopeless, I’m chasing the dawn"},{"time":66.7,"text":"绝望之中，也追逐黎明"},{"time":70.58,"text":"And I wander, wander on."},{"time":70.58,"text":"我踟蹰着，游荡，仿徨"},{"time":75.58,"text":"From the chaos"},{"time":75.58,"text":"混乱失序"},{"time":77.72,"text":"Scared and afraid"},{"time":77.72,"text":"心生畏惧"},{"time":79.22,"text":"I will wander"},{"time":79.22,"text":"我感到踟蹰难安"},{"time":81.34,"text":"I will remain"},{"time":81.34,"text":"我决定寸步不移"},{"time":83.2,"text":"Strong, but it sets with the sun"},{"time":83.2,"text":"往日辉煌，随斜阳落尽"},{"time":87.73,"text":"Hopeless, I’m chasing the dawn"},{"time":87.73,"text":"绝望之中，也追逐黎明"},{"time":91.69,"text":"And I wander, wander on."},{"time":91.69,"text":"我踟蹰着，游荡，仿徨"}]