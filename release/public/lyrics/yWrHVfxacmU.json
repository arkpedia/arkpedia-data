[{"time":54.954,"text":"浮云栖山意更深，"},{"time":62.413,"text":"漫步遥见有鹤引。"},{"time":69.934,"text":"似仙人，点丹青，"},{"time":77.005,"text":"分明远黛两弯怎失声音。"},{"time":153.384,"text":"见更深那，"},{"time":156.015,"text":"是谁懒倚又散鬓，"},{"time":160.975,"text":"拂衣对坐无意一树雨，"},{"time":168.664,"text":"漫聊来兴是知音难觅，"},{"time":176.078,"text":"哪（还）记再问是梦或醒也？"}]