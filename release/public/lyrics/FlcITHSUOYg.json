[{"time":2.13,"text":"Wolken spiegeln sich im Wasser. Monde sind hinter Wolken versteckt."},{"time":11.24,"text":"Das Federbiest fragen mich, wo bist du?"},{"time":15.68,"text":"Die Blumen blühen im Sturm und auf den Blumen bereift."},{"time":21.91,"text":"Ich habe nur dieses Leben und Schweigen und das Licht."},{"time":29.94,"text":"Say what you want,"},{"time":31.33,"text":"Say what you need,"},{"time":32.75,"text":"Mean what you say"},{"time":37.08,"text":"And I still give my best to you."},{"time":44.22,"text":"Say what you want,"},{"time":45.55,"text":"Say what you need,"},{"time":46.94,"text":"Mean what you say"},{"time":51.39,"text":"Take your shot and I’m unfazed"},{"time":60.18,"text":"Lift this veil"},{"time":62.88,"text":"Grace preserved,"},{"time":64.84,"text":"Nothing frail"},{"time":66.89,"text":"Don’t lie to me"},{"time":70.53,"text":"Be nice to me"},{"time":74.4,"text":"Float, relaxed,"},{"time":77.13,"text":"Sip my wine, spill the wax"},{"time":81.18,"text":"You fear the flame,"},{"time":84.79,"text":"We’re not the same."},{"time":86.88,"text":"There is a labyrinth inside,"},{"time":90.1,"text":"Introvert but never hide"},{"time":91.9,"text":"You won’t have to navigate"},{"time":93.76,"text":"I will show you if you wait"},{"time":96.43,"text":"It’s a gift that you’ll receive"},{"time":98.93,"text":"When you’d rather choose humble, soft and sweet"},{"time":102.48,"text":"Sit next to me, you can feel me breathe…"},{"time":110.12,"text":"Say what you want,"},{"time":111.36,"text":"Say what you need,"},{"time":112.74,"text":"Mean what you say,"},{"time":116.81,"text":"And I still give my best to you."},{"time":124.34,"text":"Say what you want,"},{"time":125.55,"text":"Say what you need,"},{"time":126.84,"text":"Mean what you say"},{"time":131.29,"text":"Take your shot and I’m unfazed"},{"time":140.17,"text":"Words are rain,"},{"time":143.01,"text":"Some are warm, some are pain,"},{"time":146.76,"text":"They wash away your fantasy"},{"time":154.04,"text":"Yet you pretend"},{"time":157.13,"text":"There are means to every end,"},{"time":161.22,"text":"My dignity, just let it be."},{"time":168.75,"text":"Say what you want,"},{"time":170.05,"text":"Say what you need,"},{"time":171.31,"text":"Mean what you say,"},{"time":175.8,"text":"And I still give my best to you."},{"time":182.89,"text":"Say what you want,"},{"time":184.24,"text":"Say what you need,"},{"time":185.53,"text":"Mean what you say"},{"time":190.06,"text":"Take your shot and I’m unfazed"},{"time":198.77,"text":"Die Blumen blühen im Sturm und auf den Blumen bereift."},{"time":205.26,"text":"Ich habe nur dieses Leben und Schweigen und das Licht."}]