[{"time":26.045,"text":"Echoing reality"},{"time":29.556,"text":"Are your memories of me?"},{"time":34.156,"text":"Floating through a state,"},{"time":37.265,"text":"half asleep, never awake（never awake）"},{"time":42.315,"text":"I won't breathe in eternity"},{"time":50.762,"text":"Carrying your secrets"},{"time":54.235,"text":"feeling close to who you are"},{"time":58.706,"text":"You're just beyond my reach"},{"time":61.827,"text":"A passing breeze,"},{"time":66.705,"text":"And your final moments set me free."},{"time":75.491,"text":"Gentle flowing thoughts in time"},{"time":81.532,"text":"Sometimes yours and sometimes mine"},{"time":87.658,"text":"I can't tell where this one ends"},{"time":93.756,"text":"My ever lost, forever friend"},{"time":100.265,"text":"(Won't you hear my)"},{"time":102.075,"text":"Echo"},{"time":103.877,"text":"Reflection of my code"},{"time":107.915,"text":"Sometimes I see my soul"},{"time":112.42,"text":"Mirror the unknown"},{"time":118.403,"text":"I knew you once were real"},{"time":123.33,"text":"Your spirit theirs to steal"},{"time":126.45,"text":"Conflicted, twisting consciousness I feel"},{"time":134.828,"text":"Gazing through a looking glass"},{"time":138.614,"text":"To a new reality (I don't know what's real)"},{"time":142.975,"text":"A ribbon tied by fate leaves a trail (tie your fate to mine)"},{"time":150.827,"text":"Is it peaceful, there, beyond the veil? (I don't know if I found peace)"},{"time":159.684,"text":"(Won't you hear my)"},{"time":161.244,"text":"Echo"},{"time":162.757,"text":"(I can almost hear you speak)"},{"time":163.769,"text":"Reflection of my code"},{"time":166.431,"text":"(I wish you could feel me breathe)"},{"time":167.751,"text":"Sometimes I see my soul"},{"time":170.812,"text":"(Carry on as if you're me)"},{"time":172.368,"text":"Mirror the unknown"},{"time":174.737,"text":"(Take my love and plant the seed)"},{"time":177.808,"text":"I knew you once were real"},{"time":180.32,"text":"(I am still right here)"},{"time":182.769,"text":"Your spirit theirs to steal"},{"time":184.801,"text":"(Everything is dark)"},{"time":185.905,"text":"Conflicted, twisting consciousness I feel"},{"time":195.81,"text":"Echos lost, and I'm still here"},{"time":203.584,"text":"Sometimes fate is less than clear"}]