[{"time":29.99,"text":"With the will of iron cast in flames"},{"time":37.46,"text":"Let’s bring glory to our names"},{"time":44.49,"text":"Follow me, brave champions of Victoria, once again"},{"time":52.18,"text":"All together we march on"},{"time":55.81,"text":"Strike, fight, charge ahead"},{"time":59.07,"text":"Show no fear or dread"},{"time":62.2,"text":"For Victoria"},{"time":65.42,"text":"We will march on"},{"time":68.82,"text":"Unafraid, unbroken, we will fight"},{"time":76.2,"text":"Let your countless voices fill the night"},{"time":83.11,"text":"Follow me and prove all evil crumbles before our might"},{"time":90.85,"text":"As together we march on to our song"},{"time":98.03,"text":"I was captive, lost, alone"},{"time":101.64,"text":"But my army’s only grown"},{"time":105.25,"text":"For our love, our light, our home"},{"time":107.95,"text":"We cry: “March on!”"},{"time":112.98,"text":"Strike, fight, charge ahead"},{"time":116.11,"text":"Show no fear or dread"},{"time":119.28,"text":"For Victoria We will march"},{"time":155.27,"text":"Even as they chained me down"},{"time":158.72,"text":"It was then my strength was found"},{"time":162.39,"text":"And with soldiers, comrades, friends"},{"time":165.03,"text":"I’m calling: “March on!”"},{"time":169.97,"text":"Strike, fight, charge ahead"},{"time":173.19,"text":"Show no fear or dread"},{"time":176.36,"text":"For Victoria"},{"time":179.6,"text":"We will march on"},{"time":183.15,"text":"Strike, fight, charge ahead (Raise your voices to the sky!)"},{"time":186.61,"text":"Show no fear or dread (Roar our battle cry!)"},{"time":189.65,"text":"For Victoria (Our triumph is nigh!)"},{"time":192.82,"text":"We march on (March on!) March on!"}]