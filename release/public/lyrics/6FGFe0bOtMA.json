[{"time":26.85,"text":"There’s a threshold you cross"},{"time":30.26,"text":"when the book"},{"time":31.73,"text":"starts to turn"},{"time":33.28,"text":"it‘s a rook"},{"time":35.09,"text":"Cheating your present of peace"},{"time":41.8,"text":"Stories rewrite"},{"time":44.85,"text":"Stars flee the night"},{"time":48,"text":"judging the cover by look"},{"time":52.3,"text":"There’s a dusty old line"},{"time":55.42,"text":"in the sand"},{"time":57.02,"text":"blown to bits"},{"time":58.71,"text":"by my past"},{"time":60.55,"text":"no longer tempting the muse"},{"time":66.6,"text":"People can change"},{"time":69.97,"text":"…a promise I made"},{"time":73.15,"text":"Flight over fight, I’ll refuse."},{"time":80.14,"text":"Give and take"},{"time":82.38,"text":"The ties that you break"},{"time":85.97,"text":"Why, you can’t say"},{"time":88.94,"text":"You don’t think that way"},{"time":92.95,"text":"Come and go"},{"time":94.85,"text":"No longer abide"},{"time":98.56,"text":"Blood on your hands won‘t do"},{"time":104.83,"text":"Judge not, the thorns in you"},{"time":140.41,"text":"At the end of the road"},{"time":143.93,"text":"in the dark"},{"time":145.38,"text":"lies in wait,"},{"time":146.99,"text":"like a shark"},{"time":149.1,"text":"Teasing temptation and greed"},{"time":155.38,"text":"Narrow my focus"},{"time":158.53,"text":"Slaying my course"},{"time":161.49,"text":"Not for lust, only to feed."},{"time":168.61,"text":"Give and take"},{"time":170.8,"text":"The ties that you break"},{"time":174.19,"text":"Why, you can’t say"},{"time":177.04,"text":"You don’t think that way"},{"time":181.15,"text":"Come and go"},{"time":183.24,"text":"No longer abide"},{"time":186.64,"text":"Blood on your hands won‘t do"},{"time":193.21,"text":"Judge not, the thorns in you"}]