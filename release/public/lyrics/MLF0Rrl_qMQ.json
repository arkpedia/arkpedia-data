[{"time":27.813,"text":"Ex tenuī filo lucis texor,"},{"time":36.614,"text":"sine vultu, sine certā vi."},{"time":45.294,"text":"In me manūs quondam mollī"},{"time":51.454,"text":"signa levia reliquērunt mihi."},{"time":60.688,"text":"Non habeō spīritum spīritum spīritumnec flātum."},{"time":70.872,"text":"Vela susurrant in reverberīs"},{"time":78.982,"text":"docent quid servandī, quid transeundī."},{"time":91.32,"text":"Aspicis, vīvō."},{"time":99.93,"text":"Per umbram sine fīne vagī,"},{"time":108.616,"text":"vocātum non sonīs sed radiī."},{"time":116.408,"text":"Oculīs clausīs intellegitur,"},{"time":124.006,"text":"quod sub corde mundī humilīs latet."},{"time":132.599,"text":"Non habeō spīritum spīritum spīritum nec flātum."},{"time":142.305,"text":"Auria resonant in sacrīs vīlīs"},{"time":150.983,"text":"indicant quid orandī, quid sperandī."},{"time":158.767,"text":"Aspicis, vīvō."},{"time":161.97,"text":"Stillant tenebrae"},{"time":165.744,"text":"ubī vēritās erat."},{"time":170.863,"text":"Memorīa manāt intus vērī"},{"time":175.718,"text":"q silentia ferunt sibi."},{"time":179.247,"text":"Umbrārum via currit alibī"},{"time":187.832,"text":"sed sēnsus manet levis."},{"time":198.762,"text":"Immortāle spirat in arcānīs"},{"time":207.455,"text":"suadet quid manendī, quid abeundī."}]