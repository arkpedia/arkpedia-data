[{"time":0.58,"text":"И нет ничего кроме неба"},{"time":8.42,"text":"Высокого, тихого, белого."},{"time":17.05,"text":"Ползут облака бесконечно,"},{"time":26.06,"text":"Мысли становятся беспечны."},{"time":34.18,"text":"Не видели раньше мы неба"},{"time":42.11,"text":"Не знали мы, где искать счастья"},{"time":50.78,"text":"А ветер тот дул так свирепо"},{"time":59.67,"text":"И нужно идти было дальше."},{"time":67.77,"text":"Ах, как же тогда заблуждались,"},{"time":75.96,"text":"Когда на дороге прощались."},{"time":84.46,"text":"Не ждали мы скорых потерь."},{"time":92.72,"text":"Бежит по земле крылатый зверь."},{"time":118.06,"text":"И нет ничего, кроме неба"},{"time":126.21,"text":"Высокого, тихого, белого."},{"time":135.53,"text":"Сердце пронзает тревога Моего не останется дома."},{"time":152.3,"text":"Сердце пронзает тревога Моего не останется дома."}]