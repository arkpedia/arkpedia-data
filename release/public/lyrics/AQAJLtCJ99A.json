[{"time":8.406,"text":"星光布满了云河"},{"time":12.035,"text":"这车满街巷怎么都不见少"},{"time":16.194,"text":"黐金箔横幅门楣上"},{"time":20.027,"text":"红纸 霓灯 鲤影"},{"time":21.506,"text":"是年味坐标"},{"time":24.242,"text":"此 刻不计较错对"},{"time":28.138,"text":"凝视花瓣的线索"},{"time":30.027,"text":"停下思考这一秒"},{"time":32.028,"text":"任市潮伴着我们庆祝"},{"time":36.21,"text":"所有心境都记住"},{"time":40.099,"text":"遗憾或憧憬 留俾下一篇"},{"time":44.347,"text":"街灯一落几多欢乐"},{"time":46.371,"text":"只此一晚别追究"},{"time":48.57,"text":"及时融入这欢笑声"},{"time":52.802,"text":"“你摞埋滴年桔啦 大吉大利啊”"},{"time":55.099,"text":"“哎 咁摞埋滴桃花啦”"},{"time":56.987,"text":"“哇 醒目喔”"},{"time":60.298,"text":"摊位顺应了人潮"},{"time":64.043,"text":"这花市喧闹怎么都不会少"},{"time":68.146,"text":"新鲜食物的热暖"},{"time":71.506,"text":"将疲倦收起"},{"time":73.243,"text":"热闹是年味坐标"},{"time":76.323,"text":"可 否多逛一两转"},{"time":79.956,"text":"案件始终都要结"},{"time":81.907,"text":"别要纠结这一秒"},{"time":84.139,"text":"迎好运充实年末几天"},{"time":88.243,"text":"所有心愿都要说"},{"time":91.891,"text":"仍要回望日子 踏进下一篇"},{"time":96.218,"text":"烟花起落多少声响"},{"time":98.514,"text":"只此一刻别追究"},{"time":100.499,"text":"及时留住每种笑声"},{"time":104.122,"text":"挥春之际举家欢聚"},{"time":108.371,"text":"沿途无论有多少高低起跌"},{"time":112.716,"text":"当街巷满出喜悦"},{"time":116.473,"text":"声声贺喜中遗忘所有烦扰"},{"time":120.499,"text":"即管抱拥"},{"time":123.987,"text":"趁炮仗响遍天"},{"time":128.179,"text":"这一刻"},{"time":131.585,"text":"不必再思考"},{"time":133.403,"text":"哪管明日怎么去闯"},{"time":136.332,"text":"所有美好的字句"},{"time":140.043,"text":"红纸迎着晚灯 让世界换色"},{"time":144.61,"text":"怎么闯荡冲劲不改"},{"time":146.435,"text":"多得各位好知己"},{"time":148.451,"text":"团团圆年运送给你 家福万康"},{"time":152.371,"text":"花街之内逛出感慨"},{"time":156.467,"text":"来年仍然有不少可盼可待"},{"time":160.657,"text":"当街巷满出喜悦"},{"time":164.435,"text":"年年月月这感觉可一可再"}]