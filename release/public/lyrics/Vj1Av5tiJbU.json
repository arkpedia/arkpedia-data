[{"time":24.632,"text":"Simple, solemn tone"},{"time":28.604,"text":"in my words and shattered bone"},{"time":33.218,"text":"Am I talking to myself,"},{"time":37.492,"text":"Who's in control"},{"time":43.932,"text":"Guarding those long gone"},{"time":47.866,"text":"With a haunting, simple song"},{"time":53.558,"text":"Rising waves of bodies save"},{"time":57.867,"text":"the world from all you've wronged,"},{"time":62.698,"text":"I can feel the fog."},{"time":75.341,"text":"Leave behind your dead (Intoxicating)"},{"time":79.318,"text":"I will make them mine (Intoxicating)"},{"time":84.171,"text":"They animate (Intoxicating)"},{"time":88.219,"text":"You rot in time (Intoxicating)"},{"time":91.65,"text":"Plans set in motion,"},{"time":93.373,"text":"Scent of devotion."},{"time":95.445,"text":"Oh, the dark rise"},{"time":97.484,"text":"Oh, in your eyes."},{"time":99.555,"text":"Intoxicating"},{"time":101.299,"text":"Intoxicating"},{"time":113.293,"text":"Take responsibility"},{"time":117.957,"text":"Souls, adrift, that long to be"},{"time":122.891,"text":"penned, I write their destiny"},{"time":126.942,"text":"like my mother, before me."},{"time":132.556,"text":"Hear the whistle sound,"},{"time":136.885,"text":"calling those below the ground."},{"time":142.029,"text":"Defending with my life, the once devine,"},{"time":147.723,"text":"Now lost in sands of time."},{"time":154.174,"text":"Leave behind your dead (Intoxicating)"},{"time":158.123,"text":"I will make them mine (Intoxicating)"},{"time":162.927,"text":"They animate (Intoxicating)"},{"time":167.011,"text":"You rot in time (Intoxicating)"},{"time":170.603,"text":"Plans set in motion,"},{"time":172.236,"text":"Scent of devotion."},{"time":174.301,"text":"Oh, the dark rise"},{"time":176.316,"text":"Oh, in your eyes."},{"time":178.477,"text":"Intoxicating"},{"time":180.307,"text":"Intoxicating"},{"time":182.413,"text":"Leave behind your dead"},{"time":185.395,"text":"I will make them mine"},{"time":188.295,"text":"While others rot in time"},{"time":191.315,"text":"My lamentation is your sign."}]