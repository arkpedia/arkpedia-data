[{"time":30.69,"text":"作词：Laura Intravia"},{"time":32.69,"text":"作曲：Sterling Maffe"},{"time":37.69,"text":"The voices inside me"},{"time":37.69,"text":"心中之音"},{"time":42.74,"text":"Echo from the past"},{"time":42.74,"text":"是远古回声"},{"time":44.88,"text":"Murmur in the dark"},{"time":44.88,"text":"是黑暗呢喃"},{"time":46.57,"text":"Their words light to guide me"},{"time":46.57,"text":"为我照亮前路"},{"time":51.39,"text":"“Fight until the last, never lose your heart.”"},{"time":51.39,"text":"“初心勿忘，昂首向前”"},{"time":55.19,"text":"And deep within the whispers, power flows..."},{"time":55.19,"text":"絮语深处，力量涌动"},{"time":63.89,"text":"The twisting, churning feeling something's growing…"},{"time":63.89,"text":"辗转反复，茁壮生长"},{"time":98.09,"text":"And I'm afraid no longer—"},{"time":98.09,"text":"恐惧不再"},{"time":103.92,"text":"Something in me changed"},{"time":103.92,"text":"蜕变将成"},{"time":106.14,"text":"I cannot deny"},{"time":106.14,"text":"我无法推拒"},{"time":107.61,"text":"Let the fire grow stronger"},{"time":107.61,"text":"火愈炙烈"},{"time":112.6,"text":"Burn the clouds away"},{"time":112.6,"text":"震彻云霄"},{"time":114.02,"text":"And touch the sky"},{"time":114.02,"text":"直冲天空"},{"time":142.42,"text":"My purpose is clear now"},{"time":142.42,"text":"我意已决"},{"time":147.54,"text":"I will find the path"},{"time":147.54,"text":"敢问命运"},{"time":149.39,"text":"To my destiny"},{"time":149.39,"text":"前路何在"},{"time":151.31,"text":"Cast off all your fears now"},{"time":151.31,"text":"驱散恐惧"},{"time":156.21,"text":"I will lead the way"},{"time":156.21,"text":"愿你我携手"},{"time":157.78,"text":"So follow me"},{"time":157.78,"text":"开辟征途"},{"time":161.8,"text":"And we'll burn the clouds away"},{"time":161.8,"text":"我们的烈焰将震彻云霄"},{"time":170.73,"text":"And we'll burn the clouds away"},{"time":170.73,"text":"我们的烈焰将震彻云霄"},{"time":179.45,"text":"Keep our demons all at bay"},{"time":179.45,"text":"阻拦一切黑暗"},{"time":188.2,"text":"There will be an end someday"},{"time":188.2,"text":"明日终将至"},{"time":196.83,"text":"And I must lead the way"},{"time":196.83,"text":"我必昂首向前"},{"time":209.35,"text":"Keep burning the clouds away, away"},{"time":209.35,"text":"烈焰将震彻云霄"},{"time":221.09,"text":"And touch the sky, touch the sky"},{"time":221.09,"text":"直冲天空"}]