[{"time":12.035,"text":"PANGE, LINGUA, REDEMPTIO"},{"time":16.389,"text":"Saint Thomas Aquinas/Adam Gubman"},{"time":27.873,"text":"Oh Pange, oh pange lingua redemptio"},{"time":39.605,"text":"De meam carnem, carnem mysterium"},{"time":50.177,"text":"Sanguinisque pretiosi mei (Ahh)"},{"time":66.941,"text":"Praesertim, Quae, quae mi-hi imortale"},{"time":76.775,"text":"Oh fructus, oh fructus ventris generosi"},{"time":89.071,"text":"Rex effúdit géntium."},{"time":102.055,"text":"Pange, lingua, redemptio!"},{"time":123.859,"text":"Tantum ergo sacraméntum"},{"time":135.09,"text":"Venerémur cérnui:"},{"time":146.235,"text":"Et antíquum documéntum"},{"time":159.683,"text":"Novo cedat rítui:"},{"time":170.232,"text":"Ad firmándum cor sincérum"},{"time":181.617,"text":"Sola fides súfficit."},{"time":194.77,"text":"Pange, lingua, redemptio!"}]