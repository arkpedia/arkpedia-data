      "id": "enemy_8001_flmlod",
      "name": "Sverdsmeltr, Guardian Ember of the King",
      "index": "SFR01",
      "rank": "Boss",
      "sort": 1523,
      "hidden": true,
      "icon": "/enemies-icons/Sverdsmeltr, Guardian Ember of the King.webp",
      "flavour_text": "From the youngest general of the Punishment Clan, to the final Diαblo. Facing the siege, he guarded the king's remains for three days and nights. Finally, in the final flame's light, he saw his promised homeland.",
      "race": "Sarkaz",
      "movement": "Ground",
      "attack_position": "Melee",
      "damage_type": [
        "Physical",
        "Arts"
      ],
      "abilities": [
        {
          "text": "First Form",
          "format": "title"
        },
        {
          "text": "[Suppression] Uses Haunting Flames to incapacitate one Operator on the field, causing them to be unable to act and take continuous Arts damage. If an Operator is defeated or retreats while affected by Haunting Flames, that Operator will be sealed, and cannot be redeployed until the Haunting Flames are destroyed.",
          "format": "normal"
        },
        {
          "text": "[Payback] When HP drops to 0, all surrounding Operators will immediately be engulfed by Haunting Flames. Periodically releases <Condensed Heat> towards a friendly unit (if no eligible targets, this will be released towards the Objective Points instead).",
          "format": "normal"
        },
        {
          "text": "[Condensed Heat] These flying flames released by Sverdsmeltr have low DEF and inflict continuous Arts and Burn to surrounding Operators. When they reach their target or the target leaves the field, they will self-destruct and deal Arts damage in a large area. Drains a Life Point upon reaching the Objective Point.",
          "format": "normal"
        }
      ],
