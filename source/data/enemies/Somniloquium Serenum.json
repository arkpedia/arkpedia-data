        {
          "text": "[Binding Dream] Causes your defeated units to be unable to retreat for a while",
          "format": "normal"
        },
        {
          "text": "[Dissociative Sensation] Other enemies share more damage for Morpheus",
          "format": "normal"
        },
        {
